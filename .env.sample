# Leave these blank for local development - config/storage.yml falls back to
# safe defaults (a "missing" bucket and a https://fix.me endpoint) when unset.
# Only fill these in if you have real S3-compatible storage credentials.
QUL_STORAGE_ACCESS_KEY=
QUL_STORAGE_ACCESS_KEY_SECRET=
QUL_STORAGE_BUCKET=
QUL_STORAGE_PUBLIC_EXPORT=true
QUL_STORAGE_ENDPOINT=
QUL_STORAGE_REGION=

# Database connections (see config/database.yml). Required in production.
# In development, leave these commented out to use the local defaults
# (qul_quran_content_dev / qul_cms_content_dev on localhost:5432,
# user postgres, password password). Uncomment only the ones you need -
# an empty value is used as-is and will not fall back to the default.
# QUL_QURAN_CONTENT_DB_NAME=
# QUL_QURAN_CONTENT_DB_HOST=
# QUL_QURAN_CONTENT_DB_PORT=
# QUL_QURAN_CONTENT_DB_USERNAME=
# QUL_QURAN_CONTENT_DB_PASSWORD=
# QUL_QURAN_CONTENT_DB_SSLMODE=

# QUL_CMS_CONTENT_DB_NAME=
# QUL_CMS_CONTENT_DB_HOST=
# QUL_CMS_CONTENT_DB_PORT=
# QUL_CMS_CONTENT_DB_USERNAME=
# QUL_CMS_CONTENT_DB_PASSWORD=
# QUL_CMS_CONTENT_DB_SSLMODE=

# Test databases (optional). Defaults: qul_cms_content_test and
# qul_quran_content_test on localhost:5432, user postgres, password password.
# QUL_QURAN_CONTENT_TEST_DB_NAME=
# QUL_QURAN_CONTENT_TEST_DB_HOST=
# QUL_QURAN_CONTENT_TEST_DB_PORT=
# QUL_QURAN_CONTENT_TEST_DB_USERNAME=
# QUL_QURAN_CONTENT_TEST_DB_PASSWORD=
# QUL_QURAN_CONTENT_TEST_DB_SSLMODE=

# QUL_CMS_CONTENT_TEST_DB_NAME=
# QUL_CMS_CONTENT_TEST_DB_HOST=
# QUL_CMS_CONTENT_TEST_DB_PORT=
# QUL_CMS_CONTENT_TEST_DB_USERNAME=
# QUL_CMS_CONTENT_TEST_DB_PASSWORD=
# QUL_CMS_CONTENT_TEST_DB_SSLMODE=
