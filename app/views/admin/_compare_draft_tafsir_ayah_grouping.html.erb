<%
  status_for = lambda do |groups|
    if groups[:current].nil? then 'missing_current'
    elsif groups[:draft].nil? then 'missing_draft'
    elsif groups[:current] != groups[:draft] then 'changed'
    else 'same'
    end
  end

  status_labels = {
    'changed' => 'Range changed',
    'missing_draft' => 'Only in current',
    'missing_current' => 'Only in draft',
    'same' => 'Same'
  }

  counted = @comparison.reject { |_key, groups| groups[:current].nil? && groups[:draft].nil? }
  counts = counted.values.group_by { |groups| status_for.call(groups) }.transform_values(&:size)
  total_count = counted.size
  diff_count = total_count - counts.fetch('same', 0)
  surahs = counted.keys.map { |verse_key| verse_key.split(':').first }.uniq.sort_by(&:to_i)
%>

<div id="title">
  <%= @resource.name %>(<%= @resource.id %>) Tafsir Grouping Comparison
</div>

<div id="body">
  <div class="p-6">
    <div class="mt-4" data-controller="filter-ayah tafsir-text-popup"
         data-tafsir-text-popup-url-value="<%= draft_tafsir_ayah_text_cms_resource_content_path(@resource) %>">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <div class="flex flex-wrap gap-1" role="group">
          <% [['diff', "Differences (#{diff_count})"],
              ['changed', "#{status_labels['changed']} (#{counts.fetch('changed', 0)})"],
              ['missing_draft', "#{status_labels['missing_draft']} (#{counts.fetch('missing_draft', 0)})"],
              ['missing_current', "#{status_labels['missing_current']} (#{counts.fetch('missing_current', 0)})"],
              ['all', "All (#{total_count})"]].each do |value, label| %>
            <button type="button"
                    class="btn btn-sm <%= value == 'diff' ? 'btn-primary' : 'btn-outline-info' %>"
                    data-filter-ayah-target="statusButton"
                    data-status="<%= value %>"
                    data-action="click->filter-ayah#setStatus"><%= label %></button>
          <% end %>
        </div>

        <select id="surah-filter"
                class="px-2 py-1 border border-gray-300 rounded-md"
                data-filter-ayah-target="surah"
                data-action="change->filter-ayah#applyFilters">
          <option value="">All surahs</option>
          <% surahs.each do |surah| %>
            <option value="<%= surah %>">Surah <%= surah %></option>
          <% end %>
        </select>

        <input type="search" id="search-input"
               data-filter-ayah-target="search"
               data-action="input->filter-ayah#applyFilters"
               class="flex-1 min-w-[160px] px-3 py-1 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
               placeholder="Search Ayah (Verse Key)">

        <span class="text-sm text-gray-600">
          <span data-filter-ayah-target="visibleCount"><%= diff_count %></span>/<%= total_count %>
        </span>
      </div>

      <style>
        #grouping-compare thead th {
          position: sticky;
          top: 0;
          z-index: 2;
          background-color: #374151;
          color: #fff;
          text-align: left;
          padding: 0.375rem 0.5rem;
        }
        #grouping-compare thead th.col-current { background-color: #3b82f6; }
        #grouping-compare thead th.col-draft { background-color: #22c55e; }
        #ayahs td:nth-child(n+3):nth-child(-n+5) { background-color: #3b82f6; color: #fff; }
        #ayahs td:nth-child(n+6) { background-color: #22c55e; color: #fff; }
        #ayahs td.err { background-color: #dc3545; color: #fff; }
        #ayahs .status_tag { border: 0; cursor: pointer; }
      </style>

      <table id="grouping-compare" class="w-full hover:bg-gray-50">
        <thead>
        <tr>
          <th data-action="click->filter-ayah#sortColumn">Verse Key</th>
          <th title="Click a status to see the current and draft text">Status</th>
          <th class="col-current">Tafsir Group From</th>
          <th class="col-current">Tafsir Group To</th>
          <th class="col-current">Tafsir Group Count</th>
          <th class="col-draft">Draft Group From</th>
          <th class="col-draft">Draft Group To</th>
          <th class="col-draft">Draft Group Count</th>
        </tr>
        </thead>

        <tbody id="ayahs" data-action="click->tafsir-text-popup#open">
        <%
          # Emitted on one line per row on purpose: at 6236 rows the pretty
          # printed markup was several megabytes of pure indentation. Column
          # colours come from the nth-child rules above instead of per-cell
          # classes for the same reason.
          previous_group = nil
          link_prefix = "/cms/draft_tafsirs?q%5Bresource_content_id_eq%5D=#{@resource.id}&order=id_desc&q%5Bverse_key_cont%5D="
        %>
        <% @comparison.each do |verse_key, groups| %>
          <%
            current_from, current_to, current_count = groups[:current] || []
            draft_from, draft_to, draft_count = groups[:draft] || []
            next if [current_from, current_to, current_count, draft_from, draft_to, draft_count].all?(&:nil?)

            status = status_for.call(groups)
            mismatch = status != 'same'
            is_first_in_group = previous_group != current_from
            previous_group = current_from

            row_class = is_first_in_group ? 'group-header' : "collapse group-#{current_from.to_s.tr(':', '-')}"
            surah = verse_key.split(':').first
          %>
          <tr class="<%= row_class %>"<% if is_first_in_group %> data-toggle="collapse" data-target=".group-<%= verse_key.tr(':', '-') %>"<% end %> data-status="<%= status %>" data-surah="<%= surah %>"><td<%= ' class="err"'.html_safe if mismatch %>><a href="<%= link_prefix %><%= verse_key %>" target="_blank"><strong><%= verse_key %></strong></a></td><td><button type="button" class="status_tag <%= mismatch ? 'no' : 'yes' %>"><%= status_labels[status] %></button></td><td><%= current_from %></td><td><%= current_to %></td><td><%= current_count %></td><td><%= draft_from %></td><td><%= draft_to %></td><td><%= draft_count %></td></tr>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
