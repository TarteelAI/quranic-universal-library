<%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>

<%= render SplitScreenComponent.new do |split| %>
  <% split.with_left do %>
    <h2 class="bg-gray-200 px-3 py-2 font-semibold">Current text</h2>
    <div class="surah-info-text p-3" dir="<%= dir %>" lang="<%= lang %>">
      <% if resource.current_text.present? %>
        <%= safe_html resource.current_text %>
      <% else %>
        <p class="text-gray-500">New, this surah has no info yet</p>
      <% end %>
    </div>
  <% end %>

  <% split.with_right do %>
    <h2 class="bg-gray-200 px-3 py-2 font-semibold">Suggested text</h2>
    <div class="surah-info-text p-3" dir="<%= dir %>" lang="<%= lang %>">
      <%= safe_html resource.draft_text %>
    </div>
  <% end %>
<% end %>
