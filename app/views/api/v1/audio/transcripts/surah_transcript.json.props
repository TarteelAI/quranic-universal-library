segments   = @presenter.segments
pagination = @presenter.pagination

json.script @presenter.requested_quran_script

json.transcript do
  segments.each do |segment|
    json.set! segment.verse_key, @presenter.text_for(segment)
  end
end

json.pagination do
  json.next_page     pagination.next
  json.previous_page pagination.prev
  json.total_pages   pagination.pages
  json.total_count   pagination.count
end
