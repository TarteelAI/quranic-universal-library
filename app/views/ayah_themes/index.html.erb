<%= render 'tools/header',
           name: 'Ayah themes',
           title: @presenter.page_title,
           key: 'ayah_theme'
%>

<div class="page-wrapper container max-w-7xl mx-auto px-4">
  <div class="page-section filters">
    <%= form_tag themes_path, method: :get do %>
      <div data-controller="chapter-verses-filter" class="flex flex-wrap">
        <%= render 'shared/filters' %>

        <div class="mb-4 me-2">
          <%= text_field_tag :query, params[:query], class: 'form-control w-[85vw] sm:w-[200px] border-gray-400 rounded-[5px] h-[38px]', placeholder: 'Search' %>
          <p class="text-sm text-gray-600 mt-1">Search themes and keywords</p>
        </div>

        <div class="mb-4">
          <%= submit_tag 'Filter', class: 'btn btn-success', data: { disable_with: 'Please wait..' } %>
        </div>
      </div>
    <% end %>
  </div>

  <% themes = @presenter.themes %>
  <%= turbo_frame_tag 'theme-list', data: { turbo_action: 'advance' }, class: 'block page-section mt-4' do %>
    <h2>Ayah themes</h2>
    <div class="tools-table-overflow">
      <table class="w-full hover:bg-gray-50">
        <thead class="sticky top-0 z-10 bg-white border-b-2 border-black">
        <tr>
          <th class="text-left">Ayahs</th>
          <th class="text-left">Theme</th>
          <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        <% themes.each do |theme| %>
          <tr class="hover:bg-gray-200 border-b">
            <td class="py-2 pl-2 whitespace-nowrap align-top">
              <%= theme.range_label %>
              <div class="text-xs text-gray-500"><%= theme.chapter.name_simple %></div>
            </td>
            <td class="py-2">
              <%= theme.theme %>
              <% if theme.keywords.present? %>
                <div class="mt-1 flex flex-wrap gap-1">
                  <% Array(theme.keywords).each do |keyword| %>
                    <span class="px-2 py-0.5 rounded-full bg-gray-100 text-xs text-gray-700"><%= keyword %></span>
                  <% end %>
                </div>
              <% end %>
            </td>
            <td class="py-2">
              <div class="flex gap-1 justify-center">
                <%= link_to 'Suggest a fix', edit_theme_path(theme.id), class: 'btn btn-info', data: { turbo_frame: '_top' } %>
                <%= link_to 'Show', theme_path(theme.id), class: 'btn btn-success', data: { turbo_frame: '_top' } %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if themes.empty? %>
          <tr>
            <td colspan="3" class="py-6 text-center text-gray-600">No themes found.</td>
          </tr>
        <% end %>
        <tr>
          <td colspan="3">
            <%= pagination_section @presenter.pagination %>
          </td>
        </tr>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
