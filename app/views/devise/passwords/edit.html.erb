<%= render 'layouts/grid' do %>
  <div class="mx-auto px-4 pb-10">
    <div class="flex flex-col md:flex-row gap-6 md:gap-8">
      <div class="w-full bg-black rounded-3xl overflow-hidden h-[30vh] md:h-[80vh] flex items-center justify-center">
        <%= render 'landing/shards', lockup: true %>
      </div>
      <div class="w-full">
        <div class="py-3 md:px-4">
          <div class="md:py-3" data-turbo="false">
            <h1 class="text-2xl font-semibold mt-4">
              Change your password
            </h1>
            <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: 'inputs_container', role: 'form', data: { controller: 'remote-form' } }) do |f| %>
              <%= f.hidden_field :reset_password_token %>
              <%= render 'shared/form_errors', object: resource %>
              <div class="relative mt-6">
                <%= f.password_field :password, autofocus: true, required: true, minlength: 6, class: 'block w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent peer', placeholder: ' ' %>
                <%= f.label :password, t('.new_password', default: 'New password'), class: 'absolute text-sm text-gray-500 duration-300 transform -translate-y-4 scale-75 top-2 z-10 origin-[0] bg-white px-2 peer-focus:px-2 peer-focus:text-blue-600 peer-placeholder-shown:scale-100 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:top-1/2 peer-focus:top-2 peer-focus:scale-75 peer-focus:-translate-y-4 start-1 pointer-events-none', required: true %>
                <div class="text-sm text-red-600 mt-1 hidden invalid-feedback">
                  Password does not meet minimum security requirements.
                </div>
              </div>
              <div class="relative mt-6">
                <%= f.password_field :password_confirmation, required: true, minlength: 6, class: 'block w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent peer', placeholder: ' ' %>
                <%= f.label :password_confirmation, t('.confirm_new_password', default: 'Confirm new password'), class: 'absolute text-sm text-gray-500 duration-300 transform -translate-y-4 scale-75 top-2 z-10 origin-[0] bg-white px-2 peer-focus:px-2 peer-focus:text-blue-600 peer-placeholder-shown:scale-100 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:top-1/2 peer-focus:top-2 peer-focus:scale-75 peer-focus:-translate-y-4 start-1 pointer-events-none', required: true %>
                <div class="text-sm text-red-600 mt-1 hidden invalid-feedback">
                  Password does not meet minimum security requirements.
                </div>
              </div>
              <div class="text-center mt-8">
                <%= f.submit 'Change my password', class: 'px-8 py-3 rounded font-medium transition-colors bg-gray-800 hover:bg-gray-900 text-white mt-2' %>
              </div>
            <% end %>
          </div>
          <div class="mb-4 text-center">
            <%= render 'devise/shared/links' %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
