<style>
    #content{
        border: 1px solid;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
</style>

<%
  page_num = (local_assigns[:page_number] || @page_number || params[:page_number] || 1).to_i
%>

<div id="content"
     class="<%= params[:css_class] %>"
     data-file-name="mushaf/<%= @mushaf.id %>/<%= page_num %>"
     >
  <% if @words.present? %>
    <%= render 'shared/mushaf_page',
               words: @words,
               page: page_num,
               mushaf: @mushaf,
               hide_controls: true
    %>
  <% else %>
    <div style="padding: 48px; text-align: center; color: #64748b; font-family: sans-serif; font-size: 14px;">
      <div style="font-size: 28px; margin-bottom: 8px;">📖</div>
      <div style="font-weight: bold; color: #334155; margin-bottom: 4px;">Mushaf Page <%= page_num %></div>
      <div style="font-size: 12px; color: #94a3b8;">No data available for this page.</div>
    </div>
  <% end %>
</div>

