<%= content_for :heading do %>
  <%= render 'shared/page_font', verses: [@word.verse] %>
<% end %>

<%
  font_family = get_quran_script_font_family(params[:script], @word.verse)
  font_size = params[:font_size]
%>

<div id="content"
     data-file-name="word/<%= params[:script] %>/<%= @word.location.gsub(':', '/') %>"
     class="<%= font_family %> <%= params[:css_class] %> tajweed-new"
     style="font-size: <%= font_size %>px; line-height: 2 !important; padding: 20px; text-align: center; width: 100%; <%= 'background: transparent;' if params[:transparent] == 'true' %>">
  <%= safe_html @word.read_attribute(params[:script]) %>
</div>

<style>
  #content {
      direction: rtl;
      text-align: center;
      width: 100%;
      box-sizing: border-box;
  }

  rule {
      display: inline;
  }
</style>