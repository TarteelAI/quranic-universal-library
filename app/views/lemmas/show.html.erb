<%
  lemma = @presenter.lemma
  forms = @presenter.word_forms.to_a
  actions = [link_to('Suggest a fix', edit_lemma_path(lemma.id), class: 'btn btn-success')]
%>

<%= render 'tools/header',
           name: 'Word lemma',
           title: @presenter.page_title,
           key: 'lemma',
           actions: actions,
           breadcrumb_parents: [{ label: 'Lemmas', path: lemmas_path }]
%>

<div class="page-wrapper container max-w-7xl mx-auto px-4">
  <div class="page-section">
    <%= render 'shared/pending_suggestions', suggestions: @presenter.pending_suggestions,
               summary: ->(draft) { render('lemmas/draft_summary', draft: draft) } %>

    <dl class="grid grid-cols-1 sm:grid-cols-[10rem_1fr] gap-x-4 gap-y-2 text-sm">
      <dt class="font-semibold text-gray-600">Lemma</dt>
      <dd><span class="qpc-hafs text-2xl" dir="rtl"><%= lemma.text_madani %></span></dd>
      <dt class="font-semibold text-gray-600">Without harakat</dt>
      <dd><span class="text-xl" dir="rtl"><%= lemma.text_clean %></span></dd>
      <dt class="font-semibold text-gray-600">English meaning</dt>
      <dd><%= Array(lemma.en_translations).join(', ').presence || content_tag(:span, 'None', class: 'text-gray-400') %></dd>
      <dt class="font-semibold text-gray-600">In the Quran</dt>
      <dd><%= pluralize(lemma.words_count.to_i, 'time') %>, in <%= pluralize(forms.size, 'form') %></dd>
    </dl>
  </div>

  <div class="page-section mt-4">
    <h2>Words with this lemma</h2>

    <%= render 'shared/word_forms', forms: forms %>
  </div>
</div>
