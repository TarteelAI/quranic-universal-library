<%# One i'rab line: the fragments IrabLine / IrabPhraseLine produce. Kept on one line so no stray whitespace lands between Arabic spans. %>
<span class="irab-segment-line <%= line_class %><%= ' irab-phrase-line' if local_assigns[:phrase] %>" dir="<%= line_dir %>"><% frags.each do |frag| %><% if frag[:wrapper_class] %><span class="<%= frag[:wrapper_class] %>"><% frag[:children].each do |child| %><% if child[:color_class].to_s == 'black' %><span><%= child[:text] %></span><% else %><span class="<%= child[:color_class] %>"><%= child[:text] %></span><% end %><% end %></span><% else %><%
  classes = []
  classes << 'treebank-quran-text' if frag[:quran_font]
  classes << frag[:color_class] unless frag[:color_class].to_s == 'black'
  link = frag[:link_type] && frag[:link_key].present?
  modal_url = link ? (frag[:link_type] == :root ? morphology_root_path(frag[:link_key]) : morphology_lemma_path(frag[:link_key])) : nil
%><% if link %><a class="text-blue-700 underline<%= ' treebank-quran-text' if frag[:quran_font] %>" data-controller="ajax-modal" data-css-class="modal-lg" data-url="<%= modal_url %>" href="#_"><%= frag[:text] %></a><% elsif classes.any? %><span class="<%= classes.join(' ') %>"><%= frag[:text] %></span><% else %><%= frag[:text] %><% end %><% end %><% end %></span>
