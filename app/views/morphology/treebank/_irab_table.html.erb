<%
  joining_letters = %w[ب ت ث ج ح خ س ش ص ض ط ظ ع غ ف ق ك ل م ن ه ي]
  tashkeel_regex = /[ؐ-ًؚ-ٰٟ]/

  get_last_base_letter = ->(text) {
    letters_only = text.gsub(tashkeel_regex, '')
    letters_only[-1]
  }

  needs_zwj = ->(text) {
    joining_letters.include?(get_last_base_letter.call(text))
  }

  irab_rows_obj = Morphology::Treebank::IrabRows.new(
    tokens,
    chapter_number: chapter_number,
    verse_number:   verse_number
  )
  rows    = irab_rows_obj.rows
  head_map = irab_rows_obj.head_map

  t_attr = ->(obj, key) {
    obj.respond_to?(key) ? obj.public_send(key) : obj[key]
  }
%>
<table dir="rtl" class="irab-table w-full border-collapse">
  <tbody>
    <% rows.each do |row| %>
      <%
        segments = row[:word_tokens]
        last_idx = segments.size - 1
      %>
      <tr class="border-b border-gray-200">
        <td dir="rtl" class="irab-word-cell px-3 py-2 align-top whitespace-nowrap">
          <% segments.each_with_index do |seg, idx| %>
            <%
              seg_text = t_attr.call(seg, :text_qpc_hafs).to_s
              pos_key = t_attr.call(seg, :pos_key).to_s
              color = Morphology::Treebank::Colors.pos(pos_key)
              display_text = (idx < last_idx && needs_zwj.call(seg_text)) ? (seg_text + "‍") : seg_text
            %>
            <span class="qpc-hafs quran-text <%= color %>"><%= display_text %></span>
          <% end %>
        </td>
        <td dir="rtl" class="irab-line-cell px-3 py-2 align-top">
          <% segments.each do |seg| %>
            <%
              head_token_id = t_attr.call(seg, :head_token_id)
              head_tok = head_token_id ? head_map[head_token_id] : nil
              line = Morphology::Treebank::IrabLine.new(seg, head_token: head_tok, translator: irab_translator)
              frags = line.fragments
            %>
            <span class="irab-segment-line">
              <% frags.each do |frag| %>
                <span class="<%= frag[:color_class] %><%= frag[:arabic_font] ? ' qpc-hafs' : '' %>"><%= frag[:text] %></span>
              <% end %>
            </span>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
