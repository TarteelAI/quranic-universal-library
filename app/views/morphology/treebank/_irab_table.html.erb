<%
  irab_rows_obj = Morphology::Treebank::IrabRows.new(
    tokens,
    chapter_number: chapter_number,
    verse_number:   verse_number
  )
  rows    = irab_rows_obj.rows
  head_map = irab_rows_obj.head_map

  t_attr = ->(obj, key) {
    obj.respond_to?(key) ? obj.public_send(key) : obj[key]
  }

  line_locale = local_assigns.fetch(:locale, 'ar').to_s
  line_dir    = line_locale == 'en' ? 'ltr' : 'rtl'
  line_class  = { 'ar' => 'ar', 'ur' => 'ur' }.fetch(line_locale, '')
%>
<table dir="rtl" class="irab-table w-full border-collapse">
  <tbody>
    <% rows.each do |row| %>
      <% segments = row[:word_tokens] %>
      <tr class="border-b border-gray-200">
        <td dir="rtl" class="irab-word-cell px-3 py-2 align-top whitespace-nowrap"><% segments.each do |seg| %><% color = Morphology::Treebank::Colors.pos(t_attr.call(seg, :pos_key).to_s) %><span class="qpc-hafs quran-text <%= color %>"><%= t_attr.call(seg, :text_qpc_hafs).to_s %></span><% end %></td>
        <td dir="rtl" class="irab-line-cell px-3 py-2 align-top">
          <% segments.each do |seg| %>
            <%
              head_token_id = t_attr.call(seg, :head_token_id)
              head_tok = head_token_id ? head_map[head_token_id] : nil
              line = Morphology::Treebank::IrabLine.new(seg, head_token: head_tok, translator: irab_translator, locale: line_locale)
              frags = line.fragments
            %>
            <span class="irab-segment-line <%= line_class %>" dir="<%= line_dir %>"><% frags.each do |frag| %><% if frag[:wrapper_class] %><span class="<%= frag[:wrapper_class] %>"><% frag[:children].each do |child| %><% if child[:color_class].to_s == 'black' %><span><%= child[:text] %></span><% else %><span class="<%= child[:color_class] %>"><%= child[:text] %></span><% end %><% end %></span><% else %><%
              classes = []
              classes << 'qpc-hafs' if frag[:quran_font]
              classes << frag[:color_class] unless frag[:color_class].to_s == 'black'
              link = frag[:link_type] && frag[:link_key].present?
              modal_url = link ? (frag[:link_type] == :root ? morphology_root_path(frag[:link_key]) : morphology_lemma_path(frag[:link_key])) : nil
            %><% if link %><a class="text-blue-700 underline<%= ' qpc-hafs' if frag[:quran_font] %>" data-controller="ajax-modal" data-css-class="modal-lg" data-url="<%= modal_url %>" href="#_"><%= frag[:text] %></a><% elsif classes.any? %><span class="<%= classes.join(' ') %>"><%= frag[:text] %></span><% else %><%= frag[:text] %><% end %><% end %><% end %></span>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
