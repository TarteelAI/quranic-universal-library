<%
  irab_rows_obj = Morphology::Treebank::IrabRows.new(
    tokens,
    chapter_number: chapter_number,
    verse_number:   verse_number
  )
  rows     = irab_rows_obj.rows
  head_map = irab_rows_obj.head_map
  multi_verse = rows.map { |r| r[:verse_key] }.uniq.size > 1

  t_attr = ->(obj, key) { Morphology::Treebank::IrabLine.read_attr(obj, key) }

  line_locale = local_assigns.fetch(:locale, 'ar').to_s
  line_dir    = %w[en ru].include?(line_locale) ? 'ltr' : 'rtl'
  line_class  = { 'ar' => 'ar', 'ur' => 'ur' }.fetch(line_locale, '')
%>
<table dir="rtl" class="irab-table w-full border-collapse">
  <tbody>
    <% previous_verse = nil %>
    <% rows.each do |row| %>
      <% if multi_verse && row[:verse_key] != previous_verse %>
        <tr class="irab-verse-row<%= ' is-current' if row[:current] %>">
          <td colspan="2" class="px-3 py-1 text-sm font-semibold" dir="ltr">
            <%= link_to row[:verse_key], morphology_treebank_ayah_path(*row[:verse_key].split(':'), locale: line_locale) %>
          </td>
        </tr>
        <% previous_verse = row[:verse_key] %>
      <% end %>
      <% segments = row[:word_tokens] %>
      <tr class="border-b border-gray-200<%= ' irab-current-verse' if multi_verse && row[:current] %>">
        <td dir="rtl" class="irab-word-cell px-3 py-2 align-top whitespace-nowrap"><% segments.each do |seg| %><% color = Morphology::Treebank::Colors.pos(t_attr.call(seg, :pos_key).to_s) %><span class="treebank-quran-text quran-text <%= color %>"><%= (t_attr.call(seg, :text_digital_khatt) || t_attr.call(seg, :text_qpc_hafs)).to_s %></span><% end %></td>
        <td dir="rtl" class="irab-line-cell px-3 py-2 align-top">
          <% segments.each do |seg| %>
            <%
              head_token_id = t_attr.call(seg, :head_token_id)
              line = Morphology::Treebank::IrabLine.new(
                seg,
                head_token: head_token_id ? head_map[head_token_id] : nil,
                translator: irab_translator,
                locale: line_locale,
                predicate_token: irab_rows_obj.predicate_for(seg),
                phrase_head: irab_rows_obj.phrase_head?(seg)
              )
            %>
            <%= render 'morphology/treebank/irab_fragments', frags: line.fragments, line_class: line_class, line_dir: line_dir %>
          <% end %>
          <% row[:phrase_tokens].each do |phrase_tok| %>
            <%
              head_token_id = t_attr.call(phrase_tok, :head_token_id)
              phrase_line = Morphology::Treebank::IrabPhraseLine.new(
                phrase_tok,
                head_token: head_token_id ? head_map[head_token_id] : nil,
                span_tokens: irab_rows_obj.span_tokens(phrase_tok),
                translator: irab_translator,
                locale: line_locale
              )
            %>
            <%= render 'morphology/treebank/irab_fragments', frags: phrase_line.fragments, line_class: line_class, line_dir: line_dir, phrase: true %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
