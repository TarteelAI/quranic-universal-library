<%= render 'tools/header',
           name: 'NoorBayan Treebank',
           key: 'noor_bayan_treebank',
           wide_container: true
%>

<div class="page-wrapper container px-4">
  <div class="page-section filters">
    <%= form_tag morphology_treebank_index_path, method: :get do %>
      <div data-controller="chapter-verses-filter" class="flex flex-wrap">
        <%= render 'shared/filters' %>

        <div class="mb-4 me-4">
          <%= select_tag :pos_tag,
                         options_for_select([['Any POS', '']] + @pos_tag_options, params[:pos_tag].to_s),
                         class: 'w-44 border border-gray-300 rounded px-2 py-2 text-sm bg-white h-[38px]',
                         data: { controller: 'select2', placeholder: 'POS tag' } %>
          <label class="block text-sm font-medium text-gray-700">Filter by POS tag</label>
        </div>

        <div class="mb-4 me-4">
          <%= select_tag :rel_label,
                         options_for_select([['Any relation', '']] + @rel_label_options, params[:rel_label].to_s),
                         class: 'w-44 border border-gray-300 rounded px-2 py-2 text-sm bg-white h-[38px]',
                         data: { controller: 'select2', placeholder: 'Relation label' } %>
          <label class="block text-sm font-medium text-gray-700">Filter by relation</label>
        </div>

        <div class="mb-4 me-4">
          <%= select_tag :root_id,
                         options_for_select([['Any root', '']] + @root_options.map { |text, id| [text, id.to_s] }, params[:root_id].to_s),
                         class: 'w-44 border border-gray-300 rounded px-2 py-2 text-sm bg-white h-[38px]',
                         data: { controller: 'select2', placeholder: 'Root' } %>
          <label class="block text-sm font-medium text-gray-700">Filter by root</label>
        </div>

        <div class="mb-4 me-4">
          <%= select_tag :lemma_id,
                         options_for_select([['Any lemma', '']] + @lemma_options.map { |text, id| [text, id.to_s] }, params[:lemma_id].to_s),
                         class: 'w-44 border border-gray-300 rounded px-2 py-2 text-sm bg-white h-[38px]',
                         data: { controller: 'select2', placeholder: 'Lemma' } %>
          <label class="block text-sm font-medium text-gray-700">Filter by lemma</label>
        </div>

        <div class="mb-4">
          <%= submit_tag 'Filter', class: 'btn btn-success mr-3 h-[38px]', data: { disable_with: 'Please wait..' } %>
          <%= link_to 'Clear', morphology_treebank_index_path, class: 'text-sm text-gray-700 hover:underline' if has_filters?(:filter_chapter, :verse_number, :verse_key, :pos_tag, :rel_label, :root_id, :lemma_id) %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="page-section mt-4">
    <h2 class="text-2xl mb-4">Ayah list</h2>

    <div class="tools-table-overflow">
      <table class="w-full hover:bg-gray-50">
        <thead class="sticky top-0 z-10 bg-white border-b-2 border-black">
          <tr>
            <th>Key</th>
            <th>Ayah</th>
            <th>Sentences</th>
            <th>Tokens</th>
          </tr>
        </thead>

        <tbody>
          <% @verses.each do |verse| %>
            <tr class="hover:bg-gray-200 border-b">
              <th scope="row" class="py-2 pl-2">
                <%= link_to verse.verse_key,
                            morphology_treebank_ayah_path(verse.chapter_id, verse.verse_number),
                            class: 'text-blue-600 hover:underline' %>
              </th>
              <td class="py-2">
                <div class="qpc-hafs quran-text text-right" dir="rtl">
                  <%= truncate verse.text_qpc_hafs, length: 90 %>
                </div>
              </td>
              <td class="py-2 text-center"><%= verse.sentences_count %></td>
              <td class="py-2 text-center"><%= verse.tokens_count %></td>
            </tr>
          <% end %>

          <tr>
            <td colspan="4">
              <%= pagination_section @pagy %>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
