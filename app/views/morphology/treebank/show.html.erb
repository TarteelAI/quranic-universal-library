<%= render 'tools/header',
           name: 'NoorBayan Treebank',
           key: 'noor_bayan_treebank',
           wide_container: true,
           actions: [
             link_to('Back', morphology_treebank_index_path, class: 'inline-flex items-center justify-center px-3 py-1.5 rounded text-sm font-medium bg-sky-600 text-white hover:bg-sky-700')
           ]
%>

<div class="page-wrapper container px-4">
  <div class="page-section">
    <% if @expandable %>
      <div data-controller="treebank syntax-graph-download"
           data-treebank-url-value="<%= @data_url %>"
           data-treebank-expandable-value="true">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-4">
          <%= render 'morphology/treebank/current_ayah' %>

          <div class="flex items-center gap-2">
            <%= render 'morphology/treebank/language_dropdown', expandable: true %>

            <button type="button"
                    id="treebank-zoom-in"
                    data-treebank-target="zoomIn"
                    data-action="click->treebank#zoomIn"
                    class="px-2 py-1.5 bg-white border border-gray-300 rounded text-sm hover:bg-gray-50"
                    title="Zoom in">
              <i class="fa fa-search-plus"></i>
            </button>
            <button type="button"
                    id="treebank-zoom-out"
                    data-treebank-target="zoomOut"
                    data-action="click->treebank#zoomOut"
                    class="px-2 py-1.5 bg-white border border-gray-300 rounded text-sm hover:bg-gray-50"
                    title="Zoom out">
              <i class="fa fa-search-minus"></i>
            </button>
            <button type="button"
                    id="treebank-zoom-reset"
                    data-treebank-target="zoomReset"
                    data-action="click->treebank#zoomReset"
                    class="px-2 py-1.5 bg-white border border-gray-300 rounded text-sm hover:bg-gray-50"
                    title="Reset zoom">
              <i class="fa fa-compress"></i>
            </button>
            <button type="button"
                    id="treebank-download"
                    data-treebank-target="download"
                    data-action="click->syntax-graph-download#download"
                    class="px-2 py-1.5 bg-white border border-gray-300 rounded text-sm hover:bg-gray-50"
                    title="Download PNG">
              <i class="fa fa-download"></i>
            </button>
          </div>
        </div>

        <div data-treebank-target="accordionList" class="tb-accordion-list">
          <div class="text-gray-500 p-4">Loading treebank...</div>
        </div>
        <div data-treebank-target="container" class="hidden"></div>
      </div>
    <% else %>
      <div data-controller="treebank syntax-graph-download"
           data-treebank-url-value="<%= @data_url %>">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-4">
          <%= render 'morphology/treebank/current_ayah' %>

          <div class="flex items-center gap-2">
            <%= render 'morphology/treebank/language_dropdown' %>

            <button type="button"
                    id="treebank-zoom-in"
                    data-treebank-target="zoomIn"
                    data-action="click->treebank#zoomIn"
                    class="px-2 py-1.5 bg-white border border-gray-300 rounded text-sm hover:bg-gray-50"
                    title="Zoom in">
              <i class="fa fa-search-plus"></i>
            </button>
            <button type="button"
                    id="treebank-zoom-out"
                    data-treebank-target="zoomOut"
                    data-action="click->treebank#zoomOut"
                    class="px-2 py-1.5 bg-white border border-gray-300 rounded text-sm hover:bg-gray-50"
                    title="Zoom out">
              <i class="fa fa-search-minus"></i>
            </button>
            <button type="button"
                    id="treebank-zoom-reset"
                    data-treebank-target="zoomReset"
                    data-action="click->treebank#zoomReset"
                    class="px-2 py-1.5 bg-white border border-gray-300 rounded text-sm hover:bg-gray-50"
                    title="Reset zoom">
              <i class="fa fa-compress"></i>
            </button>
            <button type="button"
                    id="treebank-download"
                    data-treebank-target="download"
                    data-action="click->syntax-graph-download#download"
                    class="px-2 py-1.5 bg-white border border-gray-300 rounded text-sm hover:bg-gray-50"
                    title="Download PNG">
              <i class="fa fa-download"></i>
            </button>
          </div>
        </div>

        <div class="treebank-canvas"
             data-controller="draggable-scroll"
             data-action="mousedown->draggable-scroll#mouseDownHandler"
             data-treebank-target="canvas">
          <div data-treebank-target="container" class="text-gray-500 p-4">
            Loading treebank...
          </div>
        </div>
      </div>
    <% end %>

    <% if @irab_tokens.any? %>
      <div class="mt-8">
        <h2 class="text-lg font-semibold mb-3">I'rab (إعراب)</h2>
        <%= render partial: 'morphology/treebank/irab_table',
                   locals: { tokens: @irab_tokens, irab_translator: @irab_translator, locale: @locale,
                             chapter_number: @chapter_number, verse_number: @verse_number } %>
      </div>
    <% end %>
  </div>
</div>