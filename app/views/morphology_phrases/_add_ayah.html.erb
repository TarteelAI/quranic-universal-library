<%= turbo_frame_tag 'add-ayah' do %>
  <div class="flex flex-wrap items-center gap-3">
    <%= label_tag 'add_ayah_key', 'Add an ayah manually', class: 'text-xs font-bold text-blue-700' %>
    <div class="w-40">
      <%= select_tag 'add_ayah_key', options_for_select(Verse.order('id asc').pluck(:verse_key, :verse_key)), include_blank: true, class: 'w-full', data: { placeholder: 'Ayah key, e.g. 2:255', controller: 'select2' } %>
    </div>
  </div>
<% end %>
