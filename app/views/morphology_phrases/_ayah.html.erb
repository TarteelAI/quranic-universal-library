<%
  ayah = card.verse
  ranges = card.ranges.select { |r| r[0].present? && r[1].present? }.map { |r| r.map(&:to_i).minmax }
  persisted = card.saved?
  phrase_ayah_id = card.phrase_verse_id
  word_kinds = card.word_kinds || {}
  icon_button = 'h-7 w-7 inline-flex items-center justify-center rounded border transition-colors'
%>

<div id="<%= dom_id ayah %>"
     class="ayah bg-white rounded-lg border <%= persisted ? 'border-green-500' : 'border-gray-200' %> p-3 mb-3"
     data-controller="mutashabihat-ayah"
     data-categories="<%= card.categories.join(' ') %>"
     data-mutashabihat-ayah-ranges-value="<%= ranges.to_json %>"
     data-mutashabihat-ayah-excluded-value="<%= card.excluded.map(&:to_i).to_json %>"
     data-mutashabihat-ayah-editable-value="<%= @access.present? %>"
     data-mutashabihat-ayah-saved-value="<%= persisted %>"
     data-ayahid="<%= ayah.id %>"
     data-ayahkey="<%= ayah.verse_key %>">
  <div class="flex flex-wrap justify-between items-center gap-2 mb-2">
    <div class="flex flex-wrap items-center gap-1.5">
      <span class="px-2 py-0.5 rounded text-sm font-bold bg-gray-800 text-white"><%= ayah.verse_key %></span>
      <% if card.source %>
        <span class="px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-700">Source</span>
      <% end %>
      <% if persisted %>
        <% if card.approved %>
          <span class="px-2 py-0.5 rounded text-xs font-medium bg-green-600 text-white"><i class="fas fa-check text-[10px]"></i> Approved</span>
        <% else %>
          <span class="px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-800" title="Saved earlier but not approved yet" data-controller="tooltip">Not approved</span>
        <% end %>
      <% end %>
      <% card.labels.each do |label| %>
        <span class="px-2 py-0.5 rounded text-xs font-medium <%= label == 'Exact' ? 'bg-green-50 text-green-700 border border-green-100' : 'bg-amber-50 text-amber-800 border border-amber-100' %>"><%= label %></span>
      <% end %>
      <span class="flex flex-wrap items-center gap-1" data-mutashabihat-ayah-target="ranges"></span>
      <% if card.suggested_ranges && @access %>
        <button type="button"
                class="px-2 py-0.5 rounded text-xs font-medium border border-dashed border-blue-300 text-blue-700 hover:bg-blue-50"
                data-action="mutashabihat-ayah#useRanges"
                data-ranges="<%= card.suggested_ranges.to_json %>"
                title="The saved words differ from what the detector found"
                data-controller="tooltip">
          Use suggested <%= card.suggested_ranges.map { |f, t| f == t ? f : "#{f}–#{t}" }.join(', ') %>
        </button>
      <% end %>
    </div>

    <div class="flex items-center gap-1">
      <% if @access %>
        <button type="button"
                class="h-7 px-2.5 text-xs font-medium bg-green-600 hover:bg-green-700 text-white rounded transition-colors inline-flex items-center gap-1.5"
                data-mutashabihat-ayah-target="saveButton"
                data-action="mutashabihat-ayah#save">
          <i class="fas fa-check"></i> <%= persisted && card.approved ? 'Update' : 'Approve' %>
        </button>
        <button type="button"
                class="<%= icon_button %> bg-white border-slate-300 text-slate-600 hover:bg-slate-50"
                data-action="mutashabihat-ayah#clear"
                title="Clear selection"
                data-controller="tooltip">
          <i class="fas fa-eraser text-xs"></i>
        </button>
        <button type="button"
                class="<%= icon_button %> bg-white border-red-200 text-red-600 hover:bg-red-50"
                data-action="mutashabihat-ayah#remove"
                title="<%= persisted ? 'Remove this ayah from the phrase' : 'Hide this suggestion' %>"
                data-controller="tooltip">
          <i class="fas fa-trash text-xs"></i>
        </button>
        <button type="button"
                class="<%= icon_button %> bg-white border-slate-300 text-slate-600 hover:bg-slate-50"
                data-mutashabihat-ayah-target="bookmark"
                data-action="mutashabihat-ayah#toggleBookmark"
                title="Bookmark"
                data-controller="tooltip">
          <i class="fas fa-bookmark text-xs"></i>
        </button>
      <% end %>

      <% if persisted %>
        <%= link_to "/cms/morphology_phrase_verses/#{phrase_ayah_id}",
                    target: '_blank',
                    class: "#{icon_button} bg-white border-slate-300 text-slate-500 hover:text-blue-600",
                    title: 'Open in admin',
                    data: { controller: 'tooltip' } do %>
          <i class="fas fa-external-link-alt text-xs"></i>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="phrase-words" dir="rtl">
    <% ayah.words.sort_by(&:position).each do |w| %>
      <% next if w.ayah_mark? %>
      <% kind = word_kinds[w.position] %>
      <button type="button"
              class="phrase-word <%= "kind-#{kind}" if kind %>"
              title="<%= Mutashabihat::Match::KIND_LABELS[kind] %>"
              data-position="<%= w.position %>"
              data-mutashabihat-ayah-target="word"
              data-action="mutashabihat-ayah#pick"
              <%= 'disabled' unless @access %>>
        <span class="qpc-hafs"><%= w.text_qpc_hafs %></span>
        <small><%= w.position %></small>
      </button>
    <% end %>
  </div>
</div>
