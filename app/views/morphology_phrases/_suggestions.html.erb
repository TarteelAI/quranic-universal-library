<%= render 'tools/header',
           name: 'Mutashabihat ul Quran',
           title: 'Mutashabihat Phrase Builder',
           key: 'mutashabihat',
           actions: [
             link_to('Auto-detect in ayah', morphology_phrase_path(review.verse.id, proofread: true), class: 'h-10 px-4 py-2 text-sm font-medium bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 rounded transition-colors inline-flex items-center'),
             link_to('Back', morphology_phrases_path, class: 'h-10 px-4 py-2 text-sm font-medium bg-slate-700 hover:bg-slate-800 text-white rounded transition-colors inline-flex items-center')
           ]
%>

<%
  verse = review.verse
  cards = review.cards
  counts = review.counts
  filters = [['all', 'All'], ['saved', 'Saved'], ['exact', 'Exact'], ['similar', 'Similar']]
%>

<div class="page-wrapper container max-w-7xl mx-auto px-4 pb-12" style="position: relative">
  <div data-controller="mutashabihat-builder" class="mutashabihat">
    <%= form_with url: new_morphology_phrase_path, method: :get, data: { mutashabihat_builder_target: 'form' } do |f| %>
      <%= f.hidden_field :phrase_id, value: review.phrase&.id %>
      <%= f.hidden_field :text, value: review.phrase_text, id: 'text', name: nil %>
      <%= f.hidden_field :word_from, value: review.from, id: 'word_from', data: { mutashabihat_builder_target: 'wordFrom' } %>
      <%= f.hidden_field :word_to, value: review.to, id: 'word_to', data: { mutashabihat_builder_target: 'wordTo' } %>

      <div data-mutashabihat-builder-target="sentinel"></div>
      <div class="source-bar z-30 bg-white border border-gray-200 rounded-lg shadow-sm px-4 py-3 mt-4 mb-4" data-mutashabihat-builder-target="bar">
        <div class="source-controls flex flex-wrap items-center gap-x-4 gap-y-2">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Source</span>
            <div class="w-28">
              <%= f.select :ayah_key, options_for_select(Verse.order('id asc').pluck(:verse_key, :verse_key), selected: verse.verse_key), { include_blank: true }, class: 'w-full', id: 'source_ayah', data: { placeholder: 'Ayah', controller: 'select2' } %>
            </div>
          </div>

          <span class="text-xs text-slate-500">
            <%= pluralize(review.to - review.from + 1, 'word') %>
            <% if review.phrase&.persisted? %>
              · phrase #<%= review.phrase.id %>
              <span class="ml-1 px-1.5 py-0.5 rounded <%= review.phrase.reviewed? ? 'bg-blue-100 text-blue-800' : 'bg-amber-100 text-amber-800' %>"><%= review.phrase.review_status_label %></span>
            <% end %>
          </span>

          <span class="ms-auto text-xs text-slate-400 hidden md:inline" data-mutashabihat-builder-target="hint">Click the first and last word to change the phrase</span>
        </div>

        <div class="phrase-words source-words mt-2" dir="rtl">
          <span class="stuck-only text-xs font-bold text-slate-500 self-center ms-2" dir="ltr"><%= verse.verse_key %></span>
          <% review.words.each do |w| %>
            <% highlight = w.position.between?(review.from, review.to) %>
            <button type="button"
                    class="phrase-word <%= 'is-selected' if highlight %> <%= 'range-start' if w.position == review.from %> <%= 'range-end' if w.position == review.to %>"
                    data-position="<%= w.position %>"
                    data-mutashabihat-builder-target="sourceWord"
                    data-action="mutashabihat-builder#pickSourceWord">
              <span class="qpc-hafs"><%= w.text_qpc_hafs %></span>
              <small><%= w.position %></small>
            </button>
          <% end %>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-sm border border-gray-200" data-controller="tabs">
        <div class="border-b border-gray-100 bg-gray-50/50 px-4 flex flex-wrap items-center justify-between gap-2">
          <ul class="flex flex-wrap -mb-px text-sm font-medium text-center" role="tablist">
            <li class="mr-2" role="presentation">
              <button type="button"
                      class="inline-block px-4 py-3 border-b-2 rounded-t-lg border-blue-600 text-blue-600 active"
                      data-action="click->tabs#switch"
                      data-tabs-target-value="tab-suggestions"
                      role="tab" aria-selected="true">
                Ayahs
                <span class="ml-1 px-2 py-0.5 text-xs font-bold bg-green-100 text-green-700 rounded-full"><%= cards.size %></span>
              </button>
            </li>
            <li class="mr-2" role="presentation">
              <button type="button"
                      class="inline-block px-4 py-3 border-b-2 border-transparent rounded-t-lg hover:text-gray-600 hover:border-gray-300"
                      data-action="click->tabs#switch"
                      data-tabs-target-value="tab-ayahs"
                      role="tab" aria-selected="false">
                Saved preview
              </button>
            </li>
          </ul>

          <div class="flex items-center gap-1 py-2" role="group" aria-label="Filter ayahs">
            <% filters.each do |key, label| %>
              <button type="button"
                      class="filter-button <%= 'is-active' if key == 'all' %>"
                      data-filter="<%= key %>"
                      data-action="mutashabihat-builder#filter">
                <%= label %> <span class="opacity-60"><%= counts[key].to_i %></span>
              </button>
            <% end %>
          </div>
        </div>

        <div class="tab-content p-4">
          <div class="tab-pane active" id="tab-suggestions" role="tabpanel">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3 text-xs text-slate-500">
              <% if @access %>
                <p>
                  Click the first and last word of a range, more ranges the same way. Click a selected word to exclude it.
                  <strong class="text-slate-700">Approve</strong> saves the ayah to the phrase.
                </p>
              <% end %>
              <div class="kind-legend flex flex-wrap items-center gap-2">
                <span class="kind-affix">prefix/suffix</span>
                <span class="kind-form">word form</span>
                <span class="kind-similar">sounds similar</span>
                <span class="kind-changed">changed</span>
                <span class="kind-moved">moved</span>
                <span class="kind-added">added</span>
              </div>
            </div>

            <% if @access %>
              <div class="bg-blue-50 rounded-lg p-3 mb-4 border border-blue-100">
                <%= render 'add_ayah' %>
              </div>
            <% end %>

            <div id="suggested-ayahs">
              <% cards.each do |card| %>
                <%= render 'ayah', card: card %>
              <% end %>
              <% if cards.size <= 1 %>
                <div class="text-center py-12 text-gray-500" id="no-suggestions">
                  <i class="fas fa-search text-4xl mb-4 opacity-20"></i>
                  <p>No other ayah shares this phrase.</p>
                  <p class="text-sm mt-1">Try a different range of words, or add an ayah by hand.</p>
                </div>
              <% end %>
            </div>
          </div>

          <div class="tab-pane hidden" id="tab-ayahs" role="tabpanel">
            <% if review.phrase&.persisted? %>
              <%= turbo_frame_tag 'phrase-verses', src: morphology_phrase_path(review.phrase.id, result_type: 'preview'), loading: "lazy", target: 'self' do %>
                <div class="flex items-center justify-center py-12">
                  <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
                  <span class="ml-3 text-gray-500">Loading saved ayahs...</span>
                </div>
              <% end %>
            <% else %>
              <div class="text-center py-12 text-gray-500">
                <p>Approve at least one ayah to see the saved phrase here.</p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
