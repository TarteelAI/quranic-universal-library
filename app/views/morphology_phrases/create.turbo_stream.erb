<%= turbo_stream.replace 'flash-messages' do %>
  <%= render 'shared/flash_notices' %>
<% end %>

<%= turbo_stream.replace dom_id(@verse) do %>
  <%= render 'ayah', card: Mutashabihat::PhraseReview.saved_card(@verse, @phrase_verses, @phrase) %>
<% end %>

<%= turbo_stream.replace 'phrase_id' do %>
  <input autocomplete="off" type="hidden" name="phrase_id" id="phrase_id" value="<%= @phrase.id %>">
<% end %>
