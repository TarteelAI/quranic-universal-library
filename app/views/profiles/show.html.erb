<div class="max-w-[1200px] mx-auto px-4 md:px-8 py-8">
  <div class="bg-white border border-black/10 rounded-xl overflow-hidden">
    <div class="p-8">
      <div class="flex flex-col lg:flex-row gap-8">
        <div class="flex-shrink-0">
          <span class="w-24 h-24 rounded-full bg-[#46ac7a] text-white flex items-center justify-center text-3xl font-bold">
            <%= current_user.initials %>
          </span>
        </div>

        <div class="flex-1">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
            <div>
              <h1 class="text-2xl font-bold text-black">
                <%= current_user.name %>
              </h1>
              <div class="mt-2 text-gray-600 break-all">
                <%= current_user.email %>
              </div>
              <div class="mt-1 text-sm text-gray-500">
                Member since <%= current_user.created_at.strftime("%b %Y") %>
              </div>
            </div>
            <%= link_to "Edit profile",
                        edit_profile_path,
                        class: "inline-flex items-center justify-center rounded-lg border border-[#46ac7a] px-4 py-2 text-sm font-medium text-[#46ac7a] hover:bg-[#46ac7a]/5 transition" %>
          </div>

          <% if current_user.about_me.present? %>
            <div class="mt-8">
              <h2 class="font-semibold text-black">
                About
              </h2>
              <div class="mt-3 text-gray-600 leading-7 [&_ul]:list-disc [&_ul]:ps-6 [&_ol]:list-decimal [&_ol]:ps-6 [&_a]:text-[#46ac7a] [&_a]:underline [&_h1]:font-bold [&_h2]:font-bold [&_h3]:font-semibold">
                <%= sanitize current_user.about_me %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mt-10">
        <div class="border border-black/5 rounded-xl p-6 text-center">
          <div class="text-3xl font-bold text-[#46ac7a]">
            <%= @presenter.downloads_count %>
          </div>
          <div class="mt-2 text-sm text-gray-500">
            Downloads
          </div>
        </div>
        <div class="border border-black/5 rounded-xl p-6 text-center">
          <div class="text-3xl font-bold text-[#46ac7a]">
            <%= @presenter.contributions_count %>
          </div>
          <div class="mt-2 text-sm text-gray-500">
            Contributions
          </div>
        </div>
        <div class="border border-black/5 rounded-xl p-6 text-center">
          <div class="text-3xl font-bold text-[#46ac7a]">
            <%= @presenter.editable_resources_count %>
          </div>
          <div class="mt-2 text-sm text-gray-500">
            Resources
          </div>
        </div>
      </div>
    </div>
  </div>

  <section class="mt-8"
           data-controller="remote-tab"
           data-remote-tab-active-class="bg-[#46ac7a] text-white"
           data-remote-tab-inactive-class="text-gray-600 hover:text-black">
    <div class="inline-flex gap-1 border border-black/10 rounded-lg p-1 bg-white mb-5">
      <%= profile_tab_link "Downloads", "downloads", @presenter.tab %>
      <%= profile_tab_link "Contributions", "contributions", @presenter.tab %>
      <%= profile_tab_link "Resources", "resources", @presenter.tab %>
    </div>

    <div class="relative min-h-[120px]">
      <div
        data-remote-tab-target="loader"
        class="hidden fixed inset-0 z-50 flex items-center justify-center bg-white/60">
        <svg class="animate-spin h-6 w-6 text-[#46ac7a]"
             xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24">
          <circle
            class="opacity-25"
            cx="12"
            cy="12"
            r="10"
            stroke="currentColor"
            stroke-width="4">
          </circle>
          <path
            class="opacity-75"
            fill="currentColor"
            d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z">
          </path>
        </svg>
      </div>

      <%= turbo_frame_tag "profile_panel",
                          data: {
                            action: "turbo:before-fetch-request->remote-tab#showLoader turbo:frame-load->remote-tab#hideLoader"
                          } do %>

        <% if @presenter.downloads? %>
          <%= render "downloads" %>
        <% elsif @presenter.resources? %>
          <%= render "resources" %>
        <% else %>
          <%= render "contributions" %>
        <% end %>
      <% end %>
    </div>
  </section>
</div>