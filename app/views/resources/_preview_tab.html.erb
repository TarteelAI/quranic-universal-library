<% intro = @presenter.preview_intro(resource) %>
<% related = @presenter.related_resources_for(resource) %>

<% if intro %>
  <p class="text-gray-600 mb-6 max-w-3xl"><%= intro %></p>
<% end %>

<%= render 'preview', resource: resource %>

<% if related.any? %>
  <section class="mt-10">
    <h2 class="resource-pane-title mb-4">Related resources</h2>

    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <% related.each do |item| %>
        <%= link_to detail_resources_path(item.resource_type, item.id),
                    class: 'group block rounded-lg border border-gray-200 bg-white p-4 no-underline transition hover:border-[#46ac7a] hover:shadow-sm' do %>
          <span class="block text-xs font-medium uppercase tracking-wide text-gray-500">
            <%= item.group_heading %>
          </span>
          <span class="mt-1 block font-semibold text-gray-900 group-hover:text-[#2f8a5f]">
            <%= item.name %>
          </span>
          <span class="mt-1 block text-sm text-gray-500"><%= item.humanize_cardinality_type %></span>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>
