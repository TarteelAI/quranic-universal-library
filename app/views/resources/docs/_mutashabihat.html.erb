<div class="qul-docs">
  <h2>About mutashabihat data</h2>

  <p>
    <strong>Mutashabihat</strong> are phrases that repeat, word for word or nearly so, in different ayahs of
    the Quran. For anyone memorising the Quran they are the classic source of mix-ups: you start one ayah and
    finish it with the wording of another.
  </p>

  <p>
    This resource lists those shared phrases and every place each one appears, down to the exact words, so you
    can highlight them and show similar ayahs side by side.
  </p>

  <h3>Example</h3>
  <p>
    The phrase <span class="me-quran docs-arabic-inline" dir="rtl">وَقَٰتِلُواْ فِي سَبِيلِ ٱللَّهِ</span>
    ("and fight in the way of Allah") appears 13 times, in 11 ayahs across 5 surahs. Some places use exactly
    the same words; others are close variations:
  </p>

  <div class="overflow-x-auto">
    <table class="[&_td]:align-middle">
      <thead>
      <tr>
        <th>Ayah</th>
        <th>Words</th>
        <th>Text</th>
      </tr>
      </thead>
      <tbody>
      <tr>
        <td><code>2:190</code></td>
        <td>1–4</td>
        <td><span class="me-quran docs-arabic" dir="rtl">وَقَٰتِلُواْ فِي سَبِيلِ ٱللَّهِ</span></td>
      </tr>
      <tr>
        <td><code>2:244</code></td>
        <td>1–4</td>
        <td><span class="me-quran docs-arabic" dir="rtl">وَقَٰتِلُواْ فِي سَبِيلِ ٱللَّهِ</span></td>
      </tr>
      <tr>
        <td><code>2:246</code></td>
        <td>18–21</td>
        <td><span class="me-quran docs-arabic" dir="rtl">نُّقَٰتِلۡ فِي سَبِيلِ ٱللَّهِ</span></td>
      </tr>
      <tr>
        <td><code>3:13</code></td>
        <td>9–12</td>
        <td><span class="me-quran docs-arabic" dir="rtl">تُقَٰتِلُ فِي سَبِيلِ ٱللَّهِ</span></td>
      </tr>
      </tbody>
    </table>
  </div>

  <div class="docs-callout docs-callout-tip">
    In the Preview tab, pick an ayah to see its shared phrases highlighted.
  </div>

  <h2>JSON format</h2>
  <p>
    The download is a ZIP archive with two JSON files:
  </p>
  <ul>
    <li><code>phrases.json</code>: every shared phrase, with each place it appears.</li>
    <li><code>phrase_verses.json</code>: for each ayah, the ids of the phrases in it.</li>
  </ul>

  <h3><code>phrases.json</code></h3>
  <p>An object keyed by phrase id. This is phrase <code>859</code>, shortened to three of its ayahs:</p>

  <div class="docs-code">
    <div class="docs-code-header"><span>JSON</span></div>
    <pre><code>{
  "859": {
    "surahs": 5,
    "ayahs": 11,
    "count": 13,
    "source": { "key": "2:190", "from": 1, "to": 4 },
    "ayah": {
      "2:190": [[1, 4]],
      "2:244": [[1, 4]],
      "3:13": [[9, 12]]
    }
  }
}</code></pre>
  </div>

  <table>
    <thead>
    <tr>
      <th>Field</th>
      <th>Description</th>
    </tr>
    </thead>
    <tbody>
    <tr>
      <td><code>surahs</code></td>
      <td>How many surahs the phrase appears in</td>
    </tr>
    <tr>
      <td><code>ayahs</code></td>
      <td>How many ayahs it appears in</td>
    </tr>
    <tr>
      <td><code>count</code></td>
      <td>How many times it appears in total. This can be more than <code>ayahs</code>, because one ayah can contain it twice.</td>
    </tr>
    <tr>
      <td><code>source</code></td>
      <td>The ayah and word range the phrase text is taken from. Use it to show the phrase itself.</td>
    </tr>
    <tr>
      <td><code>ayah</code></td>
      <td>
        Every ayah the phrase appears in, keyed by <code>surah:ayah</code>. Each value is a list of
        <code>[from, to]</code> word ranges, since an ayah can contain the phrase more than once.
      </td>
    </tr>
    </tbody>
  </table>

  <div class="docs-callout docs-callout-info">
    Word positions start at 1. <code>[9, 12]</code> means the 9th to the 12th word of the ayah, inclusive.
  </div>

  <h3><code>phrase_verses.json</code></h3>
  <p>An object keyed by ayah, listing the ids of the phrases found in it. Use it to look up an ayah quickly.</p>

  <div class="docs-code">
    <div class="docs-code-header"><span>JSON</span></div>
    <pre><code>{
  "2:190": [859],
  "2:244": [859],
  "3:13": [859, 15990]
}</code></pre>
  </div>

  <div class="docs-callout docs-callout-info">
    These files have word positions, not word text. To show the words, use a
    <%= link_to 'word-by-word Quran script', resource_path('quran-script') %>.
  </div>

  <h2>Highlighting phrases in an ayah</h2>
  <ol>
    <li>Look up the ayah in <code>phrase_verses.json</code> to get its phrase ids.</li>
    <li>For each id, read <code>phrases[id].ayah[ayahKey]</code> to get the word ranges in that ayah.</li>
    <li>Style the words in those ranges, for example with a colour per phrase.</li>
  </ol>

  <div class="docs-code">
    <div class="docs-code-header">
      <span>JavaScript</span>
      <button type="button" class="docs-copy-btn" data-action="docs-copy#copy">Copy</button>
    </div>
    <pre><code>// phrases and phraseVerses: the two JSON files.
// words: the ayah's words in order, from a word-by-word Quran script.
function highlightedWords(ayahKey, words, phrases, phraseVerses) {
  const colours = ["#fde68a", "#bfdbfe", "#bbf7d0", "#fecaca"];
  const highlight = new Array(words.length).fill(null);

  (phraseVerses[ayahKey] || []).forEach((phraseId, index) => {
    const ranges = phrases[phraseId].ayah[ayahKey] || [];

    ranges.forEach(([from, to]) => {
      for (let position = from; position &lt;= to; position++) {
        highlight[position - 1] = colours[index % colours.length];
      }
    });
  });

  return words.map((word, i) => ({ word, colour: highlight[i] }));
}

// highlightedWords("2:190", words, phrases, phraseVerses)
// → the first four words get a colour; the rest get null.</code></pre>
  </div>

  <h2>Show similar ayahs</h2>
  <p>
    To list the ayahs that share wording with the one being read, collect the other ayahs of each of its
    phrases:
  </p>

  <div class="docs-code">
    <div class="docs-code-header">
      <span>JavaScript</span>
      <button type="button" class="docs-copy-btn" data-action="docs-copy#copy">Copy</button>
    </div>
    <pre><code>function similarAyahs(ayahKey, phrases, phraseVerses) {
  const similar = new Set();

  (phraseVerses[ayahKey] || []).forEach((phraseId) => {
    Object.keys(phrases[phraseId].ayah).forEach((key) => {
      if (key !== ayahKey) similar.add(key);
    });
  });

  return [...similar];
}

// similarAyahs("2:190", phrases, phraseVerses)
// → ["2:244", "2:246", "3:13", "4:74", ...]</code></pre>
  </div>
</div>
