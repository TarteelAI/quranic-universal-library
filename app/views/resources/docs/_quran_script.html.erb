<%
  resource_content = resource.resource_content
  text_type = resource_content.meta_value('text-type') || resource_content.meta_value('script') || resource_content.meta_value('font-face')
  by_word = resource_content.word?
  is_image = text_type.to_s.include?('image')

  script_class = if resource_content.meta_value('qirat').present?
                   resource_content.meta_value('font-face') || text_type
                 else
                   ayah = Verse.find_by(verse_key: params[:ayah] || '73:4') || Verse.find_by(verse_key: '73:4')
                   get_quran_script_font_family(text_type, ayah) || 'qpc-hafs'
                 end
%>

<div class="qul-docs">
  <h2>About this script</h2>

  <p>
    This resource provides <strong>Quranic script</strong> in <%= resource.name %> format.
    <% if is_image %>
      The script is rendered as high-quality images for optimal display and printing.
    <% else %>
      The script uses Unicode text with specialized font rendering for digital applications.
    <% end %>
  </p>

  <h3>Sample JSON</h3>
  <div class="docs-code">
    <div class="docs-code-header"><span>JSON</span></div>
    <pre><code>{
  "1:1": {
    "verse_key": "1:1",
    "text": "<%= is_image ? '[Image URL]' : 'بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ' %>",
    "script_type": "<%= text_type %>",
    "font_family": "<%= script_class %>",<% if by_word %>
    "words": [
      {
        "position": 1,
        "text": "<%= is_image ? '[Word Image URL]' : 'بِسۡمِ' %>",
        "location": "1:1:1"
      }
    ],<% end %>
    "page_number": 1,
    "juz_number": 1,
    "hizb_number": 1
  }
}</code></pre>
  </div>

  <h3>Field descriptions</h3>
  <div class="tools-table-overflow">
    <table>
      <thead>
      <tr>
        <th>Field</th>
        <th>Type</th>
        <th>Description</th>
      </tr>
      </thead>
      <tbody>
      <tr>
        <td>verse_key</td>
        <td>String</td>
        <td>Reference in the format <code>surah:ayah</code> (e.g., <code>1:1</code>)</td>
      </tr>
      <tr>
        <td>text</td>
        <td>String</td>
        <td>
          <% if is_image %>
            URL to the image file containing the verse text
          <% else %>
            Unicode text of the verse in <%= resource.name %> script
          <% end %>
        </td>
      </tr>
      <tr>
        <td>script_type</td>
        <td>String</td>
        <td>Type of script rendering (<code><%= text_type %></code>)</td>
      </tr>
      <tr>
        <td>font_family</td>
        <td>String</td>
        <td>CSS font family for proper rendering (<code><%= script_class %></code>)</td>
      </tr>
      <% if by_word %>
        <tr>
          <td>words</td>
          <td>Array</td>
          <td>Array of word objects with individual word text/images</td>
        </tr>
        <tr>
          <td>words[].position</td>
          <td>Integer</td>
          <td>Position of the word within the verse</td>
        </tr>
        <tr>
          <td>words[].text</td>
          <td>String</td>
          <td>
            <% if is_image %>
              URL to the individual word image
            <% else %>
              Unicode text of the individual word
            <% end %>
          </td>
        </tr>
        <tr>
          <td>words[].location</td>
          <td>String</td>
          <td>Word location in format <code>surah:ayah:word</code></td>
        </tr>
      <% end %>
      <tr>
        <td>page_number</td>
        <td>Integer</td>
        <td>Mushaf page number where this verse appears</td>
      </tr>
      <tr>
        <td>juz_number</td>
        <td>Integer</td>
        <td>Juz number (1-30) containing this verse</td>
      </tr>
      <tr>
        <td>hizb_number</td>
        <td>Integer</td>
        <td>Hizb number (1-60) containing this verse</td>
      </tr>
      </tbody>
    </table>
  </div>

  <h3>Usage examples</h3>

  <div class="docs-code">
    <div class="docs-code-header"><span>CSS</span></div>
    <pre><code>.quran-text {
  font-family: '<%= script_class %>', 'Amiri', serif;
  direction: rtl;
  text-align: right;
}</code></pre>
  </div>

  <div class="docs-code">
    <div class="docs-code-header"><span>JavaScript</span></div>
    <pre><code>fetch('/api/v1/verses/1:1.json')
  .then(response =&gt; response.json())
  .then(data =&gt; {
    const el = document.getElementById('verse');
    el.innerHTML = data.text;
    el.className = '<%= script_class %>';
  });</code></pre>
  </div>

  <h3>Features</h3>
  <ul>
    <li>High-quality Arabic text rendering</li>
    <li>Proper diacritical marks and Tajweed annotations</li>
    <li>Responsive design for different screen sizes</li>
    <% if by_word %>
      <li>Word-by-word display for detailed study</li>
    <% end %>
    <% if is_image %>
      <li>Optimized image format for printing and display</li>
      <li>Consistent visual quality across all devices</li>
    <% else %>
      <li>Unicode text for easy copying and searching</li>
      <li>Scalable vector rendering</li>
    <% end %>
  </ul>
</div>
    
