  </div>

  <h3>Table: <code>root_words</code></h3>
  <table>
    <thead>
    <tr>
      <th>Column</th>
      <th>Type</th>
      <th>Description</th>
    </tr>
    </thead>
    <tbody>
    <tr>
      <td><code>root_id</code></td>
      <td>INTEGER</td>
      <td>The word's root, from <code>roots.id</code></td>
    </tr>
    <tr>
      <td><code>word_location</code></td>
      <td>TEXT</td>
      <td>Word position as <code>surah:ayah:word</code>, e.g. <code>1:1:3</code> is the third word of the first ayah</td>
    </tr>
    </tbody>
  </table>

  <div class="docs-code">
    <div class="docs-code-header"><span>Sample rows</span></div>
    <pre><code>root_id | word_location
1356    | 1:1:3
450     | 1:2:1
1572    | 2:31:1</code></pre>
  </div>

  <div class="docs-callout docs-callout-info">
    This file has word locations, not word text. To show the words, join on location with a
    <%= link_to 'word-by-word Quran script', resource_path('quran-script') %>.
  </div>

  <h2>Example queries</h2>

  <h3>Find the root of a word</h3>
  <div class="docs-code">
    <div class="docs-code-header">
      <span>SQL</span>
      <button type="button" class="docs-copy-btn" data-action="docs-copy#copy">Copy</button>
    </div>
    <pre><code>SELECT roots.*
FROM root_words
JOIN roots ON roots.id = root_words.root_id
WHERE root_words.word_location = '1:1:3';
-- 1356 | ر ح م | rHm | 339 | 47</code></pre>
  </div>

  <h3>Every word from a root</h3>
  <div class="docs-code">
    <div class="docs-code-header">
      <span>SQL</span>
      <button type="button" class="docs-copy-btn" data-action="docs-copy#copy">Copy</button>
    </div>
    <pre><code>SELECT root_words.word_location
FROM root_words
JOIN roots ON roots.id = root_words.root_id
WHERE roots.english_trilateral = 'rHm';  -- 339 locations</code></pre>
  </div>

  <h3>Most common roots</h3>
  <div class="docs-code">
    <div class="docs-code-header">
      <span>SQL</span>
      <button type="button" class="docs-copy-btn" data-action="docs-copy#copy">Copy</button>
    </div>
    <pre><code>SELECT arabic_trilateral, english_trilateral, words_count
FROM roots
ORDER BY words_count DESC
LIMIT 10;</code></pre>
  </div>

  <h3>Four-letter roots</h3>
  <div class="docs-code">
    <div class="docs-code-header">
      <span>SQL</span>
      <button type="button" class="docs-copy-btn" data-action="docs-copy#copy">Copy</button>
    </div>
    <pre><code>SELECT arabic_trilateral, english_trilateral, words_count
FROM roots
WHERE length(english_trilateral) = 4;  -- 40 roots</code></pre>
  </div>
</div>
