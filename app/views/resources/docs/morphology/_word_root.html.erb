        <td><code>S</code> <span class="me-quran docs-arabic-inline" dir="rtl">ص</span></td>
      </tr>
      <tr>
        <td><code>D</code> <span class="me-quran docs-arabic-inline" dir="rtl">ض</span></td>
        <td><code>T</code> <span class="me-quran docs-arabic-inline" dir="rtl">ط</span></td>
        <td><code>Z</code> <span class="me-quran docs-arabic-inline" dir="rtl">ظ</span></td>
        <td><code>E</code> <span class="me-quran docs-arabic-inline" dir="rtl">ع</span></td>
        <td><code>g</code> <span class="me-quran docs-arabic-inline" dir="rtl">غ</span></td>
