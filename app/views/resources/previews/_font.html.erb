<%
  resource_content = resource.resource_content
  sample_text = resource_content.meta_value('text')
  font_face = resource_content.meta_value('font-face')

  font_base_path = resource_content.meta_value('ttf')
  font_format = 'ttf'
  font_extension = '.ttf'

  unless font_base_path.present?
    font_base_path = resource_content.meta_value('woff2')
    font_format = 'woff2'
    font_extension = '.woff2'
  end

  unless font_base_path.present?
    font_base_path = resource_content.meta_value('woff')
    font_format = 'woff'
    font_extension = '.woff'
  end

  unless font_base_path.present?
    font_base_path = resource_content.meta_value('otf')
    font_format = 'otf'
    font_extension = '.otf'
  end

  preview_pattern = resource_content.meta_value('preview-pattern') ||
                    resource_content.meta_value('preview_pattern')

  # V1/V2 Mushaf fonts ship one file per Quran page, named p1..p604 inside the
  # directory recorded in the meta. Their font-face is stored as "p1-v1".
  page_based_font = font_face.to_s.match?(/\Ap\d+-v/)
  page_number = nil
  total_pages = 604

  if page_based_font
    page_number = params[:page].to_s.delete('^0-9').to_i
    page_number = 1 unless page_number.between?(1, total_pages)

    font_face = font_face.sub(/\Ap\d+/, "p#{page_number}")
    font_url = "https://static-cdn.tarteel.ai/qul/fonts/#{font_base_path}/p#{page_number}#{font_extension}"

    mushaf_version = font_face[/-v(\d+)\z/, 1]
    page_column, line_column, text_column = if mushaf_version == '2'
      [:v2_page, :line_v2, :code_v2]
    else
      [:page_number, :line_number, :code_v1]
    end

    sample_text = Word
                    .where(page_column => page_number)
                    .order(:word_index)
                    .pluck(line_column, text_column)
                    .group_by(&:first)
                    .map { |_line, words| words.map(&:last).join(' ') }
                    .join("\n")
  elsif preview_pattern.present?
    page_key = (params[:page].presence || 'p1').to_s
    preview_base = preview_pattern.sub(/p\d+$/, page_key)
    font_url = "https://static-cdn.tarteel.ai/qul/fonts/#{preview_base}#{font_extension}"
  else
    font_url = "https://static-cdn.tarteel.ai/qul/fonts/#{font_base_path}#{font_extension}"
  end

  css_format = { 'woff2' => 'woff2', 'woff' => 'woff', 'otf' => 'opentype' }.fetch(font_format, 'truetype')

  ligatures = resource_content.meta_value('ligatures')
  ligatures = Oj.load(ligatures) if ligatures.present?

  preview_text = params[:text].presence || sample_text
%>

<link rel="preload" href="<%= font_url %>" as="fetch" crossorigin="anonymous">

<% if page_based_font %>
  <div class="font-toolbar mt-5">
    <span class="font-semibold text-gray-700">
      This font has one file per Quran page. Showing page <%= page_number %>.
    </span>

    <div class="font-toolbar-group ms-auto">
      <% if page_number > 1 %>
        <%= link_to '← Previous', detail_resources_path(resource.resource_type, resource.id, page: page_number - 1),
                    class: 'btn btn-secondary btn-sm' %>
      <% end %>

      <%= form_with url: detail_resources_path(resource.resource_type, resource.id), method: :get,
                    data: { turbo: false }, class: 'flex items-center gap-2 m-0' do %>
        <%= label_tag :page, 'Go to page', class: 'm-0 whitespace-nowrap font-medium' %>
        <%= number_field_tag :page, page_number, min: 1, max: total_pages,
                             class: 'w-24 rounded border-gray-300 py-1 px-2 text-sm' %>
        <%= submit_tag 'Go', class: 'btn btn-outline btn-sm', data: { turbo: false } %>
      <% end %>

      <% if page_number < total_pages %>
        <%= link_to 'Next →', detail_resources_path(resource.resource_type, resource.id, page: page_number + 1),
                    class: 'btn btn-secondary btn-sm' %>
      <% end %>
    </div>
  </div>
<% end %>

<div class="mt-5"
     data-controller="tabs font-preview"
     data-font-preview-font-url-value="<%= font_url %>"
     data-font-preview-font-format-value="<%= font_format %>"
     data-font-preview-font-face-value="<%= font_face %>"
     data-font-preview-sample-text-value="<%= sample_text %>">

  <ul class="resource-tabs" id="font-docs-tab" role="tablist">
    <li class="m-0 flex-none" role="presentation">
      <button class="btn-tab-active"
              id="tab-docs"
              data-action="click->tabs#switch"
              data-tabs-target-value="tab-docs-pane"
              type="button" role="tab"
              aria-controls="tab-docs-pane"
              aria-selected="true">
        Documentation
      </button>
    </li>

    <li class="m-0 flex-none" role="presentation">
      <button class="btn-tab"
              id="tab-preview"
              data-action="click->tabs#switch"
              data-tabs-target-value="tab-preview-pane"
              type="button" role="tab"
              aria-controls="tab-preview-pane"
              aria-selected="false">
        Live preview
      </button>
    </li>

    <% if ligatures.present? %>
      <li class="m-0 flex-none" role="presentation">
        <button class="btn-tab"
                id="tab-ligatures"
                data-action="click->tabs#switch click->font-preview#showLigatures"
                data-tabs-target-value="tab-ligatures-pane"
                type="button" role="tab"
                aria-controls="tab-ligatures-pane"
                aria-selected="false">
          Ligatures
        </button>
      </li>
    <% end %>

    <li class="m-0 flex-none" role="presentation">
      <button class="btn-tab"
              id="tab-glyphs"
              data-action="click->tabs#switch click->font-preview#showGlyphs"
              data-tabs-target-value="tab-glyphs-pane"
              type="button" role="tab"
              aria-controls="tab-glyphs-pane"
              aria-selected="false">
        Glyphs
      </button>
    </li>
  </ul>

  <div class="tab-content pt-6" id="font-docs-tab-content">

    <div class="tab-pane active" id="tab-docs-pane" role="tabpanel" aria-labelledby="tab-docs" tabindex="0">
      <div class="qul-docs">
        <h2>Using this font</h2>

        <div class="docs-callout docs-callout-warning">
          <strong>These steps cover the web only.</strong>
          On React&nbsp;Native, Android and iOS you bundle the font with the app instead, using each
          platform's own font registration.
        </div>

        <p>
          Download the font in whichever format suits your platform — <strong>TTF</strong>,
          <strong>WOFF</strong> or <strong>WOFF2</strong> — or ship several of them so older browsers
          have a fallback. Then declare it with <code>@font-face</code> and apply it to your elements.
        </p>

        <p>
          A font on its own is not enough to render the Quran. Most Quran fonts need a matching
          <strong>Quran script</strong>, because the text has to use exactly the characters the font was
          built for. Download the matching script from the
          <%= link_to 'Quran Scripts', resource_path('quran-script') %> page. Fonts for Surah names, Juz
          titles and similar decorative text instead rely on <strong>ligatures</strong> — a lookup table
          that maps a name to the character that draws it. When this font has one, you will find it in the
          Ligatures tab above.
        </p>

        <h3>1. Download the font</h3>
        <p>Use the download buttons at the top of this page, then serve the file from your own site or CDN.</p>

        <h3>2. Declare it in your CSS</h3>
        <div class="docs-code">
          <div class="docs-code-header">
            <span>CSS</span>
            <button type="button" class="docs-copy-btn" data-action="font-preview#copyCode">Copy</button>
          </div>
          <pre><code>@font-face {
  font-family: '<%= font_face %>';
  src: url('<%= font_url %>') format('<%= css_format %>');
  font-display: swap;
}

.quran-text {
  font-family: '<%= font_face %>';
}</code></pre>
        </div>

        <h3>3. Use it in your markup</h3>
        <div class="docs-code">
          <div class="docs-code-header">
            <span>HTML</span>
            <button type="button" class="docs-copy-btn" data-action="font-preview#copyCode">Copy</button>
          </div>
          <pre><code>&lt;p class="quran-text" dir="rtl"&gt;<%= sample_text %>&lt;/p&gt;</code></pre>
        </div>

        <div class="docs-callout docs-callout-info">
          Want to see how your own text renders before you wire any of this up? Switch to the
          <strong>Live preview</strong> tab.
        </div>
      </div>
    </div>

    <div class="tab-pane hidden" id="tab-preview-pane" role="tabpanel" aria-labelledby="tab-preview" tabindex="0">
      <div class="space-y-4">
        <div>
          <label for="sample-text-input" class="block font-semibold text-gray-700 mb-1">Your text</label>
          <textarea id="sample-text-input"
                    rows="3"
                    dir="rtl"
                    class="w-full p-3 border border-gray-300 rounded-lg font-mono text-sm focus:outline-none focus:ring-2 focus:ring-[#46ac7a]/40"
                    placeholder="Paste or type text to render with this font…"
                    data-font-preview-target="sampleTextInput"
                    data-action="input->font-preview#updateSampleText"><%= preview_text %></textarea>
          <p class="text-gray-500 text-sm mt-1">
            The preview updates as you type. It is prefilled with a sample this font can render.
          </p>
        </div>

        <div class="font-toolbar">
          <div class="font-toolbar-group">
            <label for="font-size-slider">Size</label>
            <input id="font-size-slider" type="range" min="12" max="160" value="40"
                   data-font-preview-target="fontSizeSlider" data-action="input->font-preview#updateFontSize">
            <span class="font-toolbar-value" data-font-preview-target="fontSizeValue">40px</span>
          </div>

          <div class="font-toolbar-group">
            <label for="line-height-slider">Line height</label>
            <input id="line-height-slider" type="range" min="10" max="30" value="17"
                   data-font-preview-target="lineHeightSlider" data-action="input->font-preview#updateLineHeight">
            <span class="font-toolbar-value" data-font-preview-target="lineHeightValue">1.7</span>
          </div>

          <div class="font-toolbar-group">
            <label for="preview-direction">Direction</label>
            <select id="preview-direction" class="font-toolbar-select"
                    data-action="change->font-preview#updateDirection">
              <option value="rtl">Right to left</option>
              <option value="ltr">Left to right</option>
            </select>
          </div>

          <button type="button" class="btn btn-secondary btn-sm" data-action="font-preview#resetPreview">
            Reset
          </button>
        </div>

        <div id="sample-text"
             dir="rtl"
             class="p-6 rounded-lg bg-white border border-gray-200 shadow-sm min-h-[8rem] break-words"
             style="font-size: 40px; line-height: 1.7;"
             data-font-preview-target="sampleText"><%= preview_text %></div>
      </div>
    </div>

    <% if ligatures.present? %>
      <div class="tab-pane hidden" id="tab-ligatures-pane" role="tabpanel" aria-labelledby="tab-ligatures" tabindex="0">
        <div class="space-y-4">
          <p class="text-gray-600">
            This font draws each of the names below as a single glyph. Copy the ligature text into your
            markup and render it with this font — copying the name itself will not work.
          </p>

          <div class="font-toolbar">
            <input type="search"
                   class="font-toolbar-search"
                   placeholder="Filter by name…"
                   aria-label="Filter ligatures"
                   data-font-preview-target="ligatureSearch"
                   data-action="input->font-preview#filterLigatures">

            <div class="font-toolbar-group">
              <label for="ligature-size-slider">Size</label>
              <input id="ligature-size-slider" type="range" min="16" max="120" value="40"
                     data-font-preview-target="ligatureSizeSlider"
                     data-action="input->font-preview#updateLigatureSize">
              <span class="font-toolbar-value" data-font-preview-target="ligatureSizeValue">40px</span>
            </div>

            <span class="font-toolbar-count" data-font-preview-target="ligatureCount"></span>
          </div>

          <div class="tools-table-overflow border border-gray-200 rounded-lg">
            <table class="w-full text-sm">
              <thead class="sticky top-0 z-10 bg-gray-50 border-b border-gray-200 text-left">
                <tr>
                  <th class="py-2 px-3 font-medium w-12">#</th>
                  <th class="py-2 px-3 font-medium">Name</th>
                  <th class="py-2 px-3 font-medium">Preview</th>
                  <th class="py-2 px-3 font-medium w-40">Copy</th>
                </tr>
              </thead>
              <tbody data-font-preview-target="ligaturesTable">
                <% ligatures.each_with_index do |(name, glyph_text), index| %>
                  <tr class="border-b border-gray-100 hover:bg-gray-50"
                      data-ligature-row
                      data-ligature-name="<%= name.to_s.downcase %>">
                    <td class="py-2 px-3 text-gray-500"><%= index + 1 %></td>
                    <td class="py-2 px-3"><%= name %></td>
                    <td class="py-2 px-3">
                      <span class="ligature-preview" style="font-size: 40px;"
            data-font-preview-target="ligaturePreview"
            data-ligature-text="<%= glyph_text %>"><%= glyph_text %></span>
                    </td>
                    <td class="py-2 px-3">
                      <div class="flex gap-2">
                        <button type="button" class="btn btn-outline btn-sm"
                                data-action="font-preview#copyValue"
                                data-copy-value="<%= glyph_text %>">
                          Ligature
                        </button>
                        <button type="button" class="btn btn-outline btn-sm"
                                data-action="font-preview#copyValue"
                                data-copy-value="<%= name %>">
                          Name
                        </button>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    <% end %>

    <div class="tab-pane hidden" id="tab-glyphs-pane" role="tabpanel" aria-labelledby="tab-glyphs" tabindex="0">
      <div class="space-y-4">
        <div class="font-toolbar">
          <input type="search"
                 class="font-toolbar-search"
                 placeholder="Search by character, name or Unicode (e.g. 0627, U+FB57, alif)…"
                 aria-label="Search glyphs"
                 data-font-preview-target="glyphSearch"
                 data-action="input->font-preview#filterGlyphs">

          <div class="font-toolbar-group">
            <label for="glyph-zoom">Size</label>
            <input id="glyph-zoom" type="range" min="70" max="260" value="120"
                   data-font-preview-target="glyphZoom"
                   data-action="input->font-preview#updateGlyphZoom">
          </div>

          <label class="font-toolbar-group cursor-pointer hidden">
            <input type="checkbox" data-font-preview-target="unmappedToggle"
                   data-action="change->font-preview#filterGlyphs">
            Unmapped
          </label>

          <label class="font-toolbar-group cursor-pointer hidden">
            <input type="checkbox" data-font-preview-target="emptyToggle"
                   data-action="change->font-preview#filterGlyphs">
            Empty
          </label>

          <span class="font-toolbar-count" data-font-preview-target="glyphCount"></span>
        </div>

        <div class="glyph-grid" data-font-preview-target="glyphsContainer"></div>
      </div>
    </div>
  </div>

  <style>
    @font-face {
      font-family: '<%= font_face %>';
      src: url('<%= font_url %>') format('<%= css_format %>');
      font-display: swap;
    }

    #sample-text,
    #tab-ligatures-pane .ligature-preview {
      font-family: '<%= font_face %>';
    }
  </style>
</div>
