<%
  resource_content = resource.resource_content
  mushaf = Mushaf.where(resource_content_id: resource_content.id).first
  page = (params[:page] || 1).to_i.abs
  if page < 0 || page > mushaf.pages_count
    page = 1
  end

  words = MushafWord.where(page_number: page, mushaf: mushaf).order('position_in_page ASC')

%>

<div>
  <div class="space-y-6">
    <h2 class="resource-pane-title">
      <%= resource.name %> Page <%= page %>
    </h2>

    <% if mushaf %>
    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-center mb-6">
      <div class="flex w-full items-center gap-2 sm:w-auto">
        <%= label_tag :page, 'Jump to page', class: 'shrink-0 whitespace-nowrap text-sm sm:text-base font-medium' %>
        <%= select_tag :page,
                       options_for_select((1..mushaf.pages_count).to_a, page),
                       onchange: "jumpToPage(this.value)",
                       class: 'min-w-0 flex-1 px-3 py-2 border rounded bg-white shadow-sm sm:min-w-[200px] sm:flex-none',
                       data: { controller: 'select2' }
        %>
      </div>

      <div class="flex w-full flex-nowrap justify-center gap-2 sm:w-auto">
        <% if page > 1 %>
          <%= link_to detail_resources_path('mushaf-layout', resource.id, page: page - 1), class: 'btn btn-secondary whitespace-nowrap text-sm sm:text-base', aria: { label: 'Previous page' } do %>
            ← Previous
          <% end %>
        <% end %>

        <% if page < mushaf.pages_count %>
          <%= link_to detail_resources_path('mushaf-layout', resource.id, page: page + 1), class: 'btn btn-secondary whitespace-nowrap text-sm sm:text-base', aria: { label: 'Next page' } do %>
            Next →
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="py-5 px-2 sm:px-6 sm:py-6 rounded-xl bg-white shadow max-w-2xl mx-auto">
      <div class="flex justify-center flex-col items-center">
      <%= render 'shared/mushaf_page',
                 words: words,
                 page: page,
                 mushaf: mushaf,
                 name: resource_content.name,
                 hide_controls: true
      %>
      </div>
    </div>
    <% end %>
  </div>
</div>

