<%
  resource_content = resource.resource_content
  text_type = resource_content.meta_value('text-type') || resource_content.meta_value('script') || resource_content.meta_value('font-face')

  key = params[:ayah] || '73:4'
  ayah = Verse.find_by(verse_key: key) || Verse.find_by(verse_key: '73:4')
  by_word = resource_content.word?
  is_image = text_type.to_s.include?('image')
  is_qirat = resource_content.meta_value('qirat').present?

  if is_qirat
    script_class = resource_content.meta_value('font-face') || text_type

    if by_word
      qirat_words = QuranScript::ByWord
                      .where(resource_content_id: resource_content.id, chapter_id: ayah.chapter_id, verse_number: ayah.verse_number)
                      .order(:word_number)
    else
      qirat_verse = QuranScript::ByVerse
                      .find_by(resource_content_id: resource_content.id, chapter_id: ayah.chapter_id, verse_number: ayah.verse_number)
    end
  else
    script_class = get_quran_script_font_family(text_type, ayah) || 'qpc-hafs'
  end
%>

<%= render 'shared/page_font', verses: [ayah] %>

<div class="mt-5" data-controller="tabs">
  <ul class="resource-tabs" id="quran-script-tab" role="tablist">
    <li class="m-0 flex-none" role="presentation">
      <button class="btn-tab-active"
              id="tab-preview"
              data-action="click->tabs#switch"
              data-tabs-target-value="tab-preview-pane"
              type="button"
              role="tab"
              aria-controls="tab-preview-pane"
              aria-selected="true">
        Preview
      </button>
    </li>
    <li class="m-0 flex-none" role="presentation">
      <button class="btn-tab"
              id="tab-help"
              data-action="click->tabs#switch"
              data-tabs-target-value="tab-help-pane"
              type="button"
              role="tab"
              aria-controls="tab-help-pane"
              aria-selected="false">
        Help
      </button>
    </li>
  </ul>

  <div class="tab-content" id="quran-script-tab-content">
    <div class="tab-pane fade show active"
         id="tab-preview-pane"
         role="tabpanel"
         aria-labelledby="tab-preview" tabindex="0">
      <div class="space-y-6">
        <h2 class="resource-pane-title">
          <%= resource.name %> preview of Surah <%= ayah.chapter.name_simple %> ayah <%= ayah.verse_number %>
        </h2>

        <div class="flex flex-wrap items-center justify-center gap-4 mb-6">
          <div class="flex items-center">
            <%= label_tag :ayah, 'Jump to Ayah', class: 'me-2 font-medium' %>
            <%= select_tag :ayah,
                           [],
                           onchange: "jumpToAyah(this.value)",
                           class: "px-3 py-2 border rounded bg-white shadow-sm",
                           style: 'min-width: 220px',
                           data: { controller: 'remote-select2', url: '/api/v1/verses/select2.json' } %>
          </div>

          <div class="flex gap-2">
            <% if ayah.previous_ayah %>
              <%= link_to detail_resources_path('translation', resource.id, ayah: ayah.previous_ayah.verse_key), class: 'btn btn-secondary' do %>
                ← Previous
              <% end %>
            <% end %>

            <% if ayah.next_ayah %>
              <%= link_to detail_resources_path('translation', resource.id, ayah: ayah.next_ayah.verse_key), class: 'btn btn-secondary' do %>
                Next →
              <% end %>
            <% end %>
          </div>
        </div>

        <div class="p-6 rounded-xl bg-white shadow max-w-2xl mx-auto">
          <% if is_qirat %>
            <% if by_word %>
              <div class="flex flex-wrap gap-2 quran-text">
                <% qirat_words.each do |word| %>
                  <span class="px-4 py-2 border border-gray-300 word">
                    <div class="<%= script_class %>">
                      <%= safe_html word.text %>
                    </div>
                  </span>
                <% end %>
              </div>
            <% else %>
              <div class="<%= script_class %>">
                <%= safe_html qirat_verse&.text %>
              </div>
            <% end %>
          <% elsif by_word %>
            <div class="flex flex-wrap gap-2 quran-text">
              <% ayah.words.each_with_index do |word, index| %>
                <span class="px-4 py-2 border border-gray-300 word">
                  <% if is_image %>
                    <img src="<%= word.send(text_type) %>" alt="<%= word.location %>"/>
                  <% else %>
                    <div class="<%= script_class %>">
                      <%= safe_html word.read_attribute(text_type) %>
                    </div>
                  <% end %>
                </span>
              <% end %>
            </div>
          <% else %>
            <% if is_image %>
              <div>
                <img src="<%= ayah.send(text_type) %>" alt="<%= ayah.verse_key %>"/>
              </div>
            <% else %>
              <div class="<%= script_class %>">
                <%= safe_html ayah.read_attribute(text_type) %>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="tab-pane hidden"
         id="tab-help-pane"
         role="tabpanel"
         aria-labelledby="tab-help" tabindex="1">
      <div class="qul-docs">
        <h2>About this script</h2>

        <p>
          This resource provides <strong>Quranic script</strong> in <%= resource.name %> format.
          <% if is_image %>
            The script is rendered as high-quality images for optimal display and printing.
          <% else %>
            The script uses Unicode text with specialized font rendering for digital applications.
          <% end %>
        </p>

        <h3>Sample JSON</h3>
        <div class="docs-code">
          <div class="docs-code-header"><span>JSON</span></div>
          <pre><code>{
  "1:1": {
    "verse_key": "1:1",
    "text": "<%= is_image ? '[Image URL]' : 'بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ' %>",
    "script_type": "<%= text_type %>",
    "font_family": "<%= script_class %>",<% if by_word %>
    "words": [
      {
        "position": 1,
        "text": "<%= is_image ? '[Word Image URL]' : 'بِسۡمِ' %>",
        "location": "1:1:1"
      }
    ],<% end %>
    "page_number": 1,
    "juz_number": 1,
    "hizb_number": 1
  }
}</code></pre>
        </div>

        <h3>Field descriptions</h3>
        <div class="tools-table-overflow">
          <table>
            <thead>
            <tr>
              <th>Field</th>
              <th>Type</th>
              <th>Description</th>
            </tr>
            </thead>
            <tbody>
            <tr>
              <td>verse_key</td>
              <td>String</td>
              <td>Reference in the format <code>surah:ayah</code> (e.g., <code>1:1</code>)</td>
            </tr>
            <tr>
              <td>text</td>
              <td>String</td>
              <td>
                <% if is_image %>
                  URL to the image file containing the verse text
                <% else %>
                  Unicode text of the verse in <%= resource.name %> script
                <% end %>
              </td>
            </tr>
            <tr>
              <td>script_type</td>
              <td>String</td>
              <td>Type of script rendering (<code><%= text_type %></code>)</td>
            </tr>
            <tr>
              <td>font_family</td>
              <td>String</td>
              <td>CSS font family for proper rendering (<code><%= script_class %></code>)</td>
            </tr>
            <% if by_word %>
              <tr>
                <td>words</td>
                <td>Array</td>
                <td>Array of word objects with individual word text/images</td>
              </tr>
              <tr>
                <td>words[].position</td>
                <td>Integer</td>
                <td>Position of the word within the verse</td>
              </tr>
              <tr>
                <td>words[].text</td>
                <td>String</td>
                <td>
                  <% if is_image %>
                    URL to the individual word image
                  <% else %>
                    Unicode text of the individual word
                  <% end %>
                </td>
              </tr>
              <tr>
                <td>words[].location</td>
                <td>String</td>
                <td>Word location in format <code>surah:ayah:word</code></td>
              </tr>
            <% end %>
            <tr>
              <td>page_number</td>
              <td>Integer</td>
              <td>Mushaf page number where this verse appears</td>
            </tr>
            <tr>
              <td>juz_number</td>
              <td>Integer</td>
              <td>Juz number (1-30) containing this verse</td>
            </tr>
            <tr>
              <td>hizb_number</td>
              <td>Integer</td>
              <td>Hizb number (1-60) containing this verse</td>
            </tr>
            </tbody>
          </table>
        </div>

        <h3>Usage examples</h3>

        <div class="docs-code">
          <div class="docs-code-header"><span>CSS</span></div>
          <pre><code>.quran-text {
  font-family: '<%= script_class %>', 'Amiri', serif;
  direction: rtl;
  text-align: right;
}</code></pre>
        </div>

        <div class="docs-code">
          <div class="docs-code-header"><span>JavaScript</span></div>
          <pre><code>fetch('/api/v1/verses/1:1.json')
  .then(response =&gt; response.json())
  .then(data =&gt; {
    const el = document.getElementById('verse');
    el.innerHTML = data.text;
    el.className = '<%= script_class %>';
  });</code></pre>
        </div>

        <h3>Features</h3>
        <ul>
          <li>High-quality Arabic text rendering</li>
          <li>Proper diacritical marks and Tajweed annotations</li>
          <li>Responsive design for different screen sizes</li>
          <% if by_word %>
            <li>Word-by-word display for detailed study</li>
          <% end %>
          <% if is_image %>
            <li>Optimized image format for printing and display</li>
            <li>Consistent visual quality across all devices</li>
          <% else %>
            <li>Unicode text for easy copying and searching</li>
            <li>Scalable vector rendering</li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>
