<%
  resource = resource.resource_content
  recitation = resource.one_ayah? ? Recitation.find_by(resource_content_id: resource.id) : Audio::Recitation.find_by(resource_content_id: resource.id)
%>

<div
  data-controller="<%= resource.one_ayah? ? 'ayah-segment-player' : 'surah-segment-player' %>"
  id="audio-player"
  data-recitation="<%= recitation.id %>"
  data-verse-key="<%= ayah.verse_key %>"
>

<div id="current-ayah" class="relative min-h-32 rounded-2xl bg-slate-50 p-6 shadow-inner">
  <div class="mb-4 flex items-center justify-between gap-3">
    <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">Current ayah</span>
    <span id="current-verse-key" class="rounded-full bg-white px-3 py-1 text-sm font-semibold text-slate-700 shadow-sm"><%= ayah.verse_key %></span>
  </div>
  <div id="words" class="relative z-10 flex flex-wrap qpc-hafs mb-4 gap-1 text-3xl leading-loose"></div>
  <span id="word-highlight" class="pointer-events-none absolute hidden rounded-lg bg-primary-100 ring-2 ring-primary-200 shadow-sm transition-all duration-150"></span>
</div>

<div
  class="fixed bottom-4 left-[50%] w-[94%] md:w-[70%] lg:w-[52%] -translate-x-1/2 bg-white/95 backdrop-blur-sm rounded-2xl shadow-2xl border border-gray-100 z-[100]"
>
  <div class="max-w-4xl mx-auto px-4 py-4 relative">
    <div
      id="range-repeat-panel"
      role="dialog"
      aria-label="Repeat an ayah or a range of ayahs"
      class="absolute bottom-full left-4 right-4 z-20 mb-3 hidden rounded-2xl border border-gray-200 bg-white p-4 shadow-2xl md:left-auto md:w-96">
      <div class="mb-3 flex items-center justify-between">
        <h3 class="text-sm font-semibold text-slate-700">Repeat</h3>
        <button id="range-repeat-close" type="button" aria-label="Close"
                class="flex h-7 w-7 items-center justify-center rounded-full text-slate-400 hover:bg-slate-100 hover:text-slate-600">
          <i class="fas fa-times"></i>
        </button>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <label class="flex flex-col gap-1 text-xs font-semibold text-slate-500">
          From ayah
          <select id="range-from"
                  class="rounded-lg border border-slate-200 px-2 py-1.5 text-sm font-normal text-slate-700"></select>
        </label>

        <label class="flex flex-col gap-1 text-xs font-semibold text-slate-500">
          To ayah
          <select id="range-to"
                  class="rounded-lg border border-slate-200 px-2 py-1.5 text-sm font-normal text-slate-700"></select>
        </label>

        <label class="flex flex-col gap-1 text-xs font-semibold text-slate-500">
          <span id="range-ayah-repeat-label">Repeat each ayah</span>
          <input id="range-ayah-repeat" type="number" min="1" max="99" step="1" value="1"
                 class="rounded-lg border border-slate-200 px-2 py-1.5 text-sm font-normal text-slate-700">
        </label>

        <label id="range-repeat-count-field" class="flex flex-col gap-1 text-xs font-semibold text-slate-500">
          Repeat range
          <input id="range-repeat-count" type="number" min="1" max="99" step="1" value="1"
                 class="rounded-lg border border-slate-200 px-2 py-1.5 text-sm font-normal text-slate-700">
        </label>
      </div>

      <label class="mt-3 flex items-center gap-2 text-xs font-medium text-slate-600">
        <input id="range-repeat-forever" type="checkbox" class="rounded border-slate-300">
        <span id="range-forever-label">Loop the range forever</span>
      </label>

      <p id="range-repeat-error" class="mt-2 hidden text-xs font-medium text-red-600"></p>

      <div class="mt-4 flex items-center justify-end gap-2">
        <button id="range-repeat-clear" type="button"
                class="rounded-lg px-3 py-1.5 text-sm font-semibold text-slate-500 hover:bg-slate-100">
          Clear
        </button>
        <button id="range-repeat-apply" type="button"
                class="btn btn-primary btn-sm">
          <span id="range-repeat-apply-label">Play range</span>
        </button>
      </div>
    </div>

    <p id="range-repeat-status" class="mb-2 hidden text-xs font-semibold text-emerald-700"></p>

    <div class="flex items-center gap-3">
      <button
        id="play-button"
        disabled
        class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full bg-primary-100 shadow-sm transition-all hover:bg-primary-200 hover:shadow-md">
        <i class="fas fa-play text-gray-700"></i>
      </button>

      <button
        id="range-repeat-button"
        type="button"
        aria-pressed="false"
        aria-expanded="false"
        title="Repeat an ayah or a range of ayahs"
        class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-500 transition-all hover:bg-slate-200">
        <i class="fas fa-repeat"></i>
      </button>

      <div class="flex min-w-0 flex-1 flex-col gap-2">
        <div class="flex items-center justify-between gap-3">
          <span id="current-time"
                class="text-xs font-semibold tabular-nums text-gray-600">
            0:00
          </span>
          <span id="total-duration"
                class="text-xs font-semibold tabular-nums text-gray-600">
            0:00
          </span>
        </div>

        <div class="relative h-5 flex items-center">
          <div
            id="progress-bar"
            class="pointer-events-none absolute inset-x-0 top-1/2 h-3 -translate-y-1/2 rounded-full bg-gray-200">
            <div
              id="progress"
              class="h-full w-0 rounded-full bg-blue-400"></div>
            <div
              id="progress-handle"
              class="absolute left-0 top-1/2 h-5 w-5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-white bg-blue-500 shadow-md"></div>
          </div>

          <input
            id="progress-input"
            type="range"
            min="0"
            max="1000"
            step="1"
            value="0"
            aria-label="Seek within the recitation"
            class="player-seek relative z-10 m-0 h-5 w-full cursor-pointer appearance-none bg-transparent p-0 opacity-0">
        </div>
      </div>

    </div>
  </div>
</div>
</div>
