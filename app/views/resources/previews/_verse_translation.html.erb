<%
  key = params[:ayah] || '73:4'
  ayah = Verse.find_by(verse_key: key) || Verse.find_by(verse_key: '73:4')
  translation = Translation.find_by(
    resource_content_id: resource.resource_content_id,
    verse_id: ayah.id
  )
%>

<div class="mt-5" data-controller="tabs">
  <ul class="resource-tabs" id="translation-docs-tab" role="tablist">
    <li class="m-0 flex-none" role="presentation">
      <button class="btn-tab-active"
              id="tab-docs"
              data-action="click->tabs#switch"
              data-tabs-target-value="tab-preview-pane"
              type="button"
              role="tab"
              aria-controls="tab-preview-pane"
              aria-selected="true">
        Translation Preview
      </button>
    </li>

    <li class="m-0 flex-none" role="presentation">
      <button class="btn-tab"
              id="tab-help"
              data-action="click->tabs#switch"
              data-tabs-target-value="tab-help-pane"
              type="button" role="tab"
              aria-controls="tab-help-pane"
              aria-selected="false">
        Help
      </button>
    </li>
  </ul>

  <div class="tab-content p-2 mt-3" id="translation-docs-tab-content">
    <div class="tab-pane show active"
         id="tab-preview-pane"
         role="tabpanel"
         aria-labelledby="tab-docs" tabindex="0">
      <div class="space-y-6">
        <h2 class="resource-pane-title">
          <%= resource.name %> translation for Surah <%= ayah.chapter.name_simple %> — Ayah <%= ayah.verse_number %>
        </h2>

        <div class="flex flex-wrap items-center justify-center gap-4 mb-6">
          <div class="flex items-center">
            <%= label_tag :ayah, 'Jump to Ayah', class: 'me-2 font-medium' %>
            <%= select_tag :ayah,
                           [],
                           onchange: "jumpToAyah(this.value)",
                           class: "px-3 py-2 border rounded bg-white shadow-sm",
                           style: 'min-width: 220px',
                           data: { controller: 'remote-select2', url: '/api/v1/verses/select2.json' } %>
          </div>

          <div class="flex gap-2">
            <% if ayah.previous_ayah %>
              <%= link_to detail_resources_path('translation', resource.id, ayah: ayah.previous_ayah.verse_key), class: 'btn btn-secondary' do %>
                ← Previous
              <% end %>
            <% end %>

            <% if ayah.next_ayah %>
              <%= link_to detail_resources_path('translation', resource.id, ayah: ayah.next_ayah.verse_key), class: 'btn btn-secondary' do %>
                Next →
              <% end %>
            <% end %>
          </div>
        </div>

        <div class="bg-white border border-gray-200 rounded-lg shadow-sm mb-2">
          <div class="p-6">
            <div class="qpc-hafs quran-text">
              <div class="badge badge-default text-left">
                <%= ayah.verse_key %>
              </div>
              <%= ayah.text_qpc_hafs %>
            </div>
          </div>
        </div>

        <div class="p-6 rounded-xl bg-white shadow max-w-2xl mx-auto">
          <% if translation&.text.present? %>
            <div class="<%= translation.language_name.to_s.downcase %> text-base leading-relaxed space-y-4">
              <%= safe_html translation.text %>
            </div>

            <% if translation.foot_notes.any? %>
              <div class="mt-8">
                <h5 class="font-semibold text-sm text-gray-600 mb-2">Footnotes</h5>
                <ul class="space-y-3 text-sm text-gray-700">
                  <% translation.foot_notes.each_with_index do |footnote, index| %>
                    <li class="bg-gray-50 p-4 rounded-lg">
                      <span class="font-semibold text-gray-500">[<%= index + 1 %>]</span>
                      <%= safe_html footnote.text %>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% end %>
          <% else %>
            <p class="text-gray-500 italic">Translation is not available for this ayah.</p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="tab-pane hidden"
         id="tab-help-pane"
         role="tabpanel"
         aria-labelledby="tab-docs" tabindex="1">
      <div class="qul-docs">
        <h2>About translation data</h2>

        <p>
          Translations are available as <strong>JSON</strong> and <strong>SQLite</strong>. Because different
          apps need different things — a website can render HTML, a small embedded reader often cannot — each
          translation is exported in several shapes. Pick the one that matches what your app can display.
        </p>

        <h2>Plain text formats</h2>
        <p>These two carry the translation only: no formatting and no footnotes.</p>

        <h3>Nested arrays</h3>
        <p>One array per surah, holding that surah's ayahs in order.</p>
        <div class="docs-code">
          <div class="docs-code-header"><span>JSON</span></div>
          <pre><code>[
  ["translation of 1:1", "translation of 1:2"],
  ["translation of 2:1", "translation of 2:2"]
]</code></pre>
        </div>

        <h3>Key and value</h3>
        <p>Keyed by ayah reference, which is easier to look up a single ayah in.</p>
        <div class="docs-code">
          <div class="docs-code-header"><span>JSON</span></div>
          <pre><code>{
  "1:1": "translation of 1:1",
  "1:2": "translation of 1:2",
  "114:6": "translation of 114:6"
}</code></pre>
        </div>

        <h2>Formats with footnotes</h2>
        <p>
          Some translations carry footnotes. Three more formats keep them, each trading off differently between
          fidelity and how much your renderer has to understand.
        </p>

        <h3>1. Footnotes as tags</h3>
        <p>
          A <code>&lt;sup&gt;</code> tag marks the reference in the text under <code>t</code>, and the footnote
          bodies live separately under <code>f</code>, keyed by footnote id.
        </p>
        <div class="docs-code">
          <div class="docs-code-header"><span>JSON</span></div>
          <pre><code>{
  "88:17": {
    "t": "Do the disbelievers not see how rain clouds are formed &lt;sup foot_note=\"77646\"&gt;1&lt;/sup&gt;",
    "f": {
      "77646": "The word ibl can mean 'camel' as well as 'rain cloud'..."
    }
  }
}</code></pre>
        </div>

        <h3>2. Inline footnotes</h3>
        <p>The footnote sits in the text itself, wrapped in double square brackets.</p>
        <div class="docs-code">
          <div class="docs-code-header"><span>JSON</span></div>
          <pre><code>{
  "88:17": "Do the disbelievers not see how rain clouds are formed [[The word ibl can mean 'camel' as well as 'rain cloud'...]]"
}</code></pre>
        </div>

        <h3>3. Text chunks</h3>
        <p>
          The ayah is split into a list of pieces. A piece is either a plain string or an object describing a
          footnote or a formatting tag. Use this when your app cannot render HTML at all.
        </p>
        <p>This ayah — Bridges' translation of Surah An-Nas, ayah 6 —</p>
        <div class="docs-code">
          <div class="docs-code-header"><span>HTML</span></div>
          <pre><code>&lt;i class="s"&gt;(from the whisperers)&lt;/i&gt;among the race of unseen beings&lt;sup foot_note="81506"&gt;1&lt;/sup&gt;and mankind.”</code></pre>
        </div>
        <p>is exported as:</p>
        <div class="docs-code">
          <div class="docs-code-header"><span>JSON</span></div>
          <pre><code>[
  {"type": "i", "text": "(from the whisperers)"},
  "among the race of unseen beings",
  {"type": "f", "f": "81506", "text": "1"},
  "and mankind.”"
]</code></pre>
        </div>
        <ul>
          <li>A string is plain text — print it as is.</li>
          <li><code>"type": "i"</code> (or another tag name) is formatting — render <code>text</code> in that style.</li>
          <li><code>"type": "f"</code> is a footnote reference — <code>text</code> is the marker to show and
            <code>f</code> is the footnote id to look up.</li>
        </ul>
      </div>
    </div>
  </div>
</div>
