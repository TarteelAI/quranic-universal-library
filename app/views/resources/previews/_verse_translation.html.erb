<%
  key = params[:ayah] || '73:4'
  ayah = Verse.find_by(verse_key: key) || Verse.find_by(verse_key: '73:4')
  translation = Translation.find_by(
    resource_content_id: resource.resource_content_id,
    verse_id: ayah.id
  )
%>

<div>
  <div class="space-y-6">
    <h2 class="resource-pane-title">
      <%= resource.name %> translation for Surah <%= ayah.chapter.name_simple %> — Ayah <%= ayah.verse_number %>
    </h2>

    <div class="flex flex-wrap items-center justify-center gap-4 mb-6">
      <div class="flex items-center">
        <%= label_tag :ayah, 'Jump to Ayah', class: 'me-2 font-medium' %>
        <%= select_tag :ayah,
                       [],
                       onchange: "jumpToAyah(this.value)",
                       class: "px-3 py-2 border rounded bg-white shadow-sm",
                       style: 'min-width: 220px',
                       data: { controller: 'remote-select2', url: '/api/v1/verses/select2.json' } %>
      </div>

      <div class="flex gap-2">
        <% if ayah.previous_ayah %>
          <%= link_to detail_resources_path('translation', resource.id, ayah: ayah.previous_ayah.verse_key), class: 'btn btn-secondary' do %>
            ← Previous
          <% end %>
        <% end %>

        <% if ayah.next_ayah %>
          <%= link_to detail_resources_path('translation', resource.id, ayah: ayah.next_ayah.verse_key), class: 'btn btn-secondary' do %>
            Next →
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="bg-white border border-gray-200 rounded-lg shadow-sm mb-2">
      <div class="p-6">
        <div class="qpc-hafs quran-text">
          <div class="badge badge-default text-left">
            <%= ayah.verse_key %>
          </div>
          <%= ayah.text_qpc_hafs %>
        </div>
      </div>
    </div>

    <div class="p-6 rounded-xl bg-white shadow max-w-2xl mx-auto">
      <% if translation&.text.present? %>
        <div class="<%= translation.language_name.to_s.downcase %> text-base leading-relaxed space-y-4">
          <%= safe_html translation.text %>
        </div>

        <% if translation.foot_notes.any? %>
          <div class="mt-8">
            <h5 class="font-semibold text-sm text-gray-600 mb-2">Footnotes</h5>
            <ul class="space-y-3 text-sm text-gray-700">
              <% translation.foot_notes.each_with_index do |footnote, index| %>
                <li class="bg-gray-50 p-4 rounded-lg">
                  <span class="font-semibold text-gray-500">[<%= index + 1 %>]</span>
                  <%= safe_html footnote.text %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      <% else %>
        <p class="text-gray-500 italic">Translation is not available for this ayah.</p>
      <% end %>
    </div>
  </div>
</div>
