<%
  key = params[:ayah] || '73:4'
  ayah = Verse.find_by(verse_key: key) || Verse.find_by(verse_key: '73:4')
  word_translations = WordTranslation
    .where(word: ayah.words, resource_content_id: resource.resource_content_id)
    .includes(:word)
    .order('words.position ASC')

  language_name = word_translations.first&.language_name.to_s.downcase
  is_colored = resource.name.include?('color')
%>

<div class="mt-5" data-controller="tabs">
  <ul class="resource-tabs" id="translation-docs-tab" role="tablist">
    <li class="m-0 flex-none" role="presentation">
      <button class="btn-tab-active"
              id="tab-docs"
              data-action="click->tabs#switch"
              data-tabs-target-value="tab-preview-pane"
              type="button"
              role="tab"
              aria-controls="tab-preview-pane"
              aria-selected="true">
        Translation Preview
      </button>
    </li>

    <li class="m-0 flex-none" role="presentation">
      <button class="btn-tab"
              id="tab-help"
              data-action="click->tabs#switch"
              data-tabs-target-value="tab-help-pane"
              type="button" role="tab"
              aria-controls="tab-help-pane"
              aria-selected="false">
        Help
      </button>
    </li>
  </ul>

  <div class="tab-content p-2 mt-3" id="translation-docs-tab-content">
    <div class="tab-pane show active"
         id="tab-preview-pane"
         role="tabpanel"
         aria-labelledby="tab-docs" tabindex="0">
      <div class="space-y-6">
        <h2 class="resource-pane-title">
          <%= resource.name %> translation for Surah <%= ayah.chapter.name_simple %> — Ayah <%= ayah.verse_number %>
        </h2>

        <div class="flex flex-wrap items-center justify-center gap-4 mb-6">
          <div class="flex items-center">
            <%= label_tag :ayah, 'Jump to Ayah', class: 'me-2 font-medium' %>
            <%= select_tag :ayah,
                           [],
                           onchange: "jumpToAyah(this.value)",
                           class: "px-3 py-2 border rounded bg-white shadow-sm",
                           style: 'min-width: 220px',
                           data: { controller: 'remote-select2', url: '/api/v1/verses/select2.json' } %>
          </div>

          <div class="flex gap-2">
            <% if ayah.previous_ayah %>
              <%= link_to detail_resources_path('translation', resource.id, ayah: ayah.previous_ayah.verse_key), class: 'btn btn-secondary' do %>
                ← Previous
              <% end %>
            <% end %>

            <% if ayah.next_ayah %>
              <%= link_to detail_resources_path('translation', resource.id, ayah: ayah.next_ayah.verse_key), class: 'btn btn-secondary' do %>
                Next →
              <% end %>
            <% end %>
          </div>
        </div>

        <div class="p-6 rounded-xl bg-white shadow max-w-2xl mx-auto">
          <% if word_translations.any? %>
            <div class="flex flex-wrap gap-3 justify-start quran-text">
              <% word_translations.each do |wt| %>
                <div class="bg-gray-50 p-2 rounded-lg border border-gray-200 text-center min-w-[5rem]">
                  <div class="text-lg text-gray-800 qpc-hafs mb-2 p-2">
                    <% if is_colored %>
                      <%= safe_html wt.word.text_qpc_hafs %>
                    <% else %>
                      <%= safe_html wt.word.grammar_segmented_text %>
                    <% end %>
                  </div>
                  <div class="text-sm text-gray-600 <%= language_name %>">
                    <%= safe_html wt.text %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="tab-pane hidden"
         id="tab-help-pane"
         role="tabpanel"
         aria-labelledby="tab-docs" tabindex="1">
      <div class="qul-docs">
        <h2>About word by word translation</h2>

        <p>
          A word by word translation gives the meaning of each individual word of the Quran rather than of the
          ayah as a whole. It is what powers word-level tooltips and learner views. The data is available as
          <strong>JSON</strong> and <strong>SQLite</strong>.
        </p>

        <div class="docs-callout docs-callout-info">
          Words are identified by <strong>location</strong> — <code>surah:ayah:word</code>. So
          <code>2:3:5</code> is the fifth word of Surah Al-Baqarah, ayah 3. Word numbering starts at 1.
        </div>

        <h2>JSON</h2>
        <p>A flat object keyed by word location.</p>
        <div class="docs-code">
          <div class="docs-code-header"><span>JSON</span></div>
          <pre><code>{
  "1:1:1": "In (the) name",
  "1:1:2": "(of) Allah",
  "1:1:3": "the Most Gracious",
  "1:1:4": "the Most Merciful"
}</code></pre>
        </div>

        <h2>SQLite columns</h2>
        <table>
          <thead>
            <tr>
              <th>Column</th>
              <th>Type</th>
              <th>What it holds</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>surah_number</code></td>
              <td>INTEGER</td>
              <td>Surah the word belongs to.</td>
            </tr>
            <tr>
              <td><code>ayah_number</code></td>
              <td>INTEGER</td>
              <td>Ayah within that surah.</td>
            </tr>
            <tr>
              <td><code>word_number</code></td>
              <td>TEXT</td>
              <td>Position of the word within the ayah, starting at 1.</td>
            </tr>
            <tr>
              <td><code>text</code></td>
              <td>TEXT</td>
              <td>The translation of that word.</td>
            </tr>
          </tbody>
        </table>

        <div class="docs-callout docs-callout-warning">
          This resource carries the translations only, not the Arabic. To show the word itself alongside its
          meaning you also need a word by word Quran script from the
          <a href="/resources/quran-script">Quran Scripts</a> page — join the two on the word location.
        </div>
      </div>
    </div>
  </div>
</div>





