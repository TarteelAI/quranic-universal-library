<div class="qul-docs">

  <h2>About ayah metadata</h2>

  <p>
    This resource provides <strong>metadata</strong> about each ayah in the Quran.
    If you are looking to download a specific ayah by ayah Quranic script, refer to the <a href='/resources/quran-script'>Quran Script</a> resource instead.
  </p>

  <h3>Sample JSON</h3>
  <div class="docs-code">
          <div class="docs-code-header"><span>JSON</span></div>
          <pre><code>{
  "1": {
    "id": 1,
    "surah_number": 1,
    "ayah_number": 1,
    "verse_key": "1:1",
    "words_count": 4,
    "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ ١"
  }
}</code></pre>
        </div>

  <h3>Field descriptions</h3>
  <div class="tools-table-overflow">
    <table>
      <thead>
      <tr>
        <th>Field</th>
        <th>Type</th>
        <th>Description</th>
      </tr>
      </thead>
      <tbody>
      <tr>
        <td>id</td>
        <td>Integer</td>
        <td>Unique internal ID for the ayah</td>
      </tr>
      <tr>
        <td>surah_number</td>
        <td>Integer</td>
        <td>Surah number to which the ayah belongs</td>
      </tr>
      <tr>
        <td>ayah_number</td>
        <td>Integer</td>
        <td>Ayah number within the Surah</td>
      </tr>
      <tr>
        <td>verse_key</td>
        <td>String</td>
        <td>Reference in the format <code>surah:ayah</code> (e.g., <code>1:1</code>)</td>
      </tr>
      <tr>
        <td>words_count</td>
        <td>Integer</td>
        <td>Number of words in this ayah</td>
      </tr>
      <tr>
        <td>text</td>
        <td>String</td>
        <td>Plain Unicode text of the ayah</td>
      </tr>
      </tbody>
    </table>
  </div>

</div>
