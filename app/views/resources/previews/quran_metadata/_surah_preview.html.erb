<div class="qul-docs">
  <h2>Surahs</h2>

  <div class="overflow-x-auto rounded-lg shadow-sm border border-gray-200">
    <table>
      <thead>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Simple Name</th>
        <th>Arabic Name</th>
        <th>Revelation Order</th>
        <th>Revelation Place</th>
        <th>Verse Count</th>
        <th>Bismillah?</th>
      </tr>
      </thead>

      <tbody>
      <% Chapter.order('id ASC').each do |chapter| %>
        <tr>
          <td><%= chapter.id %></td>
          <td><%= chapter.name_complex %></td>
          <td><%= chapter.name_simple %></td>
          <td><%= chapter.name_arabic %></td>
          <td><%= chapter.revelation_order %></td>
          <td><%= chapter.revelation_place.capitalize %></td>
          <td><%= chapter.verses_count %></td>
          <td>
            <% if chapter.bismillah_pre? %>
              ✅
            <% else %>
              ❌
            <% end %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>
