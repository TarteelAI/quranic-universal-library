<%# Optional note to the reviewer, saved on the draft. Pass form:, and name: when it isn't :comment %>
<div class="<%= local_assigns[:wrapper_class] || 'mb-4' %>">
  <%= form.label local_assigns[:name] || :comment, 'Comment for the reviewer (optional)', class: 'block text-sm font-medium text-gray-700 mb-1' %>
  <%= form.text_area local_assigns[:name] || :comment, value: local_assigns[:value], rows: 3,
                     class: 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500',
                     placeholder: local_assigns[:placeholder] || 'What was wrong and how you fixed it.' %>
</div>
