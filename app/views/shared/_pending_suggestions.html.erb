<%# Fixes users suggested that aren't approved yet, so nobody suggests the same fix again.
    Pass suggestions: (drafts with draft_text), and words: true for drafts with one row per word %>
<% suggestions = suggestions.to_a %>
<% if suggestions.any? %>
  <% words = local_assigns[:words] %>
  <% batches = words ? suggestions.group_by { |s| [s.user_id, s.created_at.to_i / 60] }.values : suggestions.map { |s| [s] } %>

  <div class="my-4 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
    <p class="font-semibold">
      <%= batches.size == 1 ? 'A fix has' : "#{batches.size} fixes have" %> already been suggested here and <%= batches.size == 1 ? 'is' : 'are' %> waiting for review.
    </p>
    <p class="mt-1 text-amber-800">
      Please check <%= batches.size == 1 ? 'it' : 'them' %> before suggesting another, so we don't get the same fix twice.
    </p>

    <div class="mt-3 space-y-2">
      <% batches.each do |batch| %>
        <% first = batch.first %>
        <details class="rounded border border-amber-200 bg-white">
          <summary class="cursor-pointer px-3 py-2 text-gray-700">
            Suggested <%= time_ago_in_words(first.created_at) %> ago<%= ' by you' if current_user && first.user_id == current_user.id %>
          </summary>

          <div class="border-t border-amber-100 px-3 py-2 text-gray-800">
            <% if words %>
              <table class="w-full text-sm">
                <thead>
                  <tr class="text-left text-gray-500">
                    <th class="py-1 pr-3 font-normal">Word</th>
                    <th class="py-1 pr-3 font-normal">Now</th>
                    <th class="py-1 font-normal">Suggested</th>
                  </tr>
                </thead>
                <tbody>
                  <% batch.sort_by { |s| s.word_id.to_i }.each do |s| %>
                    <tr class="border-t border-gray-100">
                      <td class="py-1 pr-3 text-gray-500"><%= s.location %></td>
                      <td class="py-1 pr-3"><%= s.current_text %></td>
                      <td class="py-1 font-medium"><%= s.draft_text %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            <% else %>
              <div dir="<%= local_assigns[:dir] %>"><%= safe_html first.draft_text %></div>
            <% end %>

            <% if first.respond_to?(:comment) && first.comment.present? %>
              <p class="mt-2 text-gray-500">Comment: <%= first.comment %></p>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>
  </div>
<% end %>
