<%# Required checkbox before a suggested fix is submitted.
    The controllers check it too, see CommunityController#suggestion_acknowledged?
    Pass hint: to say what counts as a mistake for this resource. %>
<% submitted = !request.get? %>
<% ticked = params[:acknowledgement] == '1' %>
<% hint = local_assigns[:hint] || "Typos, spelling mistakes, missing or extra words, wrong names or numbers, or text that belongs to another ayah. Not a mistake: rewording text that's already correct, or phrasing you'd prefer." %>
<div class="<%= local_assigns[:wrapper_class] || 'mb-4' %>">
  <label class="flex items-start gap-2 text-sm text-gray-700">
    <%= check_box_tag :acknowledgement, '1', ticked, required: true, class: 'mt-1' %>
    <span>I'm fixing a mistake, not changing something to suit my own preference.</span>
  </label>
  <details class="ml-6 mt-1 text-sm">
    <summary class="inline-flex cursor-pointer items-center gap-1 text-blue-700 hover:underline">
      <i class="fa fa-info-circle"></i> What counts as a mistake?
    </summary>
    <p class="mt-1 text-gray-600"><%= hint %></p>
  </details>
  <% if submitted && !ticked %>
    <p class="mt-1 text-sm text-red-600">Please tick this box to send your fix.</p>
  <% end %>
</div>
