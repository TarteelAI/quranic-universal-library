<%# Each form of a word with its most common translation, for the root, stem and lemma tools.
    Pass forms: rows with text_qpc_hafs, translation and count %>
<div class="tools-table-overflow">
  <table class="w-full">
    <thead class="sticky top-0 z-10 bg-white border-b-2 border-black">
    <tr>
      <th class="text-left pe-6">Word</th>
      <th class="text-left pe-6">Translation</th>
      <th class="text-left">Occurrences</th>
    </tr>
    </thead>
    <tbody>
    <% forms.each do |form| %>
      <tr class="border-b">
        <td class="py-2 pl-2 pe-6 whitespace-nowrap"><span class="qpc-hafs text-2xl" dir="rtl"><%= form.text_qpc_hafs %></span></td>
        <td class="py-2 pe-6"><%= safe_html form.translation %></td>
        <td class="py-2"><%= form.count %></td>
      </tr>
    <% end %>
    </tbody>
  </table>
</div>
