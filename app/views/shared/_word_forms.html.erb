<%# Each form of a word with its translations and where it is, for the root, stem and lemma tools.
    Pass forms: rows with text_qpc_hafs, translations, locations and count %>
<div class="tools-table-overflow">
  <table class="w-full">
    <thead class="sticky top-0 z-10 bg-white border-b-2 border-black">
    <tr>
      <th class="text-left pe-6">Word</th>
      <th class="text-left pe-4">Translation</th>
      <th class="text-left pe-4">Times</th>
      <th class="text-left">Where</th>
    </tr>
    </thead>
    <tbody>
    <% forms.each do |form| %>
      <% locations = form.locations.uniq %>
      <tr class="border-b">
        <td class="py-2 pl-2 pe-6 whitespace-nowrap"><span class="qpc-hafs text-2xl" dir="rtl"><%= form.text_qpc_hafs %></span></td>
        <td class="py-2 pe-4"><%= safe_html form.translations.compact.uniq { |t| strip_tags(t).downcase.strip }.join(', ') %></td>
        <td class="py-2 pe-4"><%= form.count %></td>
        <td class="py-2 text-sm text-gray-600 min-w-[12rem]">
          <%= locations.first(5).join(', ') %><%= ', ...' if locations.size > 5 %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
</div>
