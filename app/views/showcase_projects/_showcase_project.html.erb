<% action_focus = 'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gray-900 focus-visible:ring-offset-2' %>
<article class="flex flex-col bg-white rounded-xl border border-gray-200 p-5 shadow-sm" id="showcase-<%= project.id %>">
  <div class="flex items-center gap-4">
    <% if project.logo.attached? %>
      <%= image_tag project.logo, alt: '', class: 'w-14 h-14 shrink-0 rounded-xl border border-gray-200 object-cover' %>
    <% else %>
      <div class="w-14 h-14 shrink-0 rounded-xl border flex items-center justify-center text-2xl font-semibold <%= showcase_monogram_classes(project) %>" aria-hidden="true">
        <%= project.name.first.upcase %>
      </div>
    <% end %>

    <div class="min-w-0">
      <h2 class="text-lg font-semibold text-gray-900 truncate" title="<%= project.name %>">
        <%= project.name %>
      </h2>
      <p class="text-sm text-gray-500 truncate">
        <%= project.project_type_name %> · by <%= project.owner_name %>
      </p>
    </div>
  </div>

  <p class="mt-3 text-sm leading-5 text-gray-700 line-clamp-3 min-h-[3.75rem]">
    <%= project.description %>
  </p>

  <p class="mt-3 text-sm leading-5 text-gray-500 line-clamp-2" title="<%= project.qul_resources_used %>">
    <span class="font-medium text-gray-700">Uses:</span> <%= project.qul_resources_used %>
  </p>

  <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Platforms">
    <% project.platform_names.each do |platform| %>
      <li class="text-xs px-2 py-0.5 rounded border border-gray-300 text-gray-600"><%= platform %></li>
    <% end %>
  </ul>

  <div class="mt-auto pt-4 min-h-12 flex flex-wrap items-center gap-2">
    <% if project.app_store_url.present? %>
      <%= link_to project.app_store_url, target: '_blank', rel: 'noopener', class: "block shrink-0 rounded-md transition-opacity hover:opacity-80 #{action_focus}" do %>
        <%= image_tag 'store-badges/app-store.svg', alt: "Download #{project.name} on the App Store (opens in a new tab)", class: 'h-8 w-auto' %>
      <% end %>
    <% end %>
    <% if project.play_store_url.present? %>
      <%= link_to project.play_store_url, target: '_blank', rel: 'noopener', class: "block shrink-0 rounded-md transition-opacity hover:opacity-80 #{action_focus}" do %>
        <%= image_tag 'store-badges/google-play.svg', alt: "Get #{project.name} on Google Play (opens in a new tab)", class: 'h-8 w-auto' %>
      <% end %>
    <% end %>

    <div class="ml-auto flex items-center gap-2 shrink-0">
      <% if project.repository_url.present? %>
        <%= link_to project.repository_url, target: '_blank', rel: 'noopener', title: 'Source code', aria: { label: "#{project.name} source code (opens in a new tab)" }, class: "btn btn-outline-dark w-8 h-8 p-0 shrink-0 #{action_focus}" do %>
          <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/>
          </svg>
        <% end %>
      <% end %>

      <% if project.website_url.present? %>
        <%= link_to project.website_url, target: '_blank', rel: 'noopener', aria: { label: "Visit #{project.name} (opens in a new tab)" }, class: "btn btn-outline-dark h-8 px-3 text-sm gap-1.5 shrink-0 #{action_focus}" do %>
          Visit
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9.5 2.5h4v4M13.5 2.5 7 9M11.5 9.5v3a1 1 0 0 1-1 1h-7a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1h3"/>
          </svg>
        <% end %>
      <% end %>
    </div>
  </div>
</article>
