<%= render 'tools/header',
           name: 'Word stems',
           title: @presenter.page_title,
           key: 'stem'
%>

<div class="page-wrapper container max-w-7xl mx-auto px-4">
  <div class="page-section filters">
    <%= form_tag stems_path, method: :get do %>
      <div class="flex flex-wrap">
        <div class="mb-4 me-2">
          <%= text_field_tag :query, params[:query], class: 'form-control w-[85vw] sm:w-[220px] border-gray-400 rounded-[5px] h-[38px]', placeholder: 'كتاب', dir: 'rtl' %>
          <p class="text-sm text-gray-600 mt-1">Search stems, without harakat</p>
        </div>

        <div class="mb-4">
          <%= submit_tag 'Filter', class: 'btn btn-success', data: { disable_with: 'Please wait..' } %>
        </div>
      </div>
    <% end %>
  </div>

  <% stems = @presenter.stems %>
  <%= turbo_frame_tag 'stem-list', data: { turbo_action: 'advance' }, class: 'block page-section mt-4' do %>
    <h2><%= pluralize(@presenter.pagination.count, 'stem') %></h2>
    <div class="tools-table-overflow">
      <table class="w-full hover:bg-gray-50">
        <thead class="sticky top-0 z-10 bg-white border-b-2 border-black">
        <tr>
          <th class="text-left pe-4">Stem</th>
          <th class="text-left">Without harakat</th>
          <th class="text-left">Words</th>
          <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        <% stems.each do |stem| %>
          <tr class="hover:bg-gray-200 border-b">
            <td class="py-2 pl-2 pe-4 whitespace-nowrap"><span class="qpc-hafs text-2xl" dir="rtl"><%= stem.text_madani %></span></td>
            <td class="py-2"><span class="text-xl" dir="rtl"><%= stem.text_clean %></span></td>
            <td class="py-2"><%= stem.words_count %></td>
            <td class="py-2">
              <div class="flex gap-1 justify-center">
                <%= link_to 'Suggest a fix', edit_stem_path(stem.id), class: 'btn btn-info', data: { turbo_frame: '_top' } %>
                <%= link_to 'Show', stem_path(stem.id), class: 'btn btn-success', data: { turbo_frame: '_top' } %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if stems.empty? %>
          <tr>
            <td colspan="4" class="py-6 text-center text-gray-600">No stems found.</td>
          </tr>
        <% end %>
        <tr>
          <td colspan="4">
            <%= pagination_section @presenter.pagination %>
          </td>
        </tr>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
