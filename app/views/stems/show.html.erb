<%
  stem = @presenter.stem
  forms = @presenter.word_forms.to_a
  actions = [link_to('Suggest a fix', edit_stem_path(stem.id), class: 'btn btn-success')]
%>

<%= render 'tools/header',
           name: 'Word stem',
           title: @presenter.page_title,
           key: 'word_root',
           actions: actions,
           breadcrumb_parents: [{ label: 'Stems', path: stems_path }]
%>

<%= render 'word_roots/tabs', active: :stems %>

<div class="page-wrapper container max-w-7xl mx-auto px-4">
  <div class="page-section">
    <%= render 'shared/pending_suggestions', suggestions: @presenter.pending_suggestions,
               summary: ->(draft) { render('stems/draft_summary', draft: draft) } %>
    <%= render 'shared/pending_suggestions', suggestions: @presenter.pending_word_links, words: true %>

    <dl class="grid grid-cols-1 sm:grid-cols-[10rem_1fr] gap-x-4 gap-y-2 text-sm">
      <dt class="font-semibold text-gray-600">Stem</dt>
      <dd><span class="qpc-hafs text-2xl" dir="rtl"><%= stem.text_madani %></span></dd>
      <dt class="font-semibold text-gray-600">Without harakat</dt>
      <dd><span class="text-xl" dir="rtl"><%= stem.text_clean %></span></dd>
      <dt class="font-semibold text-gray-600">In the Quran</dt>
      <dd><%= pluralize(stem.words_count.to_i, 'time') %>, in <%= pluralize(forms.size, 'form') %></dd>
    </dl>
  </div>

  <div class="page-section mt-4">
    <h2>Words with this stem</h2>

    <%= render 'shared/word_forms', forms: forms %>
  </div>
</div>
