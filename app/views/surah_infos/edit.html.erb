<%
  resource = @presenter.resource
  resource_content = resource.resource_content
%>

<%= render 'tools/header',
           name: 'Surah Information',
           title: "#{h resource_content.name}<span class='block mt-2 text-lg md:text-xl text-gray-500'>Edit Surah #{resource.chapter_id} · #{h resource.chapter.name_simple}</span>",
           key: 'surah_info'
%>

<%= render 'shared/access_message' %>

<div class="page-wrapper container max-w-7xl mx-auto px-4">
  <% if resource.errors.any? %>
    <div class="mb-4 p-3 rounded border border-red-300 bg-red-50 text-sm text-red-800">
      <%= resource.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <p class="mb-3 text-sm text-gray-600">Your changes are saved as a suggestion and go live once approved.</p>

  <div class="page-section">
    <%= form_with model: @presenter.draft, scope: :draft_surah_info, url: surah_info_path(resource.id), method: :put, html: { class: 'form formtastic', autocomplete: 'off', id: 'info-form' } do |form| %>
      <div class="mb-4 mb-3">
        <%= form.label :draft_short_text, 'Short text', class: 'form-label h2' %>
        <%= form.text_area :draft_short_text, class: 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500', rows: 3, dir: (resource.language&.direction == 'rtl' ? 'rtl' : 'ltr') %>
      </div>

      <div class="mb-4">
        <%= form.label :draft_text, 'Surah Info text', class: 'form-label h2' %>
        <%= form.text_area :draft_text, class: 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500', id: 'editor', required: true, autofocus: true, data: { controller: 'tinymce' } %>
      </div>

      <%= render 'shared/draft_comment_field', form: form, value: @presenter.draft.comment,
                 placeholder: 'What was wrong and how you fixed it. For example: fixed typos in the Theme section.' %>

      <div class="mb-4 flex justify-end mt-3 gap-3">
        <%= link_to 'Cancel', surah_info_path(resource.id), class: 'px-4 py-2 text-sm font-medium bg-gray-200 hover:bg-gray-300 text-gray-800 rounded transition-colors' %>
        <%= form.submit "Save suggestion", class: 'btn btn-success btn-sm', data: { disable_with: 'Please wait...' } %>
      </div>
    <% end %>
  </div>
</div>
