<%
  lang = @resource.language_name.to_s.downcase
  url = tafsir.persisted? ? tafsir_proofreading_path(tafsir.id, resource_id: @resource.id) : tafsir_proofreadings_path(resource_id: @resource.id)
  cancel_path = tafsir.persisted? ? tafsir_proofreading_path(tafsir.id, resource_id: @resource.id) : tafsir_proofreading_path(0, resource_id: @resource.id, verse_key: tafsir.verse.verse_key)

  # Ayahs of the surahs the tafsir is in, a range can't jump far
  first_chapter, last_chapter = Verse.where(id: [tafsir.start_verse_id, tafsir.end_verse_id]).pluck(:chapter_id).minmax
  ayahs = Verse.where(chapter_id: first_chapter..last_chapter).order(:verse_index).pluck(:verse_key, :id)
  preview_url = range_preview_tafsir_proofreadings_path(resource_id: @resource.id, tafsir_id: tafsir.id)
%>

<%= form_with model: tafsir, scope: :tafsir, url: url, method: tafsir.persisted? ? :patch : :post,
              html: { role: 'form', class: 'form', autocomplete: 'off' } do |form| %>
  <%= hidden_field_tag :resource_id, @resource.id %>
  <%= render 'shared/form_errors', object: tafsir %>

  <div data-controller="tafsir-range" data-tafsir-range-url-value="<%= preview_url %>">
    <div class="flex flex-wrap gap-4">
      <div class="mb-4">
        <%= form.label :start_verse_id, 'First ayah', class: 'form-label' %>
        <%= form.select :start_verse_id, options_for_select(ayahs, tafsir.start_verse_id), {}, class: 'form-select w-40', data: { tafsir_range_target: 'start', action: 'tafsir-range#refresh' } %>
      </div>

      <div class="mb-4">
        <%= form.label :end_verse_id, 'Last ayah', class: 'form-label' %>
        <%= form.select :end_verse_id, options_for_select(ayahs, tafsir.end_verse_id), {}, class: 'form-select w-40', data: { tafsir_range_target: 'end', action: 'tafsir-range#refresh' } %>
      </div>
    </div>

    <%= turbo_frame_tag 'tafsir-range-preview', src: "#{preview_url}&start_verse_id=#{tafsir.start_verse_id}&end_verse_id=#{tafsir.end_verse_id}", data: { tafsir_range_target: 'frame' } do %>
    <% end %>
  </div>

  <div class="mb-4 <%= lang %>" id="tafsir_text">
    <%= form.label :text, 'Tafsir text', class: 'form-label' %>
    <%= form.text_area :text, class: 'form-control', id: 'editor', data: { controller: 'tinymce' } %>
  </div>

  <%= render 'shared/draft_comment_field', form: form, value: params.dig(:tafsir, :comment) %>

  <div class="mb-4 mt-5 flex justify-end gap-2">
    <%= link_to 'Cancel', cancel_path, class: 'px-4 py-2 text-sm font-medium bg-gray-200 hover:bg-gray-300 text-gray-800 rounded transition-colors no-underline' %>
    <%= form.submit 'Propose changes', class: 'btn btn-success btn-sm', data: { disable_with: 'Please wait...' } %>
  </div>
<% end %>
