<%= render 'tools/header',
           name: "Ayah tafsir",
           title: "Update #{@resource.name} <div style='font-size: 0.5em'>Tafsir of #{@tafisr.ayah_range_label}</div>",
           key: 'ayah_tafsir'
%>

<%= render 'shared/access_message' %>

<div class="page-wrapper container max-w-7xl mx-auto px-4">
  <div class="page-section">
    <h2>
      <%= @resource.name %>: tafsir of <%= @tafisr.ayah_range_label %>
    </h2>
    <p class="text-sm text-gray-500 mb-4">
      Fix the text, or change the first and last ayah this tafsir explains. The picture below shows what the new range does to the tafsirs around it. Not sure which case you have? Open <b>Help</b> at the top.
    </p>

    <%= render 'form', tafsir: @tafisr %>
  </div>
</div>
