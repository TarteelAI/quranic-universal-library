<%= render 'tools/header',
           name: "Ayah tafsir",
           title: @resource.name,
           key: 'ayah_tafsir'
%>

<div class="page-wrapper container max-w-7xl mx-auto px-4 transliteration">
  <div class="page-section filters">
    <%= form_tag tafsir_proofreadings_path, method: :get do %>
      <div data-controller="chapter-verses-filter" class="flex flex-wrap">
        <div class="mb-4 me-2">
          <%= select_tag :resource_id, options_from_collection_for_select(@tafsir_list, :id, :humanize, selected: @resource.id), include_blank: false, class: 'form-select w-[85vw] sm:w-[200px]', data: { placeholder: 'Select tafisr', controller: 'select2' } %>
          <p class="text-sm text-gray-600 mt-1">Filter tafisr</p>
        </div>

        <div class="mb-4 me-2">
          <%= select_tag :riwayah, options_for_select(@presenter.riwayah_options, @presenter.riwayah&.slug || 'hafs'), include_blank: false, class: 'form-select w-[85vw] sm:w-[200px]' %>
          <p class="text-sm text-gray-600 mt-1">Riwayah (ayah keys and overrides)</p>
        </div>

        <%= render 'shared/filters' %>

        <div class="mb-4 me-2">
          <%= text_field_tag :query, params[:query], class: 'form-control w-[85vw] sm:w-[200px] border-gray-400 rounded-[5px] h-[38px]', placeholder: 'Search' %>
          <p class="text-sm text-gray-600 mt-1">Search tafsir content</p>
        </div>

        <div class="mb-4">
          <%= submit_tag 'Filter', class: 'btn btn-success', data: { disable_with: 'Please wait..' } %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="page-section mt-4">
    <h2 class="text-2xl mb-4">Tafsir</h2>
    <div class="tools-table-overflow">
    <table class="w-full hover:bg-gray-50">
      <thead class="sticky top-0 z-10 bg-white border-b-2 border-black">
      <tr>
        <th><%= sort_order_link 'Id', :id, @presenter.link_params %></th>
        <th>Resource</th>
        <th>Ayah Group</th>
        <% if @presenter.riwayah %><th><%= @presenter.riwayah.name %> ayahs</th><% end %>
        <th><%= sort_order_link 'From ayah', :group_verse_key_from, @presenter.link_params %></th>
        <th><%= sort_order_link 'To ayah', :group_verse_key_to, @presenter.link_params %></th>
        <th><%= sort_order_link 'Group ayah count', :group_verses_count, @presenter.link_params %></th>
        <th>Actions</th>
      </tr>

      </thead>
      <tbody>
      <% riwayah_keys = @presenter.riwayah ? @presenter.ayah_keys_for(Verse.where(id: @ayah_tafisrs.flat_map { |t| [t.start_verse_id, t.end_verse_id] }.compact.uniq)) : {} %>
      <% @ayah_tafisrs.each do |tafisr| %>
        <tr class="hover:bg-gray-200 border-b">
          <td scope="row" class="py-2 pl-2"><%= tafisr.id %></td>
          <td class="py-2">
            <%= tafisr.resource_name %>
          </td>
          <td class="py-2">
            <%= tafisr.verse_key %>
          </td>
          <% if @presenter.riwayah %>
            <td class="py-2"><%= [riwayah_keys[tafisr.start_verse_id]&.first, riwayah_keys[tafisr.end_verse_id]&.last].compact.uniq.join(' – ') %></td>
          <% end %>
          <td class="py-2">
            <%= tafisr.group_verse_key_from %>
          </td>
          <td class="py-2">
            <%= tafisr.group_verse_key_to %>
          </td>
          <td class="py-2">
            <%= tafisr.group_verses_count %>
          </td>
          <td class="py-2">
            <div class="flex gap-1">
              <%= link_to 'Edit', edit_tafsir_proofreading_path(tafisr.id, @presenter.link_params(verse_id: tafisr.group_tafsir_id)), class: 'btn btn-info' %>
              <%= link_to 'Show', tafsir_proofreading_path(tafisr.id, @presenter.link_params(verse_id: tafisr.group_tafsir_id)), class: 'btn btn-success' %>
            </div>
          </td>
        </tr>
      <% end %>
      <tr>
        <td colspan="7">
          <%= pagination_section @pagy %>
        </td>
      </tr>
      </tbody>
    </table>
    </div>
  </div>
</div>
