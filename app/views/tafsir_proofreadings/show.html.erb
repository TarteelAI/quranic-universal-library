<%
  surah, group_start_ayah = @tafisr.group_verse_key_from.split(':').map(&:to_i)
  _, group_end_ayah = @tafisr.group_verse_key_to.split(':').map(&:to_i)

  actions = []
  more_action = []
  verse = if params[:verse_key].present?
            Verse.find_by(verse_key: params[:verse_key].downcase)
          end
  verse ||= Verse.find_by(verse_key: "#{surah}:#{group_start_ayah}")
  # Move by tafsir, not by ayah: the ayah right before or after this tafsir's range
  previous_ayah = Verse.find_by(id: @tafisr.start_verse_id - 1)
  next_ayah = Verse.find_by(id: @tafisr.end_verse_id + 1)

  view_type = params[:view_type].presence || 'ayah'
  if !tafisr_view_types.include?(view_type)
    view_type = 'ayah'
  end
  more_action << link_to('Tafsir view', tafsir_proofreading_path(@tafisr.id, resource_id: @resource.id), class: 'block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100')
  more_action << link_to('Tafsir with arabic view', tafsir_proofreading_path(@tafisr.id, resource_id: @resource.id, view_type: 'page_with_arabic'), class: 'block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100')
  more_action << link_to('Proofreading view(With pdf)', tafsir_proofreading_path(@tafisr.id, resource_id: @resource.id, view_type: 'page_with_pdf'), class: 'block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100')

  actions << link_to('Edit', edit_tafsir_proofreading_path(@tafisr.id, resource_id: @resource.id), class: 'btn btn-success')

  actions << %Q{
    <div class='relative' data-controller='dropdown'>
      <button class='btn btn-success gap-2' type='button' data-action='click->dropdown#toggle' aria-expanded='false'>
        Change view
        <svg class='w-4 h-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
          <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M19 9l-7 7-7-7'></path>
        </svg>
      </button>
      <ul class='absolute right-0 mt-2 w-56 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 z-50 hidden' data-dropdown-target='menu'>
        #{more_action.map { |action| "<li>#{action}</li>" }.join('')}
      </ul>
    </div>
  }

  if previous_ayah
    actions << link_to('Previous tafsir', tafsir_proofreading_path(@tafisr.id, resource_id: @resource.id, draft: params[:draft], verse_key: previous_ayah.verse_key), class: 'btn btn-dark', title: "Tafsir of ayah #{previous_ayah.verse_key}")
  end

  if next_ayah
    actions << link_to('Next tafsir', tafsir_proofreading_path(@tafisr.id, resource_id: @resource.id, draft: params[:draft], verse_key: next_ayah.verse_key), class: 'btn btn-dark', title: "Tafsir of ayah #{next_ayah.verse_key}")
  end

%>

<%= render 'tools/header',
           name: "Ayah tafsir",
           title: "#{@resource.name} <div style='font-size: 0.5em'>Tafsir of #{@tafisr.ayah_range_label}</div>",
           key: 'ayah_tafsir',
           actions: actions,
           breadcrumb_parents: [{ label: 'Filter', path: tafsir_proofreadings_path(resource_id: @resource.id) }]
%>

<div class="page-wrapper container max-w-7xl mx-auto px-4">
  <div class="page-section">
    <%= render "#{view_type}_view", verse: verse %>
  </div>
</div>