<%= render 'tools/header',
           name: "Tajweed",
           title: "Tajweed rules tool",
           key: 'tajweed'
%>

<div class="page-wrapper container max-w-7xl mx-auto px-4">
  <div class="page-section filters">
    <%= form_tag tajweed_words_path, method: :get do %>
      <div class="flex flex-wrap items-start" data-controller="chapter-verses-filter">
        <%= render 'shared/filters', page: true %>
      </div>

      <div class="flex flex-wrap items-start">
        <div class="mb-4 me-2">
          <%= select_tag :filter_tajweed_rule_new, options_for_select(tajweed_rule_options_for_select(TajweedRules.new('new'), display: 'name'), params[:filter_tajweed_rule_new]), include_blank: true, class: 'form-select w-full sm:w-64', data: { placeholder: 'Any rule', controller: 'select2' } %>
          <p class="text-xs text-slate-500 mt-1">Filter by tajweed rule</p>
        </div>

        <div class="mb-4 me-2">
          <%= text_field_tag :filter_text, params[:filter_text], class: 'form-control w-full sm:w-44 h-[38px]' %>
          <p class="text-xs text-slate-500 mt-1">Filter by text</p>
        </div>

        <div class="mb-4 me-2">
          <%= text_field_tag :filter_regexp_start, params[:filter_regexp_start], class: 'form-control w-full sm:w-32 h-[38px]' %>
          <p class="text-xs text-slate-500 mt-1">Starts with</p>
        </div>

        <div class="mb-4 me-2">
          <%= text_field_tag :filter_regexp_end, params[:filter_regexp_end], class: 'form-control w-full sm:w-32 h-[38px]' %>
          <p class="text-xs text-slate-500 mt-1">Ends with</p>
        </div>

        <div class="mb-4 me-2 flex items-center gap-2 h-[38px]">
          <%= check_box_tag :filter_word_boundary, '1', params[:filter_word_boundary] == '1' %>
          <%= label_tag :filter_word_boundary, 'Whole word' %>
        </div>

        <div class="mb-4 ms-auto flex items-center gap-3 h-[38px]">
          <%= link_to 'Clear', tajweed_words_path, class: 'text-gray-900 hover:text-gray-700 hover:underline' if has_filters?(:filter_page, :filter_chapter, :verse_number, :filter_text, :filter_tajweed_rule_new, :filter_regexp_start, :filter_regexp_end, :filter_word_boundary) %>
          <%= submit_tag 'Filter', class: 'btn btn-success', data: { disable_with: 'Please wait..' } %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="page-section mt-4">
    <h2 class="text-2xl mb-4">Words</h2>
    <div class="tools-table-overflow">
    <table class="w-full hover:bg-gray-50">
      <thead class="sticky top-0 z-10 bg-white border-b-2 border-black">
      <tr class="[&>th]:px-2 [&>th]:py-2 [&>th]:whitespace-nowrap">
        <th class="text-left"><%= sort_order_link 'Word index', :word_index %></th>
        <th class="text-left">Location</th>
        <th class="text-center">QPC Hafs</th>
        <th class="text-center">Digital Khatt</th>
        <th class="text-center">Tajweed (old)</th>
        <th class="text-center">Tajweed (new)</th>
        <th class="text-center">V4 tajweed</th>
        <th class="text-center">RQ tajweed</th>
        <th class="text-right">Actions</th>
      </tr>
      </thead>

      <tbody>
      <% @words.each do |word| %>
        <tr class="hover:bg-gray-200 border-b [&>td]:px-2 [&>td]:py-2 [&>td]:align-middle">
          <td class="text-left">
            <%= link_to word.word_index, tajweed_word_path(word.location) %>
          </td>

          <td class="text-left">
            <%= word.location %>
          </td>

          <td class="text-center qpc-hafs">
            <%= word.text_qpc_hafs %>
          </td>

          <td class="text-center digitalkhatt">
            <%= word.text_digital_khatt %>
          </td>

          <td class="text-center qpc-hafs" data-controller="tajweed-highlight">
            <%= safe_html word.text_uthmani_tajweed %>
          </td>

          <td class="text-center qpc-hafs tajweed-new" data-controller="tajweed-highlight">
            <%= safe_html word.text_qpc_hafs_tajweed %>
          </td>

          <td class="text-center">
            <%= image_tag word.tajweed_v4_image_url, class: 'inline-block', style: 'max-height: 70px' %>
          </td>

          <td class="text-center">
            <% s, a, w = word.location.split(':') %>
            <%= link_to "https://recitequran.com/#{s}:#{a}/w#{w}", target: '_blank' do %>
              <%= image_tag word.rq_tajweed_image_url, class: 'inline-block', style: 'max-height: 70px' %>
            <% end %>
          </td>

          <td class="text-right">
            <%= link_to 'Show', tajweed_word_path(word.location), class: 'btn btn-success' %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
    </div>

    <%= pagination_section @pagy %>
  </div>
</div>
