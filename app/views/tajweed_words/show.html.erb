<%
  #TODO: use presenter, we're initialization lot of variables in the views.
  tajweed = TajweedRules.new('new')
  actions = [
    button_tag('Tajweed palette', type: 'button', class: 'btn btn-outline h-10', data: { controller: 'offcanvas', action: 'click->offcanvas#toggle', offcanvas_target_value: '#tajweed-rules-sidebar' }, aria: { controls: 'tajweed-rules-sidebar' }),
    button_tag('Tajweed page', type: 'button', class: 'btn btn-outline h-10', data: { controller: 'offcanvas', action: 'click->offcanvas#toggle', offcanvas_target_value: '#tajweed-page-sidebar' }, aria: { controls: 'tajweed-page-sidebar' })
  ]
  next_word = @presenter.word.next_word
  previous_word = @presenter.word.previous_word

  if previous_word
    actions << link_to('Previous word', tajweed_word_path(previous_word.location), class: 'btn btn-dark')
  end

  if next_word
    actions << link_to('Next word', tajweed_word_path(next_word.location), class: 'btn btn-dark')
  end

  rule_options = tajweed_rule_options_for_select(tajweed)
%>

<%= render 'tools/header',
           name: "Tajweed tool",
           title: "Tajweed rules preview for #{@presenter.word.location}",
           key: 'tajweed',
           actions: actions,
           breadcrumb_parents: [{ label: 'Filter', path: tajweed_words_path }]
%>

<%= render 'shared/page_font', verses: [@presenter.word.verse] %>

<div class="page-wrapper container max-w-7xl mx-auto px-4" data-controller="tajweed-annotator">
  <div class="page-section">
    <%= render 'word_preview' %>
  </div>

  <div class="page-section mt-4">
    <div class="sticky top-[5px] z-40 mb-4 flex items-center justify-between gap-4 rounded-lg border border-gray-200 bg-white px-4 py-3 shadow-sm">
      <div>
        <h2 class="text-lg font-semibold">Rules preview</h2>
        <p class="text-xs text-gray-500">The word with its current rules, updates as you save.</p>
      </div>

      <div class="preview-<%= @presenter.tajweed_word.location.gsub(':', '-') %>">
        <div class="qpc-hafs tajweed-new" style="font-size: 40px"
             data-controller="tajweed-highlight">
          <%= safe_html @presenter.tajweed_word.text %>
        </div>
      </div>
    </div>

    <table class="w-full hover:bg-gray-50">
      <thead class="sticky top-0 z-10 bg-white border-b-2 border-black">
      <tr>
        <th class="text-left px-2">Index</th>
        <th class="text-left px-2">Letter</th>
        <th class="text-left px-2">Rule</th>
        <th class="text-left px-2">Select rule</th>
      </tr>
      </thead>

      <tbody>
      <% @presenter.tajweed_word.letters.each do |letter| %>
        <%= render 'letter_row', letter: letter, rule_options: rule_options, tajweed: tajweed %>
      <% end %>
      </tbody>
    </table>
  </div>

  <%= render 'ayah_preview' %>
</div>

<%= render 'sidebar', tajweed: tajweed %>
