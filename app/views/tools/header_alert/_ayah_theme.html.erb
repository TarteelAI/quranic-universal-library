<div class="px-4 py-3 rounded mb-4 bg-gray-100 border border-gray-400 text-gray-700 flex relative" role="alert" data-controller="alert">
  <i class="fa fa-info-circle me-2 fa-2x"></i>
  <div>
    <p>
      <strong>
        Welcome to the Ayah Themes Tool!
      </strong>
    </p>

    <p>
      Found a theme that doesn't match its ayahs, or a range that starts or ends on the wrong ayah? Click Suggest a fix on the theme. Your suggestion is saved as a draft, and the theme is updated once a reviewer approves it.
    </p>

    <% unless user_signed_in? %>
      <p>
        <%= link_to 'Sign in to suggest a fix', new_user_session_path, class: 'btn btn-dark' %>
      </p>
    <% end %>
  </div>
</div>
