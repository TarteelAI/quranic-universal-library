<div class="px-4 py-3 rounded mb-4 bg-gray-100 border border-gray-400 text-gray-700 flex relative" role="alert" data-controller="alert">
  <i class="fa fa-info-circle me-2 fa-2x"></i>
  <div>
    <p>
      <strong>
        Welcome to the Ayah Transliteration Tool!
      </strong>
    </p>

    <p>
      The Ayah Transliteration Tool allows users to review and suggest improvements to the existing transliterations.
    </p>

    <p>
      If you'd like to contribute to improving the <%= @resource.name %>, simply click the link below to send a request to the admin. Once approved, you'll be able to start suggesting the fixes to this transliteration.
    </p>

    <p id="btn-request-permission">
      <%= link_to 'Request Access', '_', class: 'btn btn-dark',  data: { controller: 'ajax-modal', url: new_user_project_path(resource_id: @resource.id, modal: true), css_class: 'modal-lg'} %>
    </p>
  </div>
</div>
