<%# What a topic suggestion changes, for the pending suggestions list %>
<ul class="space-y-1">
  <% draft.changed_fields.each do |field| %>
    <li>
      <span class="text-gray-500"><%= field.humanize %>:</span>
      <del class="text-red-700"><%= strip_tags(draft["current_#{field}"].to_s).truncate(120).presence || 'empty' %></del>
      &rarr;
      <ins class="text-green-700 no-underline"><%= strip_tags(draft["draft_#{field}"].to_s).truncate(120).presence || 'empty' %></ins>
    </li>
  <% end %>
  <% if draft.added_verse_ids.any? %>
    <li><span class="text-gray-500">Adds ayahs:</span> <%= draft.added_verses.pluck(:verse_key).join(', ') %></li>
  <% end %>
  <% if draft.removed_verse_ids.any? %>
    <li><span class="text-gray-500">Removes ayahs:</span> <%= draft.removed_verses.pluck(:verse_key).join(', ') %></li>
  <% end %>
</ul>
