<%= render 'tools/header',
           name: 'Ayah topics',
           title: @presenter.page_title,
           key: 'topic'
%>

<div class="page-wrapper container max-w-7xl mx-auto px-4">
  <div class="page-section filters">
    <%= form_tag topics_path, method: :get do %>
      <div class="flex flex-wrap">
        <div class="mb-4 me-2">
          <%= select_tag :resource_id, options_from_collection_for_select(@presenter.resources, :id, :name, selected: @presenter.resource&.id), include_blank: 'All topics', class: 'form-select w-[85vw] sm:w-[220px]', data: { placeholder: 'Select topics', controller: 'select2' } %>
          <p class="text-sm text-gray-600 mt-1">Select the topics</p>
        </div>

        <div class="mb-4 me-2">
          <%= text_field_tag :verse_key, params[:verse_key], class: 'form-control w-[85vw] sm:w-[140px] border-gray-400 rounded-[5px] h-[38px]', placeholder: '2:255' %>
          <p class="text-sm text-gray-600 mt-1">Topics of an ayah</p>
        </div>

        <div class="mb-4 me-2">
          <%= text_field_tag :query, params[:query], class: 'form-control w-[85vw] sm:w-[200px] border-gray-400 rounded-[5px] h-[38px]', placeholder: 'Search' %>
          <p class="text-sm text-gray-600 mt-1">Search topic names</p>
        </div>

        <div class="mb-4">
          <%= submit_tag 'Filter', class: 'btn btn-success', data: { disable_with: 'Please wait..' } %>
        </div>
      </div>
    <% end %>
  </div>

  <% topics = @presenter.topics %>
  <% counts = @presenter.ayah_counts(topics) %>
  <%= turbo_frame_tag 'topic-list', data: { turbo_action: 'advance' }, class: 'block page-section mt-4' do %>
    <h2><%= @presenter.resource&.name || 'All topics' %></h2>
    <div class="tools-table-overflow">
      <table class="w-full hover:bg-gray-50">
        <thead class="sticky top-0 z-10 bg-white border-b-2 border-black">
        <tr>
          <th class="text-left">Topic</th>
          <th class="text-left">Ayahs</th>
          <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        <% topics.each do |topic| %>
          <tr class="hover:bg-gray-200 border-b">
            <td class="py-2 pl-2">
              <%= topic.name %>
              <% if topic.arabic_name.present? %>
                <span class="ms-2 text-gray-600" dir="rtl"><%= topic.arabic_name %></span>
              <% end %>
            </td>
            <td class="py-2"><%= counts[topic.id].to_i %></td>
            <td class="py-2">
              <div class="flex gap-1 justify-center">
                <%= link_to 'Suggest a fix', edit_topic_path(topic.id), class: 'btn btn-info', data: { turbo_frame: '_top' } %>
                <%= link_to 'Show', topic_path(topic.id), class: 'btn btn-success', data: { turbo_frame: '_top' } %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if topics.empty? %>
          <tr>
            <td colspan="3" class="py-6 text-center text-gray-600">No topics found.</td>
          </tr>
        <% end %>
        <tr>
          <td colspan="3">
            <%= pagination_section @presenter.pagination %>
          </td>
        </tr>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
