<div class="rounded-lg border border-gray-200 bg-gray-50 p-3" data-key="<%= key %>">
  <div class="flex items-center justify-between mb-1">
    <label for="suggestion_footnotes_<%= key %>_text" class="text-sm font-medium text-gray-700">
      Footnote <code>{{<%= key %>}}</code>
      <% unless foot_note_id %><span class="ms-1 rounded bg-blue-100 px-1.5 py-0.5 text-xs text-blue-700">new</span><% end %>
    </label>
    <button type="button" class="text-sm text-red-600 hover:underline" data-action="translation-footnotes#remove">Remove</button>
  </div>
  <%= hidden_field_tag "suggestion[footnotes][#{key}][foot_note_id]", foot_note_id, id: nil %>
  <%= text_area_tag "suggestion[footnotes][#{key}][text]", text, id: "suggestion_footnotes_#{key}_text", rows: 2, dir: dir, class: "#{input_css} #{lang}" %>
  <p class="hidden text-xs text-amber-700 mt-1" data-unused>
    <code>{{<%= key %>}}</code> isn't in the translation. Put it back where the footnote belongs, or this footnote is removed.
  </p>
</div>
