<%
  translation = @presenter.translation
  suggestion = @presenter.suggestion
  verse = translation.verse
  lang = @resource.language_name.to_s.downcase
  dir = @resource.language&.direction
  input_css = 'w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500'
%>

<%= render 'tools/header',
           name: "Ayah translation",
           title: "Update #{@resource.name} translation of #{verse.human_label}",
           key: 'ayah_translation'
%>

<%= render 'shared/access_message' %>

<div class="page-wrapper container max-w-7xl mx-auto px-4">
  <div class="page-section">
    <%= form_with scope: :suggestion, url: translation_proofreading_path(verse.id, resource_id: @resource.id), method: :patch,
                  html: { autocomplete: 'off', data: { controller: 'translation-footnotes' } } do |form| %>
      <%= hidden_field_tag :resource_id, @resource.id %>

      <% if suggestion.errors.any? %>
        <div class="mb-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">
          <ul class="space-y-1">
            <% suggestion.errors.each do |message| %>
              <li><i class="fa fa-exclamation-triangle"></i> <%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="qpc-hafs text-2xl leading-loose mb-4"><%= verse.text_qpc_hafs %></div>

      <div class="mb-6">
        <%= form.label :text, "Translation of #{verse.verse_key}", class: 'block text-sm font-medium text-gray-700 mb-1' %>
        <%= form.text_area :text, value: suggestion.text, rows: 5, dir: dir, autofocus: true,
                           class: "#{input_css} #{lang}",
                           data: { translation_footnotes_target: 'text', action: 'input->translation-footnotes#refresh click->translation-footnotes#track keyup->translation-footnotes#track' } %>
        <p class="text-xs text-gray-500 mt-1">
          Footnotes are written as <code>{{1}}</code>, <code>{{2}}</code>. The number only links the text to its footnote below, readers see footnotes numbered in order.
        </p>
      </div>

      <div class="mb-6">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-base font-semibold text-gray-800">Footnotes</h3>
          <button type="button" class="px-3 py-1.5 text-sm font-medium rounded-lg border border-slate-300 bg-white hover:bg-gray-50" data-action="translation-footnotes#add">
            <i class="fa fa-plus"></i> Add footnote
          </button>
        </div>
        <p class="text-xs text-gray-500 mb-2" data-translation-footnotes-target="empty">
          This ayah has no footnotes. <code>Add footnote</code> puts <code>{{1}}</code> where your cursor is in the translation.
        </p>

        <div class="space-y-3" data-translation-footnotes-target="list">
          <% suggestion.footnotes.each do |note| %>
            <%= render 'footnote_field', key: note.key, foot_note_id: note.foot_note_id, text: note.text, lang: lang, dir: dir, input_css: input_css %>
          <% end %>
        </div>

        <template data-translation-footnotes-target="template">
          <%= render 'footnote_field', key: 'KEY', foot_note_id: nil, text: '', lang: lang, dir: dir, input_css: input_css %>
        </template>
      </div>

      <div class="mb-6">
        <%= form.label :comment, 'Comment for the reviewer (optional)', class: 'block text-sm font-medium text-gray-700 mb-1' %>
        <%= form.text_area :comment, value: suggestion.comment, rows: 3, class: input_css,
                           placeholder: 'What was wrong and how you fixed it. For example: the second sentence belongs to 56:26, moved it there.' %>
      </div>

      <div class="flex justify-end gap-2">
        <%= link_to 'Cancel', translation_proofreading_path(verse.id, resource_id: @resource.id), class: 'px-4 py-2 text-sm font-medium bg-gray-200 hover:bg-gray-300 text-gray-800 rounded transition-colors no-underline' %>
        <%= form.submit 'Propose changes', class: 'btn btn-success btn-sm', data: { disable_with: 'Please wait...' } %>
      </div>
    <% end %>
  </div>
</div>
