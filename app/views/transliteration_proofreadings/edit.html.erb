<%= render 'tools/header',
           name: "Ayah transliteration",
           title: @presenter.page_title,
           key: 'ayah_transliteration'
%>

<% lang = @resource.language_name.to_s.downcase %>

<%= render 'shared/access_message' %>

<div class="page-wrapper container max-w-7xl mx-auto px-4">
  <div class="page-section">
    <div class="qpc-hafs my-3">
      <%= @presenter.verse.text_qpc_hafs %>
    </div>

    <%= form_with model: @presenter.draft, url: transliteration_proofreading_path(@presenter.verse.id, resource_id: @resource.id), method: :put, html: { autocomplete: 'off' } do |form| %>
      <%= hidden_field_tag :resource_id, @resource.id %>

      <% if @presenter.transliteration.errors.any? %>
        <div class="mb-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">
          <ul class="space-y-1">
            <% @presenter.transliteration.errors.full_messages.each do |message| %>
              <li><i class="fa fa-exclamation-triangle"></i> <%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= form.label :draft_text, 'Transliteration', class: 'block text-sm font-medium text-gray-700 mb-1' %>
        <%= form.text_area :draft_text, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 #{lang}", autofocus: true, rows: 6 %>
        <p class="text-xs text-gray-500 mt-1">
          Allowed tags: <%= safe_join(Transliteration::ALLOWED_TAGS.map { |tag| content_tag(:code, "<#{tag}>") }, ', ') %>, without attributes. Keep the existing ones, they mark tajweed and letter details.
        </p>
      </div>

      <%= render 'shared/draft_comment_field', form: form, value: @presenter.draft.comment %>

      <div class="flex justify-end gap-2 mt-5">
        <%= link_to 'Cancel', transliteration_proofreading_path(@presenter.verse.id, resource_id: @resource.id), class: 'px-4 py-2 text-sm font-medium bg-gray-200 hover:bg-gray-300 text-gray-800 rounded transition-colors no-underline' %>
        <%= form.submit 'Propose changes', class: 'btn btn-success btn-sm', data: { disable_with: 'Please wait...' } %>
      </div>
    <% end %>
  </div>
</div>
