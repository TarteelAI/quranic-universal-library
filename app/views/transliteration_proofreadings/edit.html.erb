<%= render 'tools/header',
           name: "Ayah transliteration",
           title: @presenter.page_title,
           key: 'ayah_transliteration'
%>

<% lang = @resource.language_name.to_s.downcase %>

<%= render 'shared/access_message' %>

<div class="page-wrapper container max-w-7xl mx-auto px-4">
  <div class="page-section">
    <div class="qpc-hafs my-3">
      <%= @presenter.verse.text_qpc_hafs %>
    </div>

    <%= form_with model: @presenter.draft, url: transliteration_proofreading_path(@presenter.verse.id, resource_id: @resource.id), method: :put, html: { role: 'form', class: 'form', autocomplete: 'off', data: { controller: 'remote-form' } } do |form| %>
      <%= hidden_field_tag :resource_id, @resource.id %>

      <div class="form-floating mb-3">
        <%= form.text_area :draft_text, class: "w-full #{lang}", autofocus: true, required: true, rows: 6 %>
        <%= form.label :draft_text, 'Transliteration', required: true %>

        <div class="invalid-feedback">
          Transliteration can't be blank.
        </div>
      </div>

      <div class="text-center mt-5">
        <%= link_to 'Cancel', transliteration_proofreading_path(@presenter.verse.id, resource_id: @resource.id), class: 'px-4 py-2 text-sm font-medium bg-gray-200 hover:bg-gray-300 text-gray-800 rounded transition-colors' %>
        <%= form.submit 'Propose changes', class: 'btn btn-success btn-sm', data: { disable_with: 'Please wait...' } %>
      </div>
    <% end %>
  </div>
</div>
