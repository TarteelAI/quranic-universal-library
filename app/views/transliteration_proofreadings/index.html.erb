<%= render 'tools/header',
           name: "Ayah transliteration",
           title: @presenter.page_title,
           key: 'ayah_transliteration'
%>

<div class="page-wrapper container max-w-7xl mx-auto px-4">
  <div class="page-section filters">
    <%= form_tag transliteration_proofreadings_path, method: :get do %>
      <div data-controller="chapter-verses-filter" class="flex flex-wrap">
        <div class="mb-4 me-2">
          <%= select_tag :resource_id, options_from_collection_for_select(@presenter.ayah_transliterations, :id, :humanize, selected: @resource.id), include_blank: false, class: 'form-select w-[85vw] sm:w-[200px]', data: { placeholder: 'Select transliteration', controller: 'select2' } %>
          <p class="text-sm text-gray-600 mt-1">Select the transliteration</p>
        </div>

        <%= render 'shared/filters' %>

        <div class="mb-4 me-2 flex items-center gap-2 h-[38px]">
          <%= check_box_tag :filter_missing, 'true', params[:filter_missing] == 'true' %>
          <%= label_tag :filter_missing, 'Only missing ayahs' %>
        </div>

        <div class="mb-4 me-2">
          <%= text_field_tag :query, params[:query], class: 'form-control w-[85vw] sm:w-[200px] border-gray-400 rounded-[5px] h-[38px]', placeholder: 'Search' %>
          <p class="text-sm text-gray-600 mt-1">Search transliteration content</p>
        </div>

        <div class="mb-4">
          <%= submit_tag 'Filter', class: 'btn btn-success', data: { disable_with: 'Please wait..' } %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="page-section mt-4">
    <h2><%= @resource.name %></h2>
    <div class="tools-table-overflow">
    <table class="w-full hover:bg-gray-50">
      <thead class="sticky top-0 z-10 bg-white border-b-2 border-black">
      <tr>
        <th><%= sort_order_link 'Ayah key', :verse_key, resource_id: @resource.id %></th>
        <th>Text</th>
        <th>Actions</th>
      </tr>
      </thead>
      <tbody>
      <% @presenter.verses.each do |verse| %>
        <% missing = verse.transliteration_text.blank? %>
        <tr class="hover:bg-gray-200 border-b <%= 'bg-red-50' if missing %>">
          <td scope="row" class="py-2 pl-2"><%= verse.verse_key %></td>
          <td class="py-2 <%= @resource.language_name %>" dir="<%= @resource.language&.direction %>">
            <% if missing %>
              <span class="text-red-600 text-sm font-medium">Missing transliteration</span>
            <% else %>
              <%= safe_html verse.transliteration_text %>
            <% end %>
          </td>
          <td class="py-2">
            <div class="flex gap-1">
              <% if @access %>
                <%= link_to(missing ? 'Add' : 'Edit', edit_transliteration_proofreading_path(verse.id, resource_id: @resource.id), class: 'btn btn-info') %>
              <% end %>
              <%= link_to 'Show', transliteration_proofreading_path(verse.id, resource_id: @resource.id), class: 'btn btn-success' %>
            </div>
          </td>
        </tr>
      <% end %>
      <tr>
        <td colspan="3">
          <%= pagination_section @presenter.pagination %>
        </td>
      </tr>
      </tbody>
    </table>
    </div>
  </div>
</div>
