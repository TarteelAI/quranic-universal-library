<div>
  <%= form.label :case_reason, label, class: 'block text-sm font-medium text-gray-700 mb-1' %>
  <%= form.text_field :case_reason, value: word.case_reason, dir: 'rtl', list: 'case-reasons',
                      class: 'w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500',
                      placeholder: 'فاعل، مفعول به، مضاف إليه…' %>
  <datalist id="case-reasons">
    <% @presenter.case_reason_options.each do |reason| %>
      <option value="<%= reason %>"></option>
    <% end %>
  </datalist>
  <p class="text-xs text-gray-500 mt-1">Why the word has its case (إعراب), shared by all its segments. Pick a common one or type your own.</p>
</div>
