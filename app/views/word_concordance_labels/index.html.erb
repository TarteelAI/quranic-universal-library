<%= render 'tools/header',
           name: "Quran corpus tool",
           title: "Quran corpus: word morphology and grammar",
           key: 'corpus'
%>

<div class="page-wrapper container max-w-7xl mx-auto px-4">
  <div class="page-section filters">
    <%= form_tag word_concordance_labels_path, method: :get do %>
      <div data-controller="chapter-verses-filter" class="flex flex-wrap">
        <%= render 'shared/filters', juz: true %>

        <div class="mb-4">
          <%= submit_tag 'Filter', class: 'btn btn-success', data: { disable_with: 'Please wait..' } %>
          <%= link_to 'Clear', word_concordance_labels_path, class: 'text-gray-900 hover:text-gray-700 hover:underline' if has_filters?(:filter_verse, :filter_chapter, :filter_juz) %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="page-section mt-4">
    <h2 class="text-lg font-semibold text-gray-900 mb-3">Ayahs</h2>
    <div class="overflow-x-auto rounded-lg border border-gray-200">
      <table class="w-full text-sm">
        <thead class="sticky top-0 z-10 bg-gray-50 border-b border-gray-200 text-left text-xs uppercase tracking-wide text-gray-500">
        <tr>
          <th class="px-4 py-3 font-medium"><%= sort_order_link 'Ayah #', :id %></th>
          <th class="px-4 py-3 font-medium">Key</th>
          <th class="px-4 py-3 font-medium text-right">Text</th>
          <th class="px-4 py-3 font-medium text-right">Actions</th>
        </tr>
        </thead>

        <tbody class="divide-y divide-gray-100">
        <% @verses.each do |verse| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 text-gray-500"><%= verse.id %></td>
            <td class="px-4 py-3"><%= link_to verse.verse_key, word_concordance_label_path(verse.id) %></td>
            <td class="px-4 py-3 text-right">
              <span class="text-qpc-hafs text-2xl leading-loose" dir="rtl"><%= verse.text_qpc_hafs %></span>
            </td>
            <td class="px-4 py-3 text-right">
              <%= link_to 'Show', word_concordance_label_path(verse.id), class: 'btn btn-success btn-sm' %>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-4">
      <%= pagination_section @pagy %>
    </div>
  </div>
</div>
