<%
  segments = @word.word_segments
  words_count = @verse.morphology_words.count
  actions = []
  if @word.position > 1
    actions << link_to('Previous word', word_detail_word_concordance_label_path(@verse.id, word: "#{@verse.verse_key}:#{@word.position - 1}"), class: 'btn btn-dark')
  end
  if @word.position < words_count
    actions << link_to('Next word', word_detail_word_concordance_label_path(@verse.id, word: "#{@verse.verse_key}:#{@word.position + 1}"), class: 'btn btn-dark')
  end

  label_css = 'block text-sm font-medium text-gray-700 mb-1'
  input_css = 'w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500'
  arabic = ->(text) { text.present? ? content_tag(:span, text, class: 'text-qpc-hafs text-xl', dir: 'rtl') : nil }
  word_case = @word.segment_case
  case_label = word_case && Morphology::SegmentTags::FEATURES[:case][:options][word_case]

  stats = [
    ['Root', @word.word.root&.value, @word.words_count_for_root],
    ['Lemma', @word.word.lemma&.text_clean, @word.words_count_for_lemma],
    ['Stem', @word.word.stem&.text_clean, @word.words_count_for_stem]
  ]

  details = [
    ['Case', case_label],
    ['Case reason', @word.case_reason && content_tag(:span, @word.case_reason, dir: 'rtl')],
    ['Grammar pattern', arabic.call(@word.grammar_pattern&.arabic)],
    ['Base pattern', arabic.call(@word.grammar_base_pattern&.arabic)],
    ['Grammar concepts', @word.grammar_concepts.map { |concept| content_tag(:span, concept.arabic, dir: 'rtl') }.join('<br>').html_safe.presence],
    ['Description', @word.description && safe_html(@word.description)]
  ]
%>

<%= render 'tools/header',
           name: "Quran corpus tool",
           title: "Word #{@word.location}",
           key: 'corpus',
           actions: actions,
           breadcrumb_parents: [{ label: 'Ayah', path: word_concordance_label_path(@verse.id) }]
%>

<%= render 'shared/access_message' %>

<div class="page-wrapper container max-w-7xl mx-auto px-4">
  <div class="page-section">
    <div class="flex flex-wrap items-center justify-between gap-4 rounded-lg border border-gray-200 bg-gray-50 px-5 py-4 mb-6">
      <div class="flex flex-wrap gap-2">
        <% stats.each do |label, value, count| %>
          <div class="rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-sm">
            <span class="text-gray-500"><%= label %></span>
            <% if value.present? %>
              <span class="text-qpc-hafs text-xl mx-1" dir="rtl"><%= value %></span>
              <span class="text-gray-500" title="Words sharing it"><%= count %> words</span>
            <% else %>
              <span class="text-gray-400 ms-1">—</span>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="text-qpc-hafs text-4xl leading-loose" dir="rtl"><%= @word.text %></div>
    </div>

    <h2 class="text-lg font-semibold text-gray-900 mb-3">Segments</h2>
    <div class="overflow-x-auto rounded-lg border border-gray-200 mb-6">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-200 text-left text-xs uppercase tracking-wide text-gray-500">
        <tr>
          <th class="px-4 py-3 font-medium">#</th>
          <th class="px-4 py-3 font-medium text-right">Segment</th>
          <th class="px-4 py-3 font-medium">Part of speech</th>
          <th class="px-4 py-3 font-medium">Features</th>
          <th class="px-4 py-3 font-medium text-right">Root</th>
          <th class="px-4 py-3 font-medium text-right">Lemma</th>
          <th class="px-4 py-3 font-medium text-right">Actions</th>
        </tr>
        </thead>

        <tbody class="divide-y divide-gray-100">
        <% segments.each do |segment| %>
          <% features = segment.tags.features %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 text-gray-500"><%= segment.position %></td>
            <td class="px-4 py-3 text-right"><span class="text-qpc-hafs text-2xl leading-loose"><%= segment.text_uthmani %></span></td>
            <td class="px-4 py-3">
              <span class="font-semibold"><%= segment.part_of_speech_key %></span>
              <span class="text-gray-500"><%= segment.part_of_speech_name %></span>
            </td>
            <td class="px-4 py-3">
              <div class="flex flex-wrap gap-1">
                <% Morphology::SegmentTags::PGN.merge(Morphology::SegmentTags::FEATURES).each do |name, feature| %>
                  <% next unless features[name] %>
                  <span class="rounded bg-gray-100 px-1.5 py-0.5 text-xs text-gray-700" title="<%= feature[:label] %>"><%= feature[:options][features[name]].split(' · ').first %></span>
                <% end %>
                <% segment.tags.other_tags.each do |tag| %>
                  <code class="rounded bg-blue-50 px-1.5 py-0.5 text-xs text-blue-800"><%= tag %></code>
                <% end %>
              </div>
            </td>
            <td class="px-4 py-3 text-right"><%= arabic.call(segment.root_name) || content_tag(:span, '—', class: 'text-gray-400') %></td>
            <td class="px-4 py-3 text-right"><%= arabic.call(segment.lemma_name) || content_tag(:span, '—', class: 'text-gray-400') %></td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <%= link_to (@access ? 'Edit' : 'Show'), segment_detail_word_concordance_label_path(@verse.id, word: @word.location, segment: segment.position), class: 'btn btn-success btn-sm' %>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>

    <div class="grid gap-6 <%= 'lg:grid-cols-2' if @access %>">
      <div>
        <h2 class="text-lg font-semibold text-gray-900 mb-3">Word</h2>
        <dl class="rounded-lg border border-gray-200 divide-y divide-gray-100 text-sm">
          <% details.each do |label, value| %>
            <div class="grid grid-cols-3 gap-4 px-4 py-3">
              <dt class="text-gray-500"><%= label %></dt>
              <dd class="col-span-2 text-gray-900"><%= value.presence || content_tag(:span, '—', class: 'text-gray-400') %></dd>
            </div>
          <% end %>
        </dl>

        <% if @word.verb_forms.any? %>
          <h3 class="text-base font-semibold text-gray-900 mt-6 mb-3">Verb forms</h3>
          <dl class="rounded-lg border border-gray-200 divide-y divide-gray-100 text-sm">
            <% @word.verb_forms.each do |form| %>
              <div class="grid grid-cols-3 gap-4 px-4 py-2">
                <dt class="text-gray-500 capitalize"><%= form.name.to_s.humanize %></dt>
                <dd class="col-span-2"><%= arabic.call(form.value) %></dd>
              </div>
            <% end %>
          </dl>
        <% end %>
      </div>

      <% if @access %>
        <div>
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Edit word</h2>
          <%= form_with scope: :corpus_word, url: update_word_word_concordance_label_path(@verse.id, word: @word.location), method: :put,
                        html: { autocomplete: 'off', class: 'rounded-lg border border-gray-200 p-4 flex flex-col gap-4' } do |form| %>
            <%= render 'shared/form_errors', object: @word if @word.errors.any? %>

            <%= render 'case_reason_field', form: form, word: @word, label: 'Case reason' %>

            <div>
              <%= form.label :description, 'Description', class: label_css %>
              <%= form.text_area :description, value: @word.description, rows: 6, class: "#{input_css} text-sm" %>
              <p class="text-xs text-gray-500 mt-1">A sentence explaining the word's grammar. Keep the existing markup around Arabic text.</p>
            </div>

            <p class="text-xs text-gray-500">To change part of speech, case, gender and other features, edit the segment.</p>

            <div class="flex justify-end">
              <%= form.submit 'Save word', class: 'btn btn-success btn-sm', data: { disable_with: 'Please wait...' } %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
