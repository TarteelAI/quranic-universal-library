<%# Moves between the parts of the word roots tool. Pass active: (:ayahs, :roots, :stems or :lemmas) %>
<% tabs = { ayahs: ['Ayahs', word_roots_path], roots: ['Roots', arabic_roots_path], stems: ['Stems', stems_path], lemmas: ['Lemmas', lemmas_path] } %>
<div class="container max-w-7xl mx-auto px-4">
  <nav class="flex flex-wrap gap-1 border-b border-gray-200 mb-4">
    <% tabs.each do |key, (label, path)| %>
      <% current = key == active %>
      <%= link_to label, path, class: "px-4 py-2 -mb-px border-b-2 text-sm font-medium no-underline #{current ? 'border-green-600 text-green-700' : 'border-transparent text-gray-600 hover:text-gray-900 hover:border-gray-300'}", aria: { current: (current ? 'page' : nil) } %>
    <% end %>
  </nav>
</div>
