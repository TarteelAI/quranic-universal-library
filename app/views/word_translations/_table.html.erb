<%
  is_english = @presenter.english?
  language_class = @presenter.language_class
  words = @presenter.verse_words(@verse)
  translations_by_word = @presenter.translations_by_word(@verse)
  has_group_translation = @presenter.has_group_translation?(@verse)
  riwayah = @presenter.riwayah
  differences = @presenter.differences_for(@verse)
%>

<table class="w-full mt-4 border-collapse">
  <thead class="sticky top-0 z-10 bg-white border-b-2 border-black">
  <tr>
    <th class="px-3 py-2 text-left align-middle font-semibold w-16">Word#</th>
    <th class="px-3 py-2 text-left align-middle font-semibold">Text Uthmani</th>
    <% if !is_english %>
      <th class="px-3 py-2 text-left align-middle font-semibold">En translation</th>
    <% end %>

    <th class="px-3 py-2 text-left align-middle font-semibold">
      <%= current_language.name %> Translation
    </th>

    <% if has_group_translation %>
      <th class="px-3 py-2 text-left align-middle font-semibold">
        Group Translation
      </th>
    <% end %>
  </tr>
  </thead>

  <tbody>
  <% words.each do |word| %>
    <%
      translation = translations_by_word[word.id]
      missing = translation&.text.blank?
    %>

    <tr class="border-b hover:bg-gray-100 <%= 'bg-red-50' if missing %>">
      <th scope="row" class="px-3 py-2 text-left align-middle font-medium text-gray-500">
        <%= word.position %>
      </th>

      <td class="px-3 py-2 align-middle">
        <% word_text = @presenter.word_text(word) %>
        <% if riwayah && word_text.nil? %>
          <span class="text-sm text-gray-500">— not read by <%= riwayah.name %></span>
        <% else %>
          <span class="<%= @presenter.font_class %> text-2xl"><%= word_text %></span>
        <% end %>
        <% if riwayah && (difference = differences[word.id]) %>
          <div class="text-xs text-amber-800 mt-1">
            <%= link_to difference.status.humanize.downcase, cms_word_difference_path(difference), class: 'underline', target: '_blank' %>:
            <% difference.spelling_groups.each do |text, slugs| %>
              <span class="<%= @presenter.font_class %> ms-1" dir="rtl"><%= text %></span> <span class="text-amber-700">(<%= slugs.join(', ') %>)</span>
            <% end %>
          </div>
        <% end %>
      </td>

      <% if !is_english %>
        <td class="px-3 py-2 align-middle text-gray-600">
          <%= safe_html word.en_translation&.text %>
        </td>
      <% end %>

      <td class="px-3 py-2 align-middle">
        <% if missing %>
          <span class="text-red-600 text-sm font-medium">Missing translation</span>
        <% else %>
          <span class="<%= language_class %>"><%= translation&.text %></span>
          <% if riwayah %>
            <span class="text-xs text-gray-500 ms-1"><%= translation.override? ? "#{riwayah.name} override" : 'shared' %></span>
          <% end %>
        <% end %>
      </td>

      <% if has_group_translation %>
        <td class="px-3 py-2 align-middle">
          <span class="<%= language_class %>"><%= translation&.get_group_text %></span>
        </td>
      <% end %>
    </tr>
  <% end %>
  </tbody>
</table>
