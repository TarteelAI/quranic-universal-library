<div id="<%= dom_id word, :group %>">
  <label class="block text-sm font-medium text-gray-700 mb-1">Group translation</label>

  <%= text_field_tag :group_text,
                     word_translation.get_group_text,
                     class: "w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-100 text-gray-700 #{language.name.downcase}",
                     placeholder: 'Not part of a group',
                     disabled: true %>

  <div class="mt-2 flex items-center justify-between gap-2">
    <% if word_translation.has_grouped_translation? %>
      <% range = word_translation.group_words_range %>
      <small class="text-gray-600">
        Grouped <%= range.first.location %> &ndash; <%= range.last.location %>
      </small>

      <a
        type="button"
        class="btn btn-dark"
        data-controller="ajax-modal"
        data-url="<%= group_info_word_translation_path(word.id, resource_id: @resource.id, word_id: word.id) %>"
      >
        Edit group
      </a>
    <% else %>
      <small class="text-gray-500">Not part of a group</small>

      <a
        type="button"
        class="btn btn-dark"
        data-controller="ajax-modal"
        data-url="<%= group_info_word_translation_path(word.id, resource_id: @resource.id, word_id: word.id) %>"
      >
        Create group
      </a>
    <% end %>
  </div>
</div>
