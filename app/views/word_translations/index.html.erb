<%
  stats = @presenter.coverage_stats
  verses = @presenter.verses
  progress_map = @presenter.verse_progress_map(verses)
%>

<%= render 'tools/header',
           name: "Word translation proofreading",
           title: @resource.name,
           key: 'word_translation',
           breadcrumb_parents: [{ label: 'Select resource', path: select_resource_word_translations_path }]
%>

<div class="page-wrapper container max-w-7xl mx-auto px-4">
  <div class="page-section mt-4">
    <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-4">
      <div class="flex flex-wrap items-center gap-3">
        <div class="flex items-center gap-2 text-gray-700 shrink-0">
          <span class="font-semibold">Coverage</span>
          <span class="text-xl font-bold text-green-600 leading-none"><%= stats[:progress] %>%</span>
        </div>

        <div class="flex-1 min-w-[120px] bg-gray-200 rounded-full h-2.5 overflow-hidden">
          <div class="bg-green-500 h-2.5 rounded-full transition-all duration-500" style="width: <%= stats[:progress] %>%"></div>
        </div>

        <div class="flex items-stretch gap-2 text-sm">
          <div class="rounded-md border border-gray-100 bg-gray-50 px-3 py-1.5">
            <span class="text-gray-500">Total</span>
            <span class="font-bold text-gray-800 ms-1"><%= number_with_delimiter stats[:total] %></span>
          </div>

          <div class="rounded-md border border-green-100 bg-green-50 px-3 py-1.5">
            <span class="text-green-700">Translated</span>
            <span class="font-bold text-green-700 ms-1"><%= number_with_delimiter stats[:translated] %></span>
          </div>

          <%= link_to word_translations_path(resource_id: @resource.id, filter_missing: true),
                      class: 'rounded-md border border-amber-100 bg-amber-50 px-3 py-1.5 hover:border-amber-300 transition flex items-center' do %>
            <span class="text-amber-700">Missing</span>
            <span class="font-bold text-amber-700 ms-1"><%= number_with_delimiter stats[:missing] %></span>
            <span class="text-amber-600 ms-1">&rarr;</span>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="page-section filters mt-4">
    <%= form_tag word_translations_path, method: :get do %>
      <div data-controller="chapter-verses-filter" class="flex flex-wrap">
        <div class="mb-4 me-2">
          <%= select_tag :resource_id, options_from_collection_for_select(@presenter.resources, :id, :name, selected: @resource.id), include_blank: false, class: 'form-select w-[85vw] sm:w-[280px]', data: { placeholder: 'Select resource', controller: 'select2' } %>
          <p class="text-sm text-gray-600 mt-1">Select word-by-word translation resource</p>
        </div>

        <%= render 'shared/filters', juz: true %>

        <div class="mb-4">
          <%= submit_tag 'Filter', class: 'btn btn-success', data: { disable_with: 'Please wait..' } %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="page-section mt-4">
    <h2 class="text-2xl mb-4">Ayahs</h2>
    <div class="tools-table-overflow">
    <table class="w-full hover:bg-gray-50">
      <thead class="sticky top-0 z-10 bg-white border-b-2 border-black">
      <tr>
        <th><%= sort_order_link 'Ayah key', :verse_key %></th>
        <th>Progress</th>
        <th>Text</th>
        <th>Actions</th>
      </tr>
      </thead>
      <tbody>
      <% verses.each do |verse| %>
        <tr class="hover:bg-gray-200 border-b">
          <th scope="row" class="py-2 pl-2"><%= verse.verse_key %></th>

          <% progress = progress_map[verse.id] %>
          <td class="py-2">
            <div class="w-full bg-gray-200 rounded-full h-6">
              <div class="bg-green-500 h-6 rounded-full text-white text-xs flex items-center justify-center transition-all duration-300" role="progressbar" aria-valuenow="<%= progress %>" aria-valuemin="0" aria-valuemax="100" style="min-width: 1em;width: <%= progress %>%;">
                <%= progress %>%
              </div>
            </div>
          </td>

          <td class="py-2 qpc-hafs">
            <%= truncate verse.text_qpc_hafs, length: 100 %>
          </td>

          <td class="py-2">
            <div class="flex gap-1">
              <%= link_to 'Edit', new_word_translation_path(ayah: verse.id, resource_id: @resource.id), class: 'btn btn-info' %>
              <%= link_to 'Show', word_translation_path(verse.id, resource_id: @resource.id), class: 'btn btn-success' %>
            </div>
          </td>
        </tr>
      <% end %>
      <tr>
        <td colspan="4">
          <%= pagination_section @presenter.pagination %>
        </td>
      </tr>
      </tbody>
    </table>
    </div>
  </div>
</div>
