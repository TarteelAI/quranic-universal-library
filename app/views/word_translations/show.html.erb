<%
  actions = []
  next_ayah = @verse.next_ayah
  previous_ayah = @verse.previous_ayah

  if @access
    actions << link_to('Edit', new_word_translation_path(@presenter.link_params(ayah: @verse.id)), class: 'btn btn-success')
  end

  if previous_ayah
    actions << link_to('Previous ayah', word_translation_path(previous_ayah.id, @presenter.link_params), class: 'btn btn-dark')
  end

  if next_ayah
    actions << link_to('Next ayah', word_translation_path(next_ayah.id, @presenter.link_params), class: 'btn btn-dark')
  end
%>

<%= render 'tools/header',
           name: "Ayah #{@verse.verse_key}",
           title: "#{@resource.name} for #{@verse.chapter.name_simple} ayah #{@presenter.ayah_label(@verse)}",
           key: 'word_translation',
           actions: actions,
           breadcrumb_parents: [
             { label: 'Select resource', path: select_resource_word_translations_path },
             { label: @resource.name, path: word_translations_path(@presenter.link_params) }
           ]
%>

<div class="page-wrapper container max-w-7xl mx-auto px-4">
  <div class="page-section mb-4">
    <% if @riwayah %>
      <div class="bg-amber-50 border border-amber-300 text-amber-800 px-4 py-3 rounded mb-4" role="alert" id="riwayah-notice">
        Showing the glosses as <b><%= @riwayah.name %></b> reads them: its overrides where there are any, the shared gloss elsewhere.
      </div>
    <% end %>
    <div class="bg-blue-100 border border-blue-400 text-blue-700 px-4 py-3 rounded mb-4" role="alert">
      <div>
        <b><%= @riwayah ? "Text (#{@riwayah.name}):" : 'Text Uthmani:' %></b>
        <div class="<%= @presenter.font_class %>"> <%= @presenter.verse_text(@verse) %></div>
      </div>

      <% @presenter.verse_translations(@verse).each do |trans| %>
        <div>
          <b><%= trans.resource_name %>:</b> <br/>

          <div class="<%= trans.language_name %>">
            <%= safe_html trans.text %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="text-xl mb-4">
      <%
        progress = @presenter.verse_progress(@verse)
      %>
      Translation progress
      <div class="w-full bg-gray-200 rounded-full h-6 mt-2">
        <div class="bg-green-500 h-6 rounded-full text-white text-xs flex items-center justify-center transition-all duration-300" role="progressbar" aria-valuenow="<%= progress %>" aria-valuemin="0" aria-valuemax="100" style="min-width: 1em;width: <%= progress%>%;">
          <%= progress %>%
        </div>
      </div>
    </div>
  </div>

  <div class="page-section">
    <h2>Word list with translation</h2>
    <%= render 'table' %>
  </div>
</div>
