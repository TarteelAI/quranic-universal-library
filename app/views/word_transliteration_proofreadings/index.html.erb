<%
  verses = @presenter.verses
  progress_map = @presenter.verse_progress_map
%>

<%= render 'tools/header',
           name: "Word transliteration",
           title: @presenter.page_title,
           key: 'word_transliteration'
%>

<div class="page-wrapper container max-w-7xl mx-auto px-4">
  <div class="page-section filters">
    <%= form_tag word_transliteration_proofreadings_path, method: :get do %>
      <div data-controller="chapter-verses-filter" class="flex flex-wrap">
        <div class="mb-4 me-2">
          <%= select_tag :resource_id, options_from_collection_for_select(@presenter.word_transliteration_resources, :id, :humanize, selected: @resource.id), include_blank: false, class: 'form-select w-[85vw] sm:w-[200px]', data: { placeholder: 'Select transliteration', controller: 'select2' } %>
          <p class="text-sm text-gray-600 mt-1">Select the transliteration</p>
        </div>

        <%= render 'shared/filters' %>

        <div class="mb-4 me-2 flex items-center gap-2 h-[38px]">
          <%= check_box_tag :filter_missing, 'true', params[:filter_missing] == 'true' %>
          <%= label_tag :filter_missing, 'Only ayahs with missing words' %>
        </div>

        <div class="mb-4">
          <%= submit_tag 'Filter', class: 'btn btn-success', data: { disable_with: 'Please wait..' } %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="page-section mt-4">
    <h2><%= @resource.name %></h2>
    <div class="tools-table-overflow">
    <table class="w-full hover:bg-gray-50">
      <thead class="sticky top-0 z-10 bg-white border-b-2 border-black">
      <tr>
        <th><%= sort_order_link 'Ayah key', :verse_key, resource_id: @resource.id %></th>
        <th>Progress</th>
        <th>Text</th>
        <th>Actions</th>
      </tr>
      </thead>
      <tbody>
      <% verses.each do |verse| %>
        <% progress = progress_map[verse.id] %>
        <tr class="hover:bg-gray-200 border-b">
          <td scope="row" class="py-2 pl-2"><%= verse.verse_key %></td>
          <td class="py-2">
            <div class="w-full bg-gray-200 rounded-full h-6">
              <div class="bg-green-500 h-6 rounded-full text-white text-xs flex items-center justify-center" role="progressbar" aria-valuenow="<%= progress %>" aria-valuemin="0" aria-valuemax="100" style="min-width: 1em;width: <%= progress %>%;">
                <%= progress %>%
              </div>
            </div>
          </td>
          <td class="py-2 qpc-hafs">
            <%= truncate verse.text_qpc_hafs, length: 100 %>
          </td>
          <td class="py-2">
            <div class="flex gap-1">
              <%= link_to 'Edit', edit_word_transliteration_proofreading_path(verse.id, resource_id: @resource.id), class: 'btn btn-info' %>
              <%= link_to 'Show', word_transliteration_proofreading_path(verse.id, resource_id: @resource.id), class: 'btn btn-success' %>
            </div>
          </td>
        </tr>
      <% end %>
      <tr>
        <td colspan="4">
          <%= pagination_section @presenter.pagination %>
        </td>
      </tr>
      </tbody>
    </table>
    </div>
  </div>
</div>
