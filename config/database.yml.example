# QUL connects to two Postgres databases:
#   - Quran content (verses, words, translations, ...): the qul_quran_content_db_* entries,
#     used by QulQuranRecord.
#   - CMS content (users, permissions, drafts, versions): the development/test/production
#     entries, used by ApplicationRecord.
#

# ---- Quran content database ----

qul_quran_content_db_dev:
  adapter: postgresql
  encoding: unicode
  schema_search_path: quran,public
  database: <%= ENV.fetch('QUL_QURAN_CONTENT_DB_NAME', 'qul_quran_content_dev') %>
  host: <%= ENV.fetch('QUL_QURAN_CONTENT_DB_HOST', 'localhost') %>
  port: <%= ENV.fetch('QUL_QURAN_CONTENT_DB_PORT', '5432') %>
  username: <%= ENV.fetch('QUL_QURAN_CONTENT_DB_USERNAME', 'postgres') %>
  password: <%= ENV.fetch('QUL_QURAN_CONTENT_DB_PASSWORD', 'password') %>
  sslmode: <%= ENV.fetch('QUL_QURAN_CONTENT_DB_SSLMODE', 'prefer') %>

qul_quran_content_db_test:
  adapter: postgresql
  encoding: unicode
  schema_search_path: quran,public
  database: <%= ENV.fetch('QUL_QURAN_CONTENT_TEST_DB_NAME', 'qul_quran_content_test') %>
  host: <%= ENV.fetch('QUL_QURAN_CONTENT_TEST_DB_HOST', 'localhost') %>
  port: <%= ENV.fetch('QUL_QURAN_CONTENT_TEST_DB_PORT', '5432') %>
  username: <%= ENV.fetch('QUL_QURAN_CONTENT_TEST_DB_USERNAME', 'postgres') %>
  password: <%= ENV.fetch('QUL_QURAN_CONTENT_TEST_DB_PASSWORD', 'password') %>
  sslmode: <%= ENV.fetch('QUL_QURAN_CONTENT_TEST_DB_SSLMODE', 'prefer') %>

qul_quran_content_db:
  adapter: postgresql
  encoding: unicode
  schema_search_path: quran,public
  database: <%= ENV['QUL_QURAN_CONTENT_DB_NAME'] %>
  host: <%= ENV['QUL_QURAN_CONTENT_DB_HOST'] %>
  port: <%= ENV.fetch('QUL_QURAN_CONTENT_DB_PORT', '5432') %>
  username: <%= ENV['QUL_QURAN_CONTENT_DB_USERNAME'] %>
  password: <%= ENV['QUL_QURAN_CONTENT_DB_PASSWORD'] %>
  sslmode: <%= ENV.fetch('QUL_QURAN_CONTENT_DB_SSLMODE', 'require') %>

# ---- CMS content database ----

development:
  adapter: postgresql
  encoding: unicode
  schema_search_path: public
  database: <%= ENV.fetch('QUL_CMS_CONTENT_DB_NAME', 'qul_cms_content_dev') %>
  host: <%= ENV.fetch('QUL_CMS_CONTENT_DB_HOST', 'localhost') %>
  port: <%= ENV.fetch('QUL_CMS_CONTENT_DB_PORT', '5432') %>
  username: <%= ENV.fetch('QUL_CMS_CONTENT_DB_USERNAME', 'postgres') %>
  password: <%= ENV.fetch('QUL_CMS_CONTENT_DB_PASSWORD', 'password') %>
  sslmode: <%= ENV.fetch('QUL_CMS_CONTENT_DB_SSLMODE', 'prefer') %>

test:
  adapter: postgresql
  encoding: unicode
  schema_search_path: public
  database: <%= ENV.fetch('QUL_CMS_CONTENT_TEST_DB_NAME', 'qul_cms_content_test') %>
  host: <%= ENV.fetch('QUL_CMS_CONTENT_TEST_DB_HOST', 'localhost') %>
  port: <%= ENV.fetch('QUL_CMS_CONTENT_TEST_DB_PORT', '5432') %>
  username: <%= ENV.fetch('QUL_CMS_CONTENT_TEST_DB_USERNAME', 'postgres') %>
  password: <%= ENV.fetch('QUL_CMS_CONTENT_TEST_DB_PASSWORD', 'password') %>
  sslmode: <%= ENV.fetch('QUL_CMS_CONTENT_TEST_DB_SSLMODE', 'prefer') %>

production:
  adapter: postgresql
  encoding: unicode
  schema_search_path: public
  database: <%= ENV['QUL_CMS_CONTENT_DB_NAME'] %>
  host: <%= ENV['QUL_CMS_CONTENT_DB_HOST'] %>
  port: <%= ENV.fetch('QUL_CMS_CONTENT_DB_PORT', '5432') %>
  username: <%= ENV['QUL_CMS_CONTENT_DB_USERNAME'] %>
  password: <%= ENV['QUL_CMS_CONTENT_DB_PASSWORD'] %>
  sslmode: <%= ENV.fetch('QUL_CMS_CONTENT_DB_SSLMODE', 'require') %>
